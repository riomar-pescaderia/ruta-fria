<%- include('../partials/head') %>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">

<div class="toolbar">
  <h1>Historial de visitas</h1>
  <a class="btn" href="/prospectos/nuevo">+ Nuevo prospecto</a>
</div>

<% const conUbicacion = prospectos.filter(p => p.lat !== null && p.lng !== null);
   const sinUbicacion = prospectos.filter(p => p.lat === null || p.lng === null); %>

<% if (prospectos.length === 0) { %>
  <p class="empty">Todavía no cargaste ningún prospecto. Empezá con "+ Nuevo prospecto".</p>
<% } else { %>

<div id="controles-mapa" style="display:flex; align-items:center; gap:14px; flex-wrap:wrap; margin-bottom:10px;">
  <label style="display:flex; align-items:center; gap:6px; font-size:.85rem;">
    <input type="checkbox" id="toggle-calor" checked style="width:auto;"> Mostrar zonas de calor
  </label>
  <div id="leyenda-calor" style="display:flex; align-items:center; gap:6px; font-size:.75rem; color:var(--ink-soft);">
    <span>Menos visitado</span>
    <span style="display:inline-block; width:120px; height:10px; border-radius:4px; background:linear-gradient(to right, #2b6cb0, #38a3a5, #ffd166, #f4845f, #d7263d);"></span>
    <span>Más visitado</span>
  </div>
  <div style="display:flex; align-items:center; gap:12px; font-size:.75rem; color:var(--ink-soft);">
    <span style="display:flex; align-items:center; gap:5px;"><span style="display:inline-block; width:12px; height:12px; border-radius:50%; background:#2e7d32; border:2px solid #1b5e20;"></span> Cliente</span>
    <span style="display:flex; align-items:center; gap:5px;"><span style="display:inline-block; width:12px; height:12px; border-radius:50%; background:#e8912d; border:2px solid #a85c12;"></span> Prospecto</span>
  </div>
</div>
<div id="mapa" style="height:460px; border:1px solid var(--line); border-radius:10px; margin-bottom:16px;"></div>

<% if (sinUbicacion.length > 0) { %>
  <p style="color:var(--ink-soft); font-size:.85rem;">
    <%= sinUbicacion.length %> prospecto<%= sinUbicacion.length > 1 ? 's' : '' %> sin ubicar en el mapa —
    <% sinUbicacion.forEach((p, i) => { %><a href="/prospectos/<%= p.id %>/editar"><%= p.nombre %></a><%= i < sinUbicacion.length - 1 ? ', ' : '' %><% }) %>.
  </p>
<% } %>

<div style="max-width:340px; margin-bottom:14px;">
  <input type="text" id="buscar-prospecto" placeholder="Buscar por nombre o dirección...">
</div>
<p id="sin-resultados-prospectos" class="empty" style="display:none;">No encontré ningún prospecto con ese nombre o dirección.</p>
<table id="tabla-prospectos">
  <thead>
    <tr>
      <th>Nombre</th>
      <th>Estado</th>
      <th>Dirección</th>
      <th>Teléfono</th>
      <th>Visitas</th>
      <th>Última visita</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% prospectos.forEach(p => { %>
    <tr data-buscar="<%= (p.nombre + ' ' + p.direccion).toLowerCase() %>">
      <td data-label="Nombre"><a href="/prospectos/<%= p.id %>"><%= p.nombre %></a></td>
      <td data-label="Estado">
        <% if (p.cliente_id) { %><span class="badge cliente">Cliente</span><% } else { %><span class="badge prospecto">Prospecto</span><% } %>
      </td>
      <td data-label="Dirección"><%= p.direccion %></td>
      <td data-label="Teléfono"><%= p.telefono || '—' %></td>
      <td data-label="Visitas" class="mono"><%= p.cantidad_visitas %></td>
      <td data-label="Última visita"><%= p.ultima_visita ? new Date(p.ultima_visita).toLocaleDateString('es-AR') : '—' %></td>
      <td data-label="" style="display:flex; gap:8px; flex-wrap:wrap;">
        <a class="btn secondary" href="/prospectos/<%= p.id %>">Ver</a>
        <a class="btn secondary" href="/prospectos/<%= p.id %>/editar">Editar</a>
        <form method="post" action="/prospectos/<%= p.id %>/eliminar" style="display:inline; margin:0;" onsubmit="return confirm('¿Eliminar este prospecto? Se deja de mostrar en el mapa y la lista, pero no se pierde el historial de visitas.');">
          <button type="submit" class="btn secondary" style="color:#a33;">Eliminar</button>
        </form>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>

<% } %>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script src="https://unpkg.com/leaflet.heat@0.2.0/dist/leaflet-heat.js"></script>
<script>
(function () {
  var puntos = <%- JSON.stringify(conUbicacion.map(p => ({
    id: p.id,
    nombre: p.nombre,
    direccion: p.direccion,
    telefono: p.telefono,
    lat: Number(p.lat),
    lng: Number(p.lng),
    visitas: p.cantidad_visitas,
    ultima: p.ultima_visita ? new Date(p.ultima_visita).toLocaleDateString('es-AR') : null,
    esCliente: !!p.cliente_id,
    clienteNombre: p.cliente_nombre || null,
  }))) %>;

  var mapaEl = document.getElementById('mapa');
  if (!mapaEl) return;

  var CENTRO_DEFECTO = [-27.4512, -58.9867]; // Resistencia, Chaco
  var map = L.map('mapa').setView(CENTRO_DEFECTO, 12);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    maxZoom: 19,
  }).addTo(map);

  if (puntos.length > 0) {
    var bounds = [];
    // "L.circle" (no "L.circleMarker") — el radio se define en metros
    // sobre el terreno, no en píxeles de pantalla, así que el punto
    // siempre representa el mismo tamaño real (más o menos lo que ocupa
    // un local comercial) en vez de agrandarse a medida que se aleja el
    // zoom y terminar tapando cuadras enteras. Al alejar mucho el zoom el
    // punto puede volverse chico o perderse de vista — para eso está el
    // listado de abajo.
    var RADIO_METROS = 15;
    puntos.forEach(function (p) {
      var marker = L.circle([p.lat, p.lng], {
        radius: RADIO_METROS,
        color: p.esCliente ? '#1b5e20' : '#a85c12',
        weight: 2,
        fillColor: p.esCliente ? '#2e7d32' : '#e8912d',
        fillOpacity: 0.75,
      }).addTo(map);
      var popup = '<strong>' + p.nombre + '</strong><br>' +
        (p.esCliente ? 'Cliente' + (p.clienteNombre ? ': ' + p.clienteNombre : '') : 'Prospecto') + '<br>' +
        p.direccion +
        (p.telefono ? '<br>Tel: ' + p.telefono : '') +
        '<br>Visitas: ' + p.visitas +
        (p.ultima ? ' (última: ' + p.ultima + ')' : '') +
        '<br><a href="/prospectos/' + p.id + '">Ver detalle / registrar visita</a>';
      marker.bindPopup(popup);
      bounds.push([p.lat, p.lng]);
    });
    if (bounds.length === 1) {
      map.setView(bounds[0], 15);
    } else {
      map.fitBounds(bounds, { padding: [30, 30] });
    }

    // Zona de calor: solo los puntos que ya tuvieron alguna visita pesan
    // en el cálculo (uno sin visitas no debería marcar "zona caliente").
    // El radio y el blur son grandes a propósito para que se lean zonas,
    // no puntos sueltos — a eso apunta el pedido.
    var puntosConVisitas = puntos.filter(function (p) { return p.visitas > 0; });
    var toggleCalor = document.getElementById('toggle-calor');
    var leyendaCalor = document.getElementById('leyenda-calor');
    if (typeof L.heatLayer === 'function' && puntosConVisitas.length > 0) {
      var maxVisitas = puntosConVisitas.reduce(function (max, p) { return Math.max(max, p.visitas); }, 1);
      var capaCalor = L.heatLayer(
        puntosConVisitas.map(function (p) { return [p.lat, p.lng, p.visitas]; }),
        {
          radius: 35,
          blur: 25,
          maxZoom: 17,
          max: maxVisitas,
          gradient: { 0.2: '#2b6cb0', 0.4: '#38a3a5', 0.6: '#ffd166', 0.8: '#f4845f', 1.0: '#d7263d' },
        }
      );
      if (toggleCalor.checked) capaCalor.addTo(map);
      toggleCalor.addEventListener('change', function () {
        if (toggleCalor.checked) {
          capaCalor.addTo(map);
          leyendaCalor.style.display = 'flex';
        } else {
          map.removeLayer(capaCalor);
          leyendaCalor.style.display = 'none';
        }
      });
    } else {
      // No hay librería de calor cargada, o ningún prospecto tiene
      // visitas todavía: no tiene sentido ofrecer el toggle.
      document.getElementById('controles-mapa').style.display = 'none';
    }
  } else {
    document.getElementById('controles-mapa').style.display = 'none';
  }

  var buscarInput = document.getElementById('buscar-prospecto');
  if (buscarInput) {
    var filasProspectos = document.querySelectorAll('#tabla-prospectos tbody tr');
    var sinResultados = document.getElementById('sin-resultados-prospectos');
    buscarInput.addEventListener('input', function () {
      var texto = buscarInput.value.trim().toLowerCase();
      var visibles = 0;
      filasProspectos.forEach(function (tr) {
        var coincide = !texto || tr.dataset.buscar.indexOf(texto) !== -1;
        tr.hidden = !coincide;
        if (coincide) visibles++;
      });
      sinResultados.style.display = visibles === 0 ? 'block' : 'none';
    });
  }
})();
</script>

<%- include('../partials/foot') %>
