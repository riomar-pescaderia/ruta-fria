<%- include('../partials/head') %>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">

<h1><%= prospecto.id ? 'Editar prospecto' : 'Nuevo prospecto' %></h1>

<% if (error) { %>
  <div class="pendiente" style="border-color:#e3b8b8; color:#7a2b2b; margin-bottom:16px; padding:14px 20px;">
    <p style="margin:0;"><%= error %></p>
  </div>
<% } %>

<form class="card" method="post" action="<%= accion %>" style="max-width:640px;">
  <div>
    <label for="nombre">Nombre</label>
    <input type="text" id="nombre" name="nombre" value="<%= prospecto.nombre || '' %>" required autofocus>
  </div>
  <div>
    <label for="contacto">Persona de contacto (opcional)</label>
    <input type="text" id="contacto" name="contacto" value="<%= prospecto.contacto || '' %>">
  </div>
  <div>
    <label for="telefono">Teléfono (opcional)</label>
    <input type="text" id="telefono" name="telefono" value="<%= prospecto.telefono || '' %>">
  </div>

  <% const clienteSel = prospecto.cliente_id ? clientes.find(c => String(c.id) === String(prospecto.cliente_id)) : null; %>
  <div>
    <label for="cliente_buscar">¿Ya es cliente?</label>
    <div style="display:flex; gap:8px;">
      <input type="text" id="cliente_buscar" placeholder="Buscar por nombre, CUIT/DNI o razón social..." autocomplete="off" value="<%= clienteSel ? clienteSel.razon_social : '' %>" style="flex:1;">
      <button type="button" id="cliente-quitar" class="btn secondary">Quitar</button>
    </div>
    <input type="hidden" id="cliente_id" name="cliente_id" value="<%= prospecto.cliente_id || '' %>">
    <p style="color:var(--ink-soft); font-size:.8rem; margin:6px 0 0;">Si ya compró y está cargado en Clientes, buscalo acá y vinculalo — así se distingue en el mapa con otro color en vez de quedar mezclado con los que todavía son solo prospectos. Dejalo vacío si todavía es solo un prospecto.</p>
  </div>

  <div>
    <label for="direccion">Dirección</label>
    <div style="display:flex; gap:8px;">
      <input type="text" id="direccion" name="direccion" value="<%= prospecto.direccion || '' %>" placeholder="Calle, número, ciudad (ej: Monteagudo 1599, Resistencia)" required style="flex:1;">
      <button type="button" id="buscar-direccion" class="btn secondary" style="white-space:nowrap;">Buscar dirección</button>
    </div>
    <p id="estado-geo" style="color:var(--ink-soft); font-size:.82rem; margin:6px 0 0;">
      Buscá la dirección para ubicarla en el mapa, o arrastrá el marcador para ajustarla a mano.
    </p>
    <ul id="opciones-direccion" style="list-style:none; margin:8px 0 0; padding:0; display:none; border:1px solid var(--line); border-radius:8px; overflow:hidden;"></ul>
  </div>

  <div id="mapa-form" style="height:320px; border:1px solid var(--line); border-radius:10px;"></div>

  <input type="hidden" id="lat" name="lat" value="<%= prospecto.lat != null ? prospecto.lat : '' %>">
  <input type="hidden" id="lng" name="lng" value="<%= prospecto.lng != null ? prospecto.lng : '' %>">

  <div>
    <label for="notas">Notas (opcional)</label>
    <textarea id="notas" name="notas" rows="3"><%= prospecto.notas || '' %></textarea>
  </div>

  <div>
    <button class="btn" type="submit">Guardar</button>
    <a class="btn secondary" href="/prospectos">Cancelar</a>
  </div>
</form>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
(function () {
  // Buscador del campo "¿Ya es cliente?" — mismo patrón que el buscador
  // de artículos en Compras: un input de texto con un panel flotante de
  // coincidencias, y un campo oculto que guarda el id real elegido.
  var CLIENTES = <%- JSON.stringify(clientes.map(c => ({ id: String(c.id), razon_social: c.razon_social, cuit_dni: c.cuit_dni || '' }))) %>;
  var clienteBuscarInput = document.getElementById('cliente_buscar');
  var clienteIdInput = document.getElementById('cliente_id');
  var clienteBuscador = document.createElement('div');
  clienteBuscador.className = 'buscador-flotante';
  clienteBuscador.style.display = 'none';
  document.body.appendChild(clienteBuscador);

  function etiquetaCliente(c) {
    return c.razon_social + (c.cuit_dni ? ' — ' + c.cuit_dni : '');
  }

  function buscarClientes(texto) {
    var t = texto.trim().toLowerCase();
    if (!t) return CLIENTES;
    return CLIENTES.filter(function (c) {
      return c.razon_social.toLowerCase().indexOf(t) !== -1 || c.cuit_dni.toLowerCase().indexOf(t) !== -1;
    });
  }

  function ocultarClienteBuscador() {
    clienteBuscador.style.display = 'none';
    clienteBuscador.innerHTML = '';
  }

  function fijarCliente(c) {
    clienteIdInput.value = c ? c.id : '';
    clienteBuscarInput.value = c ? etiquetaCliente(c) : '';
  }

  function mostrarClienteBuscador(coincidencias) {
    clienteBuscador.innerHTML = '';
    if (coincidencias.length === 0) {
      var vacio = document.createElement('div');
      vacio.style.cssText = 'padding:8px 12px; font-size:.85rem; color:var(--ink-soft);';
      vacio.textContent = 'Sin resultados.';
      clienteBuscador.appendChild(vacio);
    } else {
      coincidencias.slice(0, 30).forEach(function (c) {
        var boton = document.createElement('button');
        boton.type = 'button';
        boton.textContent = etiquetaCliente(c);
        // "mousedown" (no "click") para que se ejecute antes de que el
        // input pierda el foco y el buscador se cierre solo.
        boton.addEventListener('mousedown', function (e) {
          e.preventDefault();
          fijarCliente(c);
          ocultarClienteBuscador();
        });
        clienteBuscador.appendChild(boton);
      });
    }
    var rect = clienteBuscarInput.getBoundingClientRect();
    clienteBuscador.style.left = rect.left + 'px';
    clienteBuscador.style.top = rect.bottom + 'px';
    clienteBuscador.style.width = Math.max(rect.width, 240) + 'px';
    clienteBuscador.style.display = 'block';
  }

  clienteBuscarInput.addEventListener('focus', function () {
    mostrarClienteBuscador(buscarClientes(clienteBuscarInput.value));
  });
  clienteBuscarInput.addEventListener('input', function () {
    // si lo tipeado ya no coincide con el cliente elegido, se desvincula
    // hasta que se elija uno de la lista de nuevo
    var actual = CLIENTES.find(function (c) { return c.id === clienteIdInput.value; });
    if (!actual || etiquetaCliente(actual) !== clienteBuscarInput.value) {
      clienteIdInput.value = '';
    }
    mostrarClienteBuscador(buscarClientes(clienteBuscarInput.value));
  });
  clienteBuscarInput.addEventListener('blur', function () {
    setTimeout(ocultarClienteBuscador, 150);
  });
  document.getElementById('cliente-quitar').addEventListener('click', function () {
    fijarCliente(null);
  });
  window.addEventListener('scroll', function () { ocultarClienteBuscador(); }, true);
  window.addEventListener('resize', ocultarClienteBuscador);

  var CENTRO_DEFECTO = [-27.4512, -58.9867]; // Resistencia, Chaco
  var latInput = document.getElementById('lat');
  var lngInput = document.getElementById('lng');
  var estadoGeo = document.getElementById('estado-geo');
  var listaOpciones = document.getElementById('opciones-direccion');

  var latInicial = latInput.value ? Number(latInput.value) : null;
  var lngInicial = lngInput.value ? Number(lngInput.value) : null;

  var map = L.map('mapa-form').setView(latInicial != null ? [latInicial, lngInicial] : CENTRO_DEFECTO, latInicial != null ? 15 : 12);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    maxZoom: 19,
  }).addTo(map);

  var marker = null;

  function ocultarOpciones() {
    listaOpciones.style.display = 'none';
    listaOpciones.innerHTML = '';
  }

  function mostrarOpciones(opciones) {
    listaOpciones.innerHTML = '';
    opciones.forEach(function (op, i) {
      var li = document.createElement('li');
      var boton = document.createElement('button');
      boton.type = 'button';
      boton.textContent = op.etiqueta;
      boton.style.cssText = 'display:block; width:100%; text-align:left; padding:9px 12px; border:none; background:' +
        (i % 2 === 0 ? '#fff' : '#f5f7f4') + '; cursor:pointer; font-size:.85rem; border-bottom:1px solid var(--line);';
      boton.addEventListener('click', function () {
        ubicarMarcador(op.lat, op.lng, true);
        estadoGeo.textContent = '📍 ' + op.etiqueta + ' — si no es exacto, arrastrá el marcador hasta el lugar correcto.';
        ocultarOpciones();
      });
      li.appendChild(boton);
      listaOpciones.appendChild(li);
    });
    listaOpciones.style.display = opciones.length ? 'block' : 'none';
  }

  function ubicarMarcador(lat, lng, centrar) {
    latInput.value = lat;
    lngInput.value = lng;
    if (marker) {
      marker.setLatLng([lat, lng]);
    } else {
      marker = L.marker([lat, lng], { draggable: true }).addTo(map);
      marker.on('dragend', function () {
        var pos = marker.getLatLng();
        latInput.value = pos.lat;
        lngInput.value = pos.lng;
        estadoGeo.textContent = 'Punto ajustado a mano.';
      });
    }
    if (centrar) map.setView([lat, lng], 16);
  }

  if (latInicial != null && lngInicial != null) {
    ubicarMarcador(latInicial, lngInicial, false);
  }

  // Un click en cualquier parte del mapa también mueve (o crea) el
  // marcador — para cuando ninguna opción de la búsqueda es la correcta,
  // o directamente se prefiere marcar el punto a mano.
  map.on('click', function (e) {
    ubicarMarcador(e.latlng.lat, e.latlng.lng, false);
    estadoGeo.textContent = 'Punto marcado a mano.';
    ocultarOpciones();
  });

  document.getElementById('buscar-direccion').addEventListener('click', function () {
    var direccion = document.getElementById('direccion').value.trim();
    if (!direccion) {
      estadoGeo.textContent = 'Escribí primero una dirección.';
      return;
    }
    estadoGeo.textContent = 'Buscando...';
    ocultarOpciones();
    fetch('/prospectos/geocodificar', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ direccion: direccion }),
    })
      .then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data }; }); })
      .then(function (res) {
        if (!res.ok) {
          estadoGeo.textContent = res.data.error || 'No se encontró esa dirección. Marcá el punto a mano en el mapa.';
          return;
        }
        var opciones = res.data.opciones || [];
        if (opciones.length === 1) {
          // Un solo resultado: se ubica directo, pero mostrando de dónde
          // es para poder corregir con un click en el mapa si no es así.
          ubicarMarcador(opciones[0].lat, opciones[0].lng, true);
          estadoGeo.textContent = '📍 ' + opciones[0].etiqueta + ' — si no es exacto, arrastrá el marcador o hacé click en el mapa.';
        } else {
          estadoGeo.textContent = 'Encontré ' + opciones.length + ' lugares posibles — elegí el correcto:';
          mostrarOpciones(opciones);
        }
      })
      .catch(function () {
        estadoGeo.textContent = 'No se pudo buscar la dirección ahora mismo. Marcá el punto a mano en el mapa.';
      });
  });

  // El fetch de arriba manda JSON, así que hay que interceptar el submit
  // normal del formulario solo para asegurarse de que las coordenadas ya
  // estén en los campos ocultos — no bloquea el envío en ningún caso, un
  // prospecto se puede guardar igual sin ubicación y ubicarlo después.
})();
</script>

<%- include('../partials/foot') %>
