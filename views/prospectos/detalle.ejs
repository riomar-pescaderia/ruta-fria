<%- include('../partials/head') %>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">

<div class="toolbar">
  <h1><%= prospecto.nombre %></h1>
  <div style="display:flex; gap:8px; flex-wrap:wrap;">
    <a class="btn secondary" href="/prospectos/<%= prospecto.id %>/editar">Editar</a>
    <form method="post" action="/prospectos/<%= prospecto.id %>/eliminar" style="display:inline;" onsubmit="return confirm('¿Eliminar este prospecto? Se deja de mostrar en el mapa y la lista, pero no se pierde el historial de visitas.');">
      <button type="submit" class="btn secondary" style="color:#a33;">Eliminar</button>
    </form>
    <a class="btn secondary" href="/prospectos">← Volver</a>
  </div>
</div>

<p style="color:var(--ink-soft);">
  <%= prospecto.direccion %>
  <% if (prospecto.cuit_dni) { %> · CUIT/DNI: <%= prospecto.cuit_dni %><% } %>
</p>

<% if (contactos.length > 0) { %>
  <p style="color:var(--ink-soft); font-size:.92rem;">
    <% contactos.forEach((c, i) => { %><%= i > 0 ? ' · ' : '' %><%= c.nombre || 'Contacto' %><%= c.telefono ? ': ' + c.telefono : '' %><% }) %>
  </p>
<% } %>

<% if (prospecto.notas) { %>
  <p style="color:var(--ink-soft); font-size:.9rem;"><%= prospecto.notas %></p>
<% } %>

<div class="card" style="max-width:480px; margin-bottom:24px;">
  <h2 style="font-size:1.05rem; margin:0 0 8px;">Vínculo con Clientes</h2>
  <% if (prospecto.cliente_id) { %>
    <p style="margin:0 0 10px;"><span class="badge cliente">Cliente<%= prospecto.cliente_nombre ? ': ' + prospecto.cliente_nombre : '' %></span></p>
    <form method="post" action="/prospectos/<%= prospecto.id %>/desvincular" onsubmit="return confirm('¿Desvincular este prospecto del cliente? No se borra ni el prospecto ni el cliente, solo deja de estar relacionados.');" style="margin:0;">
      <button type="submit" class="btn secondary">Desvincular</button>
    </form>
  <% } else { %>
    <p style="margin:0 0 10px;"><span class="badge prospecto">Todavía no es cliente</span></p>

    <details>
      <summary style="cursor:pointer; font-size:.85rem; color:var(--ink-soft);">Buscar y vincular a otro cliente</summary>
      <form method="post" action="/prospectos/<%= prospecto.id %>/vincular" style="margin-top:10px;">
        <div class="fila-input-boton" style="margin-bottom:0;">
          <input type="text" id="cliente_buscar" placeholder="Buscar por nombre, CUIT/DNI o razón social..." autocomplete="off">
          <button type="submit" class="btn secondary">Vincular</button>
        </div>
        <input type="hidden" id="cliente_id" name="cliente_id" value="">
      </form>
    </details>
  <% } %>
</div>

<% const sugerenciasNombre = !prospecto.cliente_id ? sugerencias.filter(s => s.porNombre) : []; %>
<% const sugerenciasDomicilio = !prospecto.cliente_id ? sugerencias.filter(s => s.porDomicilio && !s.porNombre) : []; %>
<% if (sugerenciasNombre.length > 0 || sugerenciasDomicilio.length > 0) { %>
<div id="modal-vinculo-prospecto" class="modal-overlay" hidden>
  <div class="modal-card">
    <h2 style="font-size:1.05rem; margin:0 0 8px;">Posible vínculo con un cliente</h2>

    <% if (sugerenciasNombre.length > 0) { %>
      <p style="font-size:.85rem; color:var(--ink-soft); margin-bottom:6px;">Encontré un cliente cargado con el mismo nombre — ¿es el mismo negocio?</p>
      <% sugerenciasNombre.forEach(s => { %>
        <form method="post" action="/prospectos/<%= prospecto.id %>/vincular" style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
          <input type="hidden" name="cliente_id" value="<%= s.id %>">
          <span style="flex:1; font-size:.92rem;"><%= s.razon_social %><%= s.cuit_dni ? ' — ' + s.cuit_dni : '' %></span>
          <button type="submit" class="btn secondary">Vincular</button>
        </form>
      <% }) %>
    <% } %>

    <% if (sugerenciasDomicilio.length > 0) { %>
      <p style="font-size:.85rem; color:var(--ink-soft); margin-bottom:6px;">Encontré un cliente cargado en el mismo domicilio — ¿es el mismo negocio?</p>
      <% sugerenciasDomicilio.forEach(s => { %>
        <form method="post" action="/prospectos/<%= prospecto.id %>/vincular" style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
          <input type="hidden" name="cliente_id" value="<%= s.id %>">
          <span style="flex:1; font-size:.92rem;"><%= s.razon_social %><%= s.cuit_dni ? ' — ' + s.cuit_dni : '' %></span>
          <button type="submit" class="btn secondary">Vincular</button>
        </form>
      <% }) %>
    <% } %>

    <div style="text-align:right; margin-top:6px;">
      <button type="button" id="modal-vinculo-prospecto-cerrar" class="btn secondary">Ignorar</button>
    </div>
  </div>
</div>
<script>
(function () {
  // El cartel de posible vínculo solo aparece como ventana emergente justo
  // al terminar de cargar o editar el prospecto (?recien_guardado=1 en la
  // URL del redirect, ver routes/prospectos.js) — no queda escrito de
  // forma permanente en el perfil cada vez que se lo visita. Si se
  // ignora, sigue estando el buscador manual ("Buscar y vincular a otro
  // cliente") para vincularlo más adelante a mano.
  var modal = document.getElementById('modal-vinculo-prospecto');
  var params = new URLSearchParams(window.location.search);
  if (params.get('recien_guardado') === '1') {
    modal.hidden = false;
  }
  var url = new URL(window.location.href);
  if (url.searchParams.has('recien_guardado')) {
    url.searchParams.delete('recien_guardado');
    window.history.replaceState({}, '', url);
  }
  document.getElementById('modal-vinculo-prospecto-cerrar').addEventListener('click', function () {
    modal.hidden = true;
  });
})();
</script>
<% } %>

<div class="card" style="max-width:480px; margin-bottom:24px;">
  <h2 style="font-size:1.05rem; margin:0 0 4px;">Registrar visita</h2>
  <form method="post" action="/prospectos/<%= prospecto.id %>/visitas" style="display:flex; gap:10px; flex-wrap:wrap; align-items:flex-end;">
    <div style="flex:1; min-width:140px;">
      <label for="fecha">Fecha y hora</label>
      <input type="datetime-local" id="fecha" name="fecha" value="<%= ahora %>">
    </div>
    <div style="flex:2; min-width:180px;">
      <label for="nota">Nota (opcional)</label>
      <input type="text" id="nota" name="nota" placeholder="Ej: pidió volver a fin de mes">
    </div>
    <div>
      <button class="btn" type="submit">Registrar visita</button>
    </div>
  </form>
</div>

<h2 id="historial-visitas" style="font-size:1.1rem;">Historial de visitas (<%= visitas.length %>)</h2>
<% if (visitas.length === 0) { %>
  <p class="empty">Todavía no se registró ninguna visita a este prospecto.</p>
<% } else { %>
<table>
  <thead>
    <tr>
      <th>Fecha</th>
      <th>Nota</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% visitas.forEach(v => { %>
    <tr>
      <td data-label="Fecha" class="mono"><%= formatearFechaHora(v.fecha) %></td>
      <td data-label="Nota"><%= v.nota || '—' %></td>
      <td data-label="">
        <form method="post" action="/prospectos/<%= prospecto.id %>/visitas/<%= v.id %>/eliminar" style="margin:0;" onsubmit="return confirm('¿Eliminar esta visita del historial?');">
          <button type="submit" class="btn secondary" style="color:#a33; font-size:.8rem;">Quitar</button>
        </form>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
<% } %>

<h2 style="font-size:1.1rem;">Ubicación</h2>
<% if (prospecto.lat !== null && prospecto.lng !== null) { %>
  <div id="mapa" style="height:280px; border:1px solid var(--line); border-radius:10px; margin-bottom:20px;"></div>
<% } else { %>
  <p class="pendiente" style="padding:14px 20px;">Este prospecto todavía no tiene ubicación en el mapa — <a href="/prospectos/<%= prospecto.id %>/editar">editalo</a> para buscarle la dirección.</p>
<% } %>

<% if (!prospecto.cliente_id) { %>
<script>
(function () {
  // Buscador manual de respaldo ("Buscar y vincular a otro cliente") —
  // mismo patrón que el buscador de artículos en Compras: un input de
  // texto con un panel flotante de coincidencias, y un campo oculto que
  // guarda el id real elegido.
  var CLIENTES = <%- JSON.stringify(clientes.map(c => ({ id: String(c.id), razon_social: c.razon_social, cuit_dni: c.cuit_dni || '' }))) %>;
  var clienteBuscarInput = document.getElementById('cliente_buscar');
  if (!clienteBuscarInput) return;
  var clienteIdInput = document.getElementById('cliente_id');
  var clienteBuscador = document.createElement('div');
  clienteBuscador.className = 'buscador-flotante';
  clienteBuscador.style.display = 'none';
  document.body.appendChild(clienteBuscador);

  function etiquetaCliente(c) {
    return c.razon_social + (c.cuit_dni ? ' — ' + c.cuit_dni : '');
  }

  function buscarClientes(texto) {
    var t = texto.trim().toLowerCase();
    if (!t) return CLIENTES;
    return CLIENTES.filter(function (c) {
      return c.razon_social.toLowerCase().indexOf(t) !== -1 || c.cuit_dni.toLowerCase().indexOf(t) !== -1;
    });
  }

  function ocultarClienteBuscador() {
    clienteBuscador.style.display = 'none';
    clienteBuscador.innerHTML = '';
  }

  function fijarCliente(c) {
    clienteIdInput.value = c ? c.id : '';
    clienteBuscarInput.value = c ? etiquetaCliente(c) : '';
  }

  function mostrarClienteBuscador(coincidencias) {
    clienteBuscador.innerHTML = '';
    if (coincidencias.length === 0) {
      var vacio = document.createElement('div');
      vacio.style.cssText = 'padding:8px 12px; font-size:.85rem; color:var(--ink-soft);';
      vacio.textContent = 'Sin resultados.';
      clienteBuscador.appendChild(vacio);
    } else {
      coincidencias.slice(0, 30).forEach(function (c) {
        var boton = document.createElement('button');
        boton.type = 'button';
        boton.textContent = etiquetaCliente(c);
        boton.addEventListener('mousedown', function (e) {
          e.preventDefault();
          fijarCliente(c);
          ocultarClienteBuscador();
        });
        clienteBuscador.appendChild(boton);
      });
    }
    var rect = clienteBuscarInput.getBoundingClientRect();
    clienteBuscador.style.left = rect.left + 'px';
    clienteBuscador.style.top = rect.bottom + 'px';
    clienteBuscador.style.width = Math.max(rect.width, 240) + 'px';
    clienteBuscador.style.display = 'block';
  }

  clienteBuscarInput.addEventListener('focus', function () {
    mostrarClienteBuscador(buscarClientes(clienteBuscarInput.value));
  });
  clienteBuscarInput.addEventListener('input', function () {
    var actual = CLIENTES.find(function (c) { return c.id === clienteIdInput.value; });
    if (!actual || etiquetaCliente(actual) !== clienteBuscarInput.value) {
      clienteIdInput.value = '';
    }
    mostrarClienteBuscador(buscarClientes(clienteBuscarInput.value));
  });
  clienteBuscarInput.addEventListener('blur', function () {
    setTimeout(ocultarClienteBuscador, 150);
  });
  window.addEventListener('scroll', function () { ocultarClienteBuscador(); }, true);
  window.addEventListener('resize', ocultarClienteBuscador);
})();
</script>
<% } %>

<% if (prospecto.lat !== null && prospecto.lng !== null) { %>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
(function () {
  var lat = <%- JSON.stringify(Number(prospecto.lat)) %>;
  var lng = <%- JSON.stringify(Number(prospecto.lng)) %>;
  var map = L.map('mapa').setView([lat, lng], 15);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    maxZoom: 19,
  }).addTo(map);
  L.marker([lat, lng]).addTo(map).bindPopup(<%- JSON.stringify(prospecto.nombre) %>);
})();
</script>
<% } %>

<%- include('../partials/foot') %>
