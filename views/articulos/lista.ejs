<%- include('../partials/head') %>

<div class="toolbar">
  <h1>Artículos</h1>
  <div style="display:flex; gap:8px; flex-wrap:wrap;">
    <button type="button" id="generar-listado-precios" class="btn secondary">Generar listado de precios (PDF)</button>
    <a class="btn secondary" href="/articulos/importar">Importar desde planilla</a>
    <a class="btn" href="/articulos/nuevo">+ Nuevo artículo</a>
  </div>
</div>

<p style="color:var(--ink-soft); font-size:.9rem; margin-top:-10px;">
  IVA <%= config.iva_pct %>% · IIBB <%= config.iibb_pct %>% · recargo por medio de pago <%= config.recargo_lista_pct %>% — configurables más adelante en una sola pantalla.
</p>

<% if (error) { %>
  <p style="color:#b3261e;"><%= error %></p>
<% } %>

<% if (articulos.length === 0) { %>
  <p class="empty">Todavía no cargaste ningún artículo.</p>
<% } else { %>
<div style="max-width:340px; margin-bottom:14px;">
  <input type="text" id="buscar-articulo" placeholder="Buscar por nombre o código...">
</div>
<p id="sin-resultados-articulos" class="empty" style="display:none;">No encontré ningún artículo con ese nombre o código.</p>
<table id="tabla-articulos">
  <thead>
    <tr>
      <%
        // Cada encabezado es un botón que abre el panel de "ordenar y
        // filtrar" (ver el script más abajo) — mismo estilo Excel: ordenar
        // ascendente/descendente, o tildar/destildar valores puntuales
        // para mostrar solo esos renglones. "data-col" tiene que coincidir
        // con la "clave" de COLUMNAS_FILTRO en el script.
        const columnasEncabezado = [
          { clave: 'codigo', texto: 'Código' },
          { clave: 'nombre', texto: 'Nombre' },
          { clave: 'unidad', texto: 'Unidad' },
          { clave: 'costo', texto: 'Costo' },
          { clave: 'precioEfectivo', texto: 'Precio efectivo' },
          { clave: 'precioLista', texto: 'Precio de lista' },
          { clave: 'prioridad', texto: 'Orden en listado PDF' },
        ];
      %>
      <% columnasEncabezado.forEach(col => { %>
      <th><button type="button" class="th-filtro-btn" data-col="<%= col.clave %>"><%= col.texto %> <span class="th-filtro-icono">▾</span></button></th>
      <% }) %>
    </tr>
  </thead>
  <tbody>
    <% articulos.forEach(a => { %>
    <tr data-buscar="<%= (a.codigo + ' ' + a.nombre).toLowerCase() %>" data-href="/articulos/<%= a.id %>/editar">
      <td data-label="Código" class="mono"><%= a.codigo %></td>
      <td data-label="Nombre"><%= a.nombre %></td>
      <td data-label="Unidad" class="col-mobile-oculta" data-valor="<%= a.unidad %>"><%= a.unidad %></td>
      <td data-label="Costo" class="mono col-mobile-oculta" data-valor="<%= a.costoPorUnidad %>"<% if (Number(a.unidad) !== 1) { %> title="$<%= Number(a.costo).toFixed(2) %>/kg ÷ <%= a.unidad %>"<% } %>>$<%= a.costoPorUnidad.toFixed(2) %></td>
      <td data-label="Precio efectivo" data-corto="Efvo" class="mono" data-valor="<%= a.precioEfectivo %>">$<%= a.precioEfectivo.toFixed(0) %></td>
      <td data-label="Precio de lista" data-corto="Lista" class="mono" data-valor="<%= a.precioLista %>">$<%= a.precioLista.toFixed(0) %></td>
      <td data-label="Orden en listado PDF" class="col-mobile-oculta">
        <form method="post" action="/articulos/<%= a.id %>/prioridad" style="margin:0;">
          <select name="prioridad_listado" onchange="this.form.submit()" class="select-prioridad<%= a.prioridad_listado ? ' prioridad-' + a.prioridad_listado : '' %>" style="max-width:150px;">
            <option value="" <%= !a.prioridad_listado ? 'selected' : '' %>>Sin prioridad</option>
            <option value="1" <%= a.prioridad_listado === 1 ? 'selected' : '' %>>Primer orden</option>
            <option value="2" <%= a.prioridad_listado === 2 ? 'selected' : '' %>>Segundo orden</option>
            <option value="3" <%= a.prioridad_listado === 3 ? 'selected' : '' %>>Tercer orden</option>
          </select>
        </form>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
<% } %>

<script>
(function () {
  // Buscador de texto libre + filtro/orden estilo Excel en cada
  // encabezado. Todo vive en un solo módulo porque comparten el mismo
  // "aplicarFiltros()": el texto tipeado arriba de la tabla y los tildes
  // de cada columna se combinan (AND) para decidir qué filas quedan
  // visibles.
  var tabla = document.getElementById('tabla-articulos');
  if (!tabla) return;
  var tbody = tabla.querySelector('tbody');
  var filas = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
  var inputBuscar = document.getElementById('buscar-articulo');
  var sinResultados = document.getElementById('sin-resultados-articulos');

  // Cada columna sabe sacar, de un <tr>: "valor" (para comparar/filtrar,
  // siempre termina convertido a string), "etiqueta" (lo que se muestra
  // en la lista de tildes — si no está definida, se usa el valor tal
  // cual) y "numero" (si corresponde, para ordenar de forma numérica en
  // vez de alfabética). Los precios y el costo usan los "data-valor" que
  // se agregaron a esos <td> para no tener que volver a parsear el texto
  // formateado con "$". La columna de prioridad no tiene data-valor —
  // ahí vive un <select>, así que se lee directo de él.
  function celda(tr, etiqueta) { return tr.querySelector('td[data-label="' + etiqueta + '"]'); }
  function selectPrioridad(tr) { return tr.querySelector('select[name="prioridad_listado"]'); }

  var COLUMNAS_FILTRO = {
    codigo: {
      tipo: 'texto',
      valor: function (tr) { return celda(tr, 'Código').textContent.trim(); },
    },
    nombre: {
      tipo: 'texto',
      valor: function (tr) { return celda(tr, 'Nombre').textContent.trim(); },
    },
    unidad: {
      tipo: 'numero',
      valor: function (tr) { return celda(tr, 'Unidad').dataset.valor; },
      numero: function (tr) { return Number(celda(tr, 'Unidad').dataset.valor); },
    },
    costo: {
      tipo: 'numero',
      valor: function (tr) { return celda(tr, 'Costo').dataset.valor; },
      numero: function (tr) { return Number(celda(tr, 'Costo').dataset.valor); },
      etiqueta: function (tr) { return '$' + Number(celda(tr, 'Costo').dataset.valor).toFixed(2); },
    },
    precioEfectivo: {
      tipo: 'numero',
      valor: function (tr) { return celda(tr, 'Precio efectivo').dataset.valor; },
      numero: function (tr) { return Number(celda(tr, 'Precio efectivo').dataset.valor); },
      etiqueta: function (tr) { return '$' + Math.round(Number(celda(tr, 'Precio efectivo').dataset.valor)); },
    },
    precioLista: {
      tipo: 'numero',
      valor: function (tr) { return celda(tr, 'Precio de lista').dataset.valor; },
      numero: function (tr) { return Number(celda(tr, 'Precio de lista').dataset.valor); },
      etiqueta: function (tr) { return '$' + Math.round(Number(celda(tr, 'Precio de lista').dataset.valor)); },
    },
    prioridad: {
      tipo: 'numero',
      valor: function (tr) { var s = selectPrioridad(tr); return s ? s.value : ''; },
      etiqueta: function (tr) {
        var s = selectPrioridad(tr);
        return s ? s.options[s.selectedIndex].text : 'Sin prioridad';
      },
      numero: function (tr) { var s = selectPrioridad(tr); return s && s.value ? Number(s.value) : 99; },
    },
  };

  // filtrosActivos[clave] = Set con los valores (string) tildados para esa
  // columna. Si una columna no tiene entrada acá, no tiene filtro propio
  // (se muestran todos sus valores) — así arranca la pantalla, sin tocar
  // nada.
  var filtrosActivos = {};

  function aplicarFiltros() {
    var texto = inputBuscar ? inputBuscar.value.trim().toLowerCase() : '';
    var visibles = 0;
    filas.forEach(function (tr) {
      var coincideTexto = !texto || tr.dataset.buscar.indexOf(texto) !== -1;
      var coincideFiltros = true;
      for (var clave in filtrosActivos) {
        var valor = String(COLUMNAS_FILTRO[clave].valor(tr));
        if (!filtrosActivos[clave].has(valor)) { coincideFiltros = false; break; }
      }
      var coincide = coincideTexto && coincideFiltros;
      tr.hidden = !coincide;
      if (coincide) visibles++;
    });
    if (sinResultados) sinResultados.style.display = visibles === 0 ? 'block' : 'none';
  }

  if (inputBuscar) inputBuscar.addEventListener('input', aplicarFiltros);

  function marcarActivo(clave) {
    var boton = tabla.querySelector('.th-filtro-btn[data-col="' + clave + '"]');
    if (boton) boton.classList.toggle('th-filtro-activo', !!filtrosActivos[clave]);
  }

  // El orden se aplica moviendo los <tr> de verdad dentro del <tbody> (con
  // appendChild, que reubica en vez de duplicar) — así todo lo que ya
  // tenían las filas (el data-href para editar, el <select> de prioridad
  // con su propio listener) sigue funcionando sin tocar nada más.
  function ordenarPor(clave, direccion) {
    var def = COLUMNAS_FILTRO[clave];
    var copia = filas.slice();
    copia.sort(function (a, b) {
      var res;
      if (def.tipo === 'numero' && def.numero) {
        res = def.numero(a) - def.numero(b);
      } else {
        res = String(def.valor(a)).localeCompare(String(def.valor(b)), 'es', { numeric: true, sensitivity: 'base' });
      }
      return direccion === 'desc' ? -res : res;
    });
    copia.forEach(function (tr) { tbody.appendChild(tr); });
  }

  // ---- Panel flotante de "ordenar y filtrar" — uno solo, reutilizado
  // para cualquier columna que se abra (mismo criterio que el resto de
  // los buscadores flotantes de la app: .buscador-flotante). ----
  var panel = null;
  var colAbierta = null;

  function cerrarPanel() {
    if (panel) { panel.remove(); panel = null; }
    colAbierta = null;
    document.removeEventListener('click', clickAfuera, true);
    window.removeEventListener('scroll', cerrarPanel, true);
    window.removeEventListener('resize', cerrarPanel);
  }

  function clickAfuera(e) {
    if (panel && !panel.contains(e.target) && !e.target.closest('.th-filtro-btn')) cerrarPanel();
  }

  function valoresUnicos(clave) {
    var def = COLUMNAS_FILTRO[clave];
    var vistos = {};
    var lista = [];
    filas.forEach(function (tr) {
      var valor = String(def.valor(tr));
      if (vistos[valor]) return;
      vistos[valor] = true;
      lista.push({
        valor: valor,
        etiqueta: def.etiqueta ? def.etiqueta(tr) : valor,
        numero: def.numero ? def.numero(tr) : null,
      });
    });
    lista.sort(function (a, b) {
      if (def.tipo === 'numero') return (a.numero || 0) - (b.numero || 0);
      return a.etiqueta.localeCompare(b.etiqueta, 'es', { numeric: true, sensitivity: 'base' });
    });
    return lista;
  }

  function abrirPanel(boton, clave) {
    if (colAbierta === clave) { cerrarPanel(); return; }
    cerrarPanel();
    colAbierta = clave;
    var def = COLUMNAS_FILTRO[clave];
    var opciones = valoresUnicos(clave);
    var seleccionActual = filtrosActivos[clave] || null; // null = sin filtro, todo tildado

    panel = document.createElement('div');
    panel.className = 'th-filtro-panel';

    var bloqueOrden = document.createElement('div');
    bloqueOrden.className = 'th-filtro-ordenar';
    var textoAsc = def.tipo === 'numero' ? 'Menor a mayor' : 'A → Z';
    var textoDesc = def.tipo === 'numero' ? 'Mayor a menor' : 'Z → A';
    var botonAsc = document.createElement('button');
    botonAsc.type = 'button';
    botonAsc.textContent = '↑ ' + textoAsc;
    botonAsc.addEventListener('click', function () { ordenarPor(clave, 'asc'); cerrarPanel(); });
    var botonDesc = document.createElement('button');
    botonDesc.type = 'button';
    botonDesc.textContent = '↓ ' + textoDesc;
    botonDesc.addEventListener('click', function () { ordenarPor(clave, 'desc'); cerrarPanel(); });
    bloqueOrden.appendChild(botonAsc);
    bloqueOrden.appendChild(botonDesc);
    panel.appendChild(bloqueOrden);

    var buscarInterno = document.createElement('input');
    buscarInterno.type = 'text';
    buscarInterno.className = 'th-filtro-buscar';
    buscarInterno.placeholder = 'Buscar valor...';
    panel.appendChild(buscarInterno);

    var filaTodos = document.createElement('label');
    filaTodos.className = 'th-filtro-todos';
    var checkTodos = document.createElement('input');
    checkTodos.type = 'checkbox';
    filaTodos.appendChild(checkTodos);
    filaTodos.appendChild(document.createTextNode('Seleccionar todo'));
    panel.appendChild(filaTodos);

    var listaDiv = document.createElement('div');
    listaDiv.className = 'th-filtro-lista';
    var checks = [];
    if (opciones.length === 0) {
      var vacio = document.createElement('p');
      vacio.className = 'th-filtro-sin-opciones';
      vacio.textContent = 'No hay valores para mostrar.';
      listaDiv.appendChild(vacio);
    }
    opciones.forEach(function (op) {
      var label = document.createElement('label');
      var check = document.createElement('input');
      check.type = 'checkbox';
      check.value = op.valor;
      check.checked = !seleccionActual || seleccionActual.has(op.valor);
      // Al tildar/destildar uno a mano, "Seleccionar todo" tiene que
      // reflejarlo — pero solo mirando los que están visibles en ese
      // momento (el buscador interno puede haber ocultado el resto).
      check.addEventListener('change', function () { actualizarCheckTodos(); });
      label.dataset.etiquetaBusqueda = op.etiqueta.toLowerCase();
      label.appendChild(check);
      label.appendChild(document.createTextNode(op.etiqueta));
      listaDiv.appendChild(label);
      checks.push(check);
    });
    panel.appendChild(listaDiv);

    function actualizarCheckTodos() {
      var visibles = checks.filter(function (c) { return !c.parentElement.hidden; });
      checkTodos.checked = visibles.length > 0 && visibles.every(function (c) { return c.checked; });
    }
    checkTodos.checked = checks.length > 0 && checks.every(function (c) { return c.checked; });
    checkTodos.addEventListener('change', function () {
      checks.forEach(function (c) { if (!c.parentElement.hidden) c.checked = checkTodos.checked; });
    });

    // El buscador interno solo oculta/muestra los renglones de la lista —
    // nunca crea ni destruye checkboxes, así que lo que ya se tildó no se
    // pierde al tipear y borrar en este buscador.
    buscarInterno.addEventListener('input', function () {
      var texto = buscarInterno.value.trim().toLowerCase();
      listaDiv.querySelectorAll('label').forEach(function (label) {
        if (!label.dataset.etiquetaBusqueda) return;
        label.hidden = texto !== '' && label.dataset.etiquetaBusqueda.indexOf(texto) === -1;
      });
      actualizarCheckTodos();
    });

    var acciones = document.createElement('div');
    acciones.className = 'th-filtro-acciones';
    var botonAplicar = document.createElement('button');
    botonAplicar.type = 'button';
    botonAplicar.className = 'btn';
    botonAplicar.textContent = 'Aplicar';
    botonAplicar.addEventListener('click', function () {
      var tildados = checks.filter(function (c) { return c.checked; }).map(function (c) { return c.value; });
      if (checks.length === 0 || tildados.length === checks.length) {
        delete filtrosActivos[clave];
      } else {
        filtrosActivos[clave] = new Set(tildados);
      }
      marcarActivo(clave);
      aplicarFiltros();
      cerrarPanel();
    });
    var botonBorrar = document.createElement('button');
    botonBorrar.type = 'button';
    botonBorrar.className = 'btn secondary';
    botonBorrar.textContent = 'Borrar filtro';
    botonBorrar.addEventListener('click', function () {
      delete filtrosActivos[clave];
      marcarActivo(clave);
      aplicarFiltros();
      cerrarPanel();
    });
    acciones.appendChild(botonAplicar);
    acciones.appendChild(botonBorrar);
    panel.appendChild(acciones);

    document.body.appendChild(panel);

    // Se posiciona debajo del botón que se apretó — si no entra a la
    // derecha (columnas del final de la tabla), se pega al borde derecho
    // de la ventana en vez de salirse de la pantalla.
    var rect = boton.getBoundingClientRect();
    var left = rect.left;
    var anchoPanel = panel.offsetWidth;
    if (left + anchoPanel > window.innerWidth - 10) left = window.innerWidth - anchoPanel - 10;
    panel.style.top = (rect.bottom + 4) + 'px';
    panel.style.left = Math.max(10, left) + 'px';

    setTimeout(function () {
      document.addEventListener('click', clickAfuera, true);
      window.addEventListener('scroll', cerrarPanel, true);
      window.addEventListener('resize', cerrarPanel);
    }, 0);
  }

  tabla.querySelectorAll('.th-filtro-btn').forEach(function (boton) {
    boton.addEventListener('click', function (e) {
      e.stopPropagation();
      abrirPanel(boton, boton.dataset.col);
    });
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') cerrarPanel();
  });
})();
</script>

<script src="https://unpkg.com/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
<script>
(function () {
  // Datos del listado de precios: solo código, nombre y precios — nada de
  // costo, margen ni flete, porque este PDF es para mandarle a un
  // potencial cliente o revisar valores, no información interna.
  var ARTICULOS_PDF = <%- JSON.stringify(articulos.map(a => ({
    codigo: a.codigo,
    nombre: a.nombre,
    precioEfectivo: a.precioEfectivo,
    precioLista: a.precioLista,
    precioSugerido: a.precioSugerido,
    prioridad: a.prioridad_listado || null,
    activo: a.activo !== false,
    stock: (a.stock === null || a.stock === undefined) ? null : Number(a.stock),
  }))) %>;

  // Mismo umbral que en el apartado Stock: por debajo de esto ya se
  // considera sin stock real para vender, aunque el número sea positivo.
  var UMBRAL_SIN_STOCK = 0.5;

  var boton = document.getElementById('generar-listado-precios');
  if (!boton) return;

  boton.addEventListener('click', function () {
    if (typeof window.jspdf === 'undefined') {
      alert('No se pudo cargar la librería para generar el PDF. Revisá la conexión a internet e intentá de nuevo.');
      return;
    }

    var activos = ARTICULOS_PDF.filter(function (a) { return a.activo; });
    if (activos.length === 0) {
      alert('Todavía no hay artículos cargados para armar un listado.');
      return;
    }

    // Agrupado por prioridad (1º, 2º, 3º orden primero, en ese orden) y
    // dentro de cada grupo alfabético — los que no tienen prioridad
    // asignada van al final, también alfabético.
    var articulosOrdenados = activos.slice().sort(function (a, b) {
      var pa = a.prioridad || 99;
      var pb = b.prioridad || 99;
      if (pa !== pb) return pa - pb;
      return a.nombre.localeCompare(b.nombre, 'es');
    });

    var jsPDF = window.jspdf.jsPDF;
    var doc = new jsPDF({ unit: 'mm', format: 'a4' });
    var margenIzq = 14;
    var margenDer = 14;
    var anchoPagina = doc.internal.pageSize.getWidth();
    var altoPagina = doc.internal.pageSize.getHeight();
    var xCodigo = margenIzq;
    var xProducto = margenIzq + 24;
    var xSugerido = anchoPagina - margenDer;
    var xLista = xSugerido - 28;
    var xEfectivo = xLista - 28;
    var y = 20;

    function dibujarTitulo() {
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(15);
      doc.text('Riomar Pescadería — Lista de precios', margenIzq, y);
      y += 6;
      doc.setFont('helvetica', 'normal');
      doc.setFontSize(9);
      doc.setTextColor(110);
      doc.text('Generado el ' + new Date().toLocaleDateString('es-AR'), margenIzq, y);
      doc.setTextColor(0);
      y += 9;
    }

    function dibujarEncabezadoTabla() {
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(9.5);
      doc.text('Código', xCodigo, y);
      doc.text('Producto', xProducto, y);
      doc.text('Efectivo', xEfectivo, y, { align: 'right' });
      doc.text('Lista', xLista, y, { align: 'right' });
      doc.text('Sugerido', xSugerido, y, { align: 'right' });
      y += 2;
      doc.setDrawColor(180);
      doc.setLineWidth(0.2);
      doc.line(margenIzq, y, anchoPagina - margenDer, y);
      y += 5;
      doc.setFont('helvetica', 'normal');
      doc.setTextColor(0);
    }

    dibujarTitulo();
    dibujarEncabezadoTabla();

    articulosOrdenados.forEach(function (a) {
      if (y > altoPagina - 20) {
        doc.addPage();
        y = 20;
        dibujarEncabezadoTabla();
      }
      doc.setFontSize(9.5);
      doc.text(String(a.codigo), xCodigo, y);
      // El nombre tiene menos lugar disponible ahora que hay tres columnas
      // de precio en vez de dos (antes entraban hasta 48 caracteres).
      var nombreTexto = a.nombre.length > 36 ? a.nombre.slice(0, 35) + '…' : a.nombre;
      doc.text(nombreTexto, xProducto, y);
      // "Sin stock" se decide por el stock real (apartado Stock), no por
      // el precio: por debajo del umbral se muestra así en vez del
      // precio, aunque el número sea positivo (un resto de 0,2kg no
      // alcanza para vender). Si el stock no se conoce todavía (null, el
      // artículo nunca se sincronizó/tocó en Stock) se sigue mostrando el
      // precio normal, para no marcar como agotado algo que en realidad
      // no se sabe.
      if (a.stock === null || a.stock >= UMBRAL_SIN_STOCK) {
        doc.text('$' + Math.round(a.precioEfectivo), xEfectivo, y, { align: 'right' });
        doc.text('$' + Math.round(a.precioLista), xLista, y, { align: 'right' });
        doc.text('$' + Math.round(a.precioSugerido), xSugerido, y, { align: 'right' });
      } else {
        doc.setFont('helvetica', 'italic');
        doc.setTextColor(150);
        doc.text('Sin stock', xSugerido, y, { align: 'right' });
        doc.setFont('helvetica', 'normal');
        doc.setTextColor(0);
      }
      y += 6;
    });

    y += 4;
    if (y > altoPagina - 15) { doc.addPage(); y = 20; }
    doc.setFontSize(8);
    doc.setTextColor(120);
    doc.text('Precios sujetos a modificación sin previo aviso.', margenIzq, y);

    var fecha = new Date().toISOString().slice(0, 10);
    doc.save('lista-de-precios-' + fecha + '.pdf');
  });
})();
</script>

<%- include('../partials/foot') %>
