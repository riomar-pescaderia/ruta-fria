<%- include('../partials/head') %>

<div class="toolbar">
  <h1>Artículos</h1>
  <div style="display:flex; gap:8px; flex-wrap:wrap;">
    <button type="button" id="generar-listado-precios" class="btn secondary">Generar listado de precios (PDF)</button>
    <a class="btn secondary" href="/articulos/importar">Importar desde planilla</a>
    <a class="btn" href="/articulos/nuevo">+ Nuevo artículo</a>
  </div>
</div>

<p style="color:var(--ink-soft); font-size:.9rem; margin-top:-10px;">
  IVA <%= config.iva_pct %>% · IIBB <%= config.iibb_pct %>% · recargo por medio de pago <%= config.recargo_lista_pct %>% — configurables más adelante en una sola pantalla.
</p>

<% if (error) { %>
  <p style="color:#b3261e;"><%= error %></p>
<% } %>

<% if (articulos.length === 0) { %>
  <p class="empty">Todavía no cargaste ningún artículo.</p>
<% } else { %>
<div style="max-width:340px; margin-bottom:14px;">
  <input type="text" id="buscar-articulo" placeholder="Buscar por nombre o código...">
</div>
<p id="sin-resultados-articulos" class="empty" style="display:none;">No encontré ningún artículo con ese nombre o código.</p>
<table id="tabla-articulos">
  <thead>
    <tr>
      <th>Código</th>
      <th>Nombre</th>
      <th>Unidad</th>
      <th>Costo</th>
      <th>Precio efectivo</th>
      <th>Precio de lista</th>
      <th>Orden en listado PDF</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% articulos.forEach(a => { %>
    <tr data-buscar="<%= (a.codigo + ' ' + a.nombre).toLowerCase() %>" data-href="/articulos/<%= a.id %>/editar">
      <td data-label="Código" class="mono"><%= a.codigo %></td>
      <td data-label="Nombre"><%= a.nombre %></td>
      <td data-label="Unidad" class="col-mobile-oculta"><%= a.unidad %></td>
      <td data-label="Costo" class="mono col-mobile-oculta"<% if (Number(a.unidad) !== 1) { %> title="$<%= Number(a.costo).toFixed(2) %>/kg ÷ <%= a.unidad %>"<% } %>>$<%= a.costoPorUnidad.toFixed(2) %></td>
      <td data-label="Precio efectivo" data-corto="Efvo" class="mono">$<%= a.precioEfectivo.toFixed(0) %></td>
      <td data-label="Precio de lista" data-corto="Lista" class="mono">$<%= a.precioLista.toFixed(0) %></td>
      <td data-label="Orden en listado PDF" class="col-mobile-oculta">
        <form method="post" action="/articulos/<%= a.id %>/prioridad" style="margin:0;">
          <select name="prioridad_listado" onchange="this.form.submit()" style="max-width:150px;">
            <option value="" <%= !a.prioridad_listado ? 'selected' : '' %>>Sin prioridad</option>
            <option value="1" <%= a.prioridad_listado === 1 ? 'selected' : '' %>>Primer orden</option>
            <option value="2" <%= a.prioridad_listado === 2 ? 'selected' : '' %>>Segundo orden</option>
            <option value="3" <%= a.prioridad_listado === 3 ? 'selected' : '' %>>Tercer orden</option>
          </select>
        </form>
      </td>
      <td data-label="" class="col-acciones-lista" style="display:flex; gap:8px; flex-wrap:wrap;">
        <a class="btn secondary" href="/articulos/<%= a.id %>/editar">Editar</a>
        <form method="post" action="/articulos/<%= a.id %>/eliminar" style="display:inline; margin:0;" onsubmit="return confirm('¿Eliminar este artículo? No se puede deshacer.');">
          <button type="submit" class="btn secondary" style="color:#a33;">Eliminar</button>
        </form>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
<% } %>

<script>
(function () {
  var input = document.getElementById('buscar-articulo');
  if (!input) return;
  var filas = document.querySelectorAll('#tabla-articulos tbody tr');
  var sinResultados = document.getElementById('sin-resultados-articulos');
  input.addEventListener('input', function () {
    var texto = input.value.trim().toLowerCase();
    var visibles = 0;
    filas.forEach(function (tr) {
      var coincide = !texto || tr.dataset.buscar.indexOf(texto) !== -1;
      tr.hidden = !coincide;
      if (coincide) visibles++;
    });
    sinResultados.style.display = visibles === 0 ? 'block' : 'none';
  });
})();
</script>

<script src="https://unpkg.com/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
<script>
(function () {
  // Datos del listado de precios: solo código, nombre y precios — nada de
  // costo, margen ni flete, porque este PDF es para mandarle a un
  // potencial cliente o revisar valores, no información interna.
  var ARTICULOS_PDF = <%- JSON.stringify(articulos.map(a => ({
    codigo: a.codigo,
    nombre: a.nombre,
    precioEfectivo: a.precioEfectivo,
    precioLista: a.precioLista,
    prioridad: a.prioridad_listado || null,
    activo: a.activo !== false,
  }))) %>;

  var boton = document.getElementById('generar-listado-precios');
  if (!boton) return;

  boton.addEventListener('click', function () {
    if (typeof window.jspdf === 'undefined') {
      alert('No se pudo cargar la librería para generar el PDF. Revisá la conexión a internet e intentá de nuevo.');
      return;
    }

    var activos = ARTICULOS_PDF.filter(function (a) { return a.activo; });
    if (activos.length === 0) {
      alert('Todavía no hay artículos cargados para armar un listado.');
      return;
    }

    // Agrupado por prioridad (1º, 2º, 3º orden primero, en ese orden) y
    // dentro de cada grupo alfabético — los que no tienen prioridad
    // asignada van al final, también alfabético.
    var articulosOrdenados = activos.slice().sort(function (a, b) {
      var pa = a.prioridad || 99;
      var pb = b.prioridad || 99;
      if (pa !== pb) return pa - pb;
      return a.nombre.localeCompare(b.nombre, 'es');
    });

    var jsPDF = window.jspdf.jsPDF;
    var doc = new jsPDF({ unit: 'mm', format: 'a4' });
    var margenIzq = 14;
    var margenDer = 14;
    var anchoPagina = doc.internal.pageSize.getWidth();
    var altoPagina = doc.internal.pageSize.getHeight();
    var xCodigo = margenIzq;
    var xProducto = margenIzq + 24;
    var xEfectivo = anchoPagina - margenDer - 28;
    var xLista = anchoPagina - margenDer;
    var y = 20;

    function dibujarTitulo() {
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(15);
      doc.text('Riomar Pescadería — Lista de precios', margenIzq, y);
      y += 6;
      doc.setFont('helvetica', 'normal');
      doc.setFontSize(9);
      doc.setTextColor(110);
      doc.text('Generado el ' + new Date().toLocaleDateString('es-AR'), margenIzq, y);
      doc.setTextColor(0);
      y += 9;
    }

    function dibujarEncabezadoTabla() {
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(9.5);
      doc.text('Código', xCodigo, y);
      doc.text('Producto', xProducto, y);
      doc.text('Efectivo', xEfectivo, y, { align: 'right' });
      doc.text('Lista', xLista, y, { align: 'right' });
      y += 2;
      doc.setDrawColor(180);
      doc.setLineWidth(0.2);
      doc.line(margenIzq, y, anchoPagina - margenDer, y);
      y += 5;
      doc.setFont('helvetica', 'normal');
      doc.setTextColor(0);
    }

    dibujarTitulo();
    dibujarEncabezadoTabla();

    articulosOrdenados.forEach(function (a) {
      if (y > altoPagina - 20) {
        doc.addPage();
        y = 20;
        dibujarEncabezadoTabla();
      }
      doc.setFontSize(9.5);
      doc.text(String(a.codigo), xCodigo, y);
      var nombreTexto = a.nombre.length > 48 ? a.nombre.slice(0, 47) + '…' : a.nombre;
      doc.text(nombreTexto, xProducto, y);
      doc.text('$' + Math.round(a.precioEfectivo), xEfectivo, y, { align: 'right' });
      doc.text('$' + Math.round(a.precioLista), xLista, y, { align: 'right' });
      y += 6;
    });

    y += 4;
    if (y > altoPagina - 15) { doc.addPage(); y = 20; }
    doc.setFontSize(8);
    doc.setTextColor(120);
    doc.text('Precios sujetos a modificación sin previo aviso.', margenIzq, y);

    var fecha = new Date().toISOString().slice(0, 10);
    doc.save('lista-de-precios-' + fecha + '.pdf');
  });
})();
</script>

<%- include('../partials/foot') %>
