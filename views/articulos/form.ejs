<%- include('../partials/head') %>

<h1><%= articulo.id ? 'Editar artículo' : 'Nuevo artículo' %></h1>

<form class="card" method="post" action="<%= accion %>">
  <div>
    <label for="codigo">Código</label>
    <input type="text" id="codigo" name="codigo" value="<%= articulo.codigo || '' %>" required>
  </div>
  <div>
    <label for="nombre">Nombre</label>
    <input type="text" id="nombre" name="nombre" value="<%= articulo.nombre || '' %>" required>
  </div>
  <div>
    <label for="unidad">Unidad</label>
    <select id="unidad" name="unidad">
      <% ['kg','cajon','bolsa','unidad'].forEach(op => { %>
        <option value="<%= op %>" <%= articulo.unidad === op ? 'selected' : '' %>><%= op %></option>
      <% }) %>
    </select>
  </div>
  <div>
    <label for="contenido_gr">Contenido por unidad, en gramos (solo si Unidad = "unidad")</label>
    <input type="number" step="1" id="contenido_gr" name="contenido_gr" value="<%= articulo.contenido_gr || '' %>" placeholder="ej. 200">
    <p style="color:var(--ink-soft); font-size:.85rem; margin:6px 0 0;">Para artículos que se venden por unidad/paquete pero cuyo costo se carga por kg (como llega en la factura). Si cargás esto, el costo por unidad se calcula solo: costo por kg × (gramos ÷ 1000). Dejalo vacío si el costo ya es directamente el de la unidad.</p>
  </div>

  <% if (articulo.id) { %>
  <div>
    <label>Costo<%= articulo.unidad === 'unidad' && articulo.contenido_gr ? ' (por kg, no por unidad)' : '' %></label>
    <input type="text" value="$<%= Number(articulo.costo).toFixed(2) %><%= articulo.unidad === 'unidad' && articulo.contenido_gr ? '/kg' : '' %> — se actualiza desde Compras" disabled>
  </div>
  <% } else { %>
  <p style="color:var(--ink-soft); font-size:.85rem; margin:0;">El costo arranca en $0 y se completa solo apenas carguen la primera factura de este artículo en Compras.</p>
  <% } %>

  <div class="check-row">
    <input type="checkbox" id="aplica_iva" name="aplica_iva" <%= articulo.aplica_iva !== false ? 'checked' : '' %>>
    <label for="aplica_iva" style="margin:0;">Aplica IVA</label>
  </div>
  <div class="check-row">
    <input type="checkbox" id="aplica_iibb" name="aplica_iibb" <%= articulo.aplica_iibb !== false ? 'checked' : '' %>>
    <label for="aplica_iibb" style="margin:0;">Aplica IIBB</label>
  </div>
  <div>
    <label for="flete_pct">Flete (%)</label>
    <input type="number" step="0.01" id="flete_pct" name="flete_pct" value="<%= articulo.flete_pct || 0 %>">
  </div>
  <div>
    <label for="margen_pct">Margen de beneficio (%)</label>
    <input type="number" step="0.01" id="margen_pct" name="margen_pct" value="<%= articulo.margen_pct || 0 %>">
  </div>
  <div>
    <label for="stock">Stock aproximado (opcional)</label>
    <input type="number" step="0.01" id="stock" name="stock" value="<%= articulo.stock || '' %>">
  </div>
  <div>
    <button class="btn" type="submit">Guardar</button>
    <a class="btn secondary" href="/articulos">Cancelar</a>
  </div>
</form>

<%- include('../partials/foot') %>
