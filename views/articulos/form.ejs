<%- include('../partials/head') %>

<h1><%= articulo.id ? 'Editar artículo' : 'Nuevo artículo' %></h1>

<form class="card" method="post" action="<%= accion %>">
  <div>
    <label for="codigo">Código</label>
    <input type="text" id="codigo" name="codigo" value="<%= articulo.codigo || '' %>" required>
  </div>
  <div>
    <label for="nombre">Nombre</label>
    <input type="text" id="nombre" name="nombre" value="<%= articulo.nombre || '' %>" required>
  </div>
  <div>
    <label for="unidad">Unidad (divisor de kg)</label>
    <input type="number" step="0.01" id="unidad" name="unidad" value="<%= articulo.unidad || 1 %>" placeholder="1">
    <p style="color:var(--ink-soft); font-size:.85rem; margin:6px 0 0;">El costo se carga siempre por kg; acá se divide para llegar al costo real de lo que vendés. Dejalo en 1 si el precio ya es directamente por kg. Ejemplos: se vende en paquetes de 200g → poné 5 (1000 ÷ 200). Se vende entero y pesa en promedio 0,75kg → poné 0,75.</p>
  </div>

  <% if (articulo.id) { %>
    <% if (usuario && usuario.esAdmin) { %>
    <div>
      <label for="costo">Costo<%= articulo.unidad && Number(articulo.unidad) !== 1 ? ' (por kg, antes de dividir por unidad)' : '' %></label>
      <input type="number" step="0.01" min="0" id="costo" name="costo" value="<%= Number(articulo.costo).toFixed(2) %>">
      <p style="color:var(--ink-soft); font-size:.85rem; margin:6px 0 0;">Se actualiza solo con la última factura de compra confirmada — como administrador podés pisarlo a mano acá (por ejemplo para corregir un precio ya mismo, sin cargar una factura). Admite $0.</p>
    </div>
    <% } else { %>
    <div>
      <label>Costo<%= articulo.unidad && Number(articulo.unidad) !== 1 ? ' (por kg, antes de dividir por unidad)' : '' %></label>
      <input type="text" value="$<%= Number(articulo.costo).toFixed(2) %> — se actualiza desde Compras" disabled>
    </div>
    <% } %>
  <% } else { %>
  <p style="color:var(--ink-soft); font-size:.85rem; margin:0;">El costo arranca en $0 y se completa solo apenas carguen la primera factura de este artículo en Compras.</p>
  <% } %>

  <div class="check-row">
    <input type="checkbox" id="aplica_iva" name="aplica_iva" <%= articulo.aplica_iva !== false ? 'checked' : '' %>>
    <label for="aplica_iva" style="margin:0;">Aplica IVA</label>
  </div>
  <div class="check-row">
    <input type="checkbox" id="aplica_iibb" name="aplica_iibb" <%= articulo.aplica_iibb !== false ? 'checked' : '' %>>
    <label for="aplica_iibb" style="margin:0;">Aplica IIBB</label>
  </div>
  <div>
    <label for="flete_pct">Flete (%)</label>
    <input type="number" step="0.01" id="flete_pct" name="flete_pct" value="<%= articulo.flete_pct || 0 %>">
  </div>
  <div>
    <label for="margen_pct">Margen de beneficio (%)</label>
    <input type="number" step="0.01" id="margen_pct" name="margen_pct" value="<%= articulo.margen_pct || 0 %>">
  </div>
  <div>
    <button class="btn" type="submit">Guardar</button>
    <a class="btn secondary" href="/articulos">Cancelar</a>
  </div>
</form>

<% if (articulo.id) { %>
<p style="color:var(--ink-soft); font-size:.85rem; max-width:520px; margin-top:10px;">
  El stock ya no se edita desde acá: lo maneja <a href="/stock/<%= articulo.id %>">el apartado Stock</a>, que lo actualiza solo con cada venta y compra y deja historial de cualquier ajuste a mano.
</p>
<% } %>

<% if (articulo.id) { %>
<div class="card" style="max-width:520px; margin-top:16px;">
  <h2 style="font-size:1rem; margin:0 0 6px;">Ticket de envasado</h2>
  <p style="color:var(--ink-soft); font-size:.85rem; margin:0 0 12px;">
    Para pegar en la bolsa: nombre del artículo, fecha de envasado (la de hoy) y "consumir antes de" (6 meses después).
  </p>
  <div style="margin-bottom:12px;">
    <label for="formato-ticket">Tamaño de etiqueta</label>
    <select id="formato-ticket" style="max-width:260px;">
      <option value="30x15">30 × 15 mm</option>
      <option value="40x15">40 × 15 mm</option>
      <option value="40x30">40 × 30 mm</option>
      <option value="50x30">50 × 30 mm</option>
      <option value="70x50" selected>70 × 50 mm (recomendado)</option>
      <option value="50x80">50 × 80 mm</option>
    </select>
  </div>
  <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
    <button type="button" id="descargar-ticket" class="btn secondary">Descargar ticket (PDF)</button>
    <button type="button" id="imprimir-ticket-directo" class="btn secondary">Imprimir directo (Bluetooth)</button>
  </div>
  <p id="estado-impresion-directa" style="color:var(--ink-soft); font-size:.82rem; margin:10px 0 0; display:none;"></p>

  <%# Se abre al tocar cualquiera de los dos botones: el clic en "Imprimir"
      de este cuadro es el que arranca la impresión (el navegador solo deja
      abrir el selector de Bluetooth justo después de un clic). %>
  <dialog id="dialogo-copias" style="border:1px solid var(--line); border-radius:14px; padding:20px; max-width:320px; width:calc(100% - 32px); background:var(--surface);">
    <form method="dialog" id="form-copias" style="margin:0;">
      <h3 style="margin:0 0 4px; font-size:1.05rem;">¿Cuántas copias?</h3>
      <p id="dialogo-copias-detalle" style="color:var(--ink-soft); font-size:.82rem; margin:0 0 14px;"></p>
      <div style="display:flex; align-items:center; justify-content:center; gap:10px; margin-bottom:18px;">
        <button type="button" id="copias-menos" class="btn secondary" aria-label="Una copia menos" style="width:48px; height:48px; font-size:1.4rem; padding:0;">−</button>
        <input type="number" id="cantidad-copias" value="1" min="1" max="50" step="1" inputmode="numeric" aria-label="Cantidad de copias" style="width:80px; height:48px; text-align:center; font-size:1.3rem;">
        <button type="button" id="copias-mas" class="btn secondary" aria-label="Una copia más" style="width:48px; height:48px; font-size:1.4rem; padding:0;">+</button>
      </div>
      <div style="display:flex; gap:8px; justify-content:flex-end;">
        <button type="button" id="copias-cancelar" class="btn secondary">Cancelar</button>
        <button type="submit" id="copias-confirmar" class="btn">Imprimir</button>
      </div>
    </form>
  </dialog>
  <p style="color:var(--ink-soft); font-size:.78rem; margin:10px 0 0;">
    La impresión directa manda el ticket por Bluetooth a una impresora de stickers Niimbot B31 — funciona en Chrome o Edge (no en Safari ni Firefox), y el navegador te va a pedir elegir el dispositivo la primera vez.
  </p>
</div>
<% } %>

<% if (articulo.id) { %>
<div style="max-width:520px; margin-top:16px;">
  <form method="post" action="/articulos/<%= articulo.id %>/eliminar" style="margin:0;" onsubmit="return confirm('¿Eliminar este artículo? No se puede deshacer.');">
    <button type="submit" class="btn secondary" style="color:#a33;">Eliminar artículo</button>
  </form>
</div>
<% } %>

<% if (articulo.id) { %>
<script src="https://unpkg.com/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
<script>
(function () {
  var ARTICULO = <%- JSON.stringify({ codigo: articulo.codigo, nombre: articulo.nombre }) %>;

  // ===== Formatos de etiqueta disponibles =====
  // El diseño de referencia está pensado para 70×50mm — los demás
  // tamaños reescalan y se reacomodan (ver calcularEscala/dibujarTicket),
  // tanto para el PDF como para la imagen que se manda por Bluetooth.
  var FORMATOS = {
    '30x15': { ancho: 30, alto: 15 },
    '40x15': { ancho: 40, alto: 15 },
    '40x30': { ancho: 40, alto: 30 },
    '50x30': { ancho: 50, alto: 30 },
    '70x50': { ancho: 70, alto: 50 },
    '50x80': { ancho: 50, alto: 80 },
  };

  function obtenerFormatoSeleccionado() {
    var select = document.getElementById('formato-ticket');
    var valor = select ? select.value : '70x50';
    return FORMATOS[valor] || FORMATOS['70x50'];
  }

  // Entre 1 y 50 — si el campo queda vacío o con cualquier cosa, 1.
  var MAX_COPIAS = 50;
  function obtenerCopias() {
    var campo = document.getElementById('cantidad-copias');
    var n = campo ? parseInt(campo.value, 10) : 1;
    if (!(n >= 1)) n = 1;
    n = Math.min(MAX_COPIAS, n);
    if (campo) campo.value = n;
    return n;
  }

  // ===== Cuadro "¿Cuántas copias?" =====
  // Lo abren los dos botones; al confirmar llama a accion(copias). Arranca
  // siempre en 1 para no imprimir de más por haber dejado otro número.
  var dialogoCopias = document.getElementById('dialogo-copias');
  var accionPendiente = null;

  function pedirCopias(detalle, textoBoton, accion) {
    var campo = document.getElementById('cantidad-copias');
    campo.value = 1;
    document.getElementById('dialogo-copias-detalle').textContent = detalle;
    document.getElementById('copias-confirmar').textContent = textoBoton;
    accionPendiente = accion;
    if (dialogoCopias && dialogoCopias.showModal) {
      dialogoCopias.showModal();
      campo.select();
    } else {
      // Navegador sin <dialog>: sigue con una copia.
      accion(1);
    }
  }

  if (dialogoCopias) {
    document.getElementById('copias-menos').addEventListener('click', function () {
      var campo = document.getElementById('cantidad-copias');
      campo.value = Math.max(1, obtenerCopias() - 1);
    });
    document.getElementById('copias-mas').addEventListener('click', function () {
      var campo = document.getElementById('cantidad-copias');
      campo.value = Math.min(MAX_COPIAS, obtenerCopias() + 1);
    });
    document.getElementById('copias-cancelar').addEventListener('click', function () {
      accionPendiente = null;
      dialogoCopias.close();
    });
    // El "Imprimir" (o Enter en el campo) envía el formulario: este clic
    // es el que habilita al navegador a abrir el selector de Bluetooth.
    document.getElementById('form-copias').addEventListener('submit', function (ev) {
      ev.preventDefault();
      var copias = obtenerCopias();
      var accion = accionPendiente;
      accionPendiente = null;
      dialogoCopias.close();
      if (accion) accion(copias);
    });
  }

  // DD/MM/AAAA, igual al formato que se usa en el resto del sistema.
  function formatearFechaCorta(f) {
    var dd = String(f.getDate()).padStart(2, '0');
    var mm = String(f.getMonth() + 1).padStart(2, '0');
    return dd + '/' + mm + '/' + f.getFullYear();
  }

  // Suma meses sin "desbordar" cuando el mes de destino tiene menos
  // días: 31 de agosto + 6 meses daría 31 de febrero, que no existe, y
  // el Date de JS por su cuenta lo empuja al 3 de marzo en vez de
  // quedarse en el último día de febrero. Esto lo corrige quedándose en
  // el último día del mes de destino en vez de pasarse al siguiente.
  function sumarMeses(fecha, meses) {
    var d = new Date(fecha);
    var diaOriginal = d.getDate();
    d.setMonth(d.getMonth() + meses);
    if (d.getDate() !== diaOriginal) d.setDate(0);
    return d;
  }

  // ===== Medidas del diseño, escaladas según el tamaño elegido =====
  // Todo está pensado en milímetros, tanto para el PDF (que ya trabaja
  // en mm) como para la imagen de la impresora Bluetooth (que los
  // convierte a puntos según el DPI — ver PUNTOS_POR_MM más abajo).
  // Sin topes: el diseño se reacomoda solo según cuánto sobra de ancho o
  // de alto (ver dibujarTicket), y así siempre ocupa la etiqueta entera.
  function calcularEscala(anchoMm, altoMm) {
    return Math.min(anchoMm / 70, altoMm / 50);
  }

  var MM_A_PT = 2.8346;

  // ===== Logo para el ticket =====
  // Versión en blanco y negro puro del logo (el pez en blanco sobre el
  // cielo negro), hecha a propósito para la impresora térmica: el logo a
  // color, pasado a blanco y negro por brillo, perdía el naranja y el
  // azul y quedaba borroso. Se precarga al abrir la página para que ya
  // esté listo cuando se aprieta un botón.
  var LOGO_TICKET = new Image();
  var logoListo = new Promise(function (resolve) {
    LOGO_TICKET.onload = function () { resolve(true); };
    LOGO_TICKET.onerror = function () { resolve(false); };
  });
  LOGO_TICKET.src = '/img/logo-riomar-termica.png';

  // ===== Diseño del ticket (uno solo para el PDF y para el Bluetooth) =====
  // Se dibuja en "unidades de diseño": el tamaño de referencia es 70×50,
  // y cada etiqueta se lleva a esa escala (escala = calcularEscala), así
  // que el ancho y el alto en unidades quedan en 70+ y 50+. El "pintor"
  // (pdf o canvas) traduce esas unidades a mm o a puntos de la impresora.
  //
  // Franja negra arriba con el nombre del artículo, el logo a la
  // izquierda y las dos fechas en recuadros a la derecha (la de "consumir
  // antes de" en negro, para que resalte). Las etiquetas muy bajas
  // (40×15, 30×15) y la vertical (50×80) reacomodan lo mismo.
  var PIE_TICKET = 'RIOMAR PESCADERÍA  ·  Conservar a -18 °C';

  function ajustarTamano(p, texto, anchoMax, inicial, minimo, negrita) {
    for (var t = inicial; t > minimo; t -= 0.1) {
      if (p.ancho(texto, t, negrita) <= anchoMax) return t;
    }
    return minimo;
  }

  function partirEnLineas(p, texto, anchoMax, tam, negrita) {
    var lineas = [];
    var actual = '';
    texto.split(/\s+/).filter(Boolean).forEach(function (palabra) {
      var intento = actual ? actual + ' ' + palabra : palabra;
      if (p.ancho(intento, tam, negrita) > anchoMax && actual) {
        lineas.push(actual);
        actual = palabra;
      } else {
        actual = intento;
      }
    });
    if (actual) lineas.push(actual);
    return lineas.length ? lineas : [''];
  }

  // El tamaño de letra más grande (entre inicial y mínimo) con el que el
  // texto entra en hasta maxLineas renglones.
  function ajustarLineas(p, texto, anchoMax, maxLineas, inicial, minimo, negrita) {
    for (var t = inicial; t >= minimo; t -= 0.1) {
      var lineas = partirEnLineas(p, texto, anchoMax, t, negrita);
      var entra = lineas.length <= maxLineas && lineas.every(function (l) { return p.ancho(l, t, negrita) <= anchoMax; });
      if (entra) return { tam: t, lineas: lineas };
    }
    return { tam: minimo, lineas: partirEnLineas(p, texto, anchoMax, minimo, negrita) };
  }

  function dibujarNombreEnFranja(p, nombre, W, altoFranja, maxLineas, inicial, minimo) {
    p.rect(0, 0, W, altoFranja);
    var n = ajustarLineas(p, nombre, W - 7, maxLineas, inicial, minimo, true);
    var interlineado = n.tam * 1.08;
    var y = (altoFranja - n.lineas.length * interlineado) / 2 + n.tam * 0.82;
    n.lineas.forEach(function (l) {
      p.texto(l, W / 2, y, n.tam, { negrita: true, alinear: 'center', blanco: true });
      y += interlineado;
    });
  }

  // Recuadro con la etiqueta arriba y la fecha abajo. "lleno" = fondo
  // negro con letra blanca.
  function dibujarRecuadroFecha(p, x, y, w, h, etiqueta, fecha, lleno, tamEtiqueta, tamFecha) {
    p.rectRedondo(x, y, w, h, 1.3, lleno);
    var util = w - 3.2;
    p.texto(etiqueta, x + 1.6, y + h * 0.36, ajustarTamano(p, etiqueta, util, tamEtiqueta, 1.3, true), { negrita: true, blanco: lleno });
    p.texto(fecha, x + 1.6, y + h * 0.82, ajustarTamano(p, fecha, util, tamFecha, 2.2, true), { negrita: true, blanco: lleno });
  }

  // Variante de un solo renglón (etiqueta a la izquierda, fecha a la
  // derecha) para las etiquetas bajas, donde no entran dos renglones.
  function dibujarRecuadroFechaEnLinea(p, x, y, w, h, etiqueta, fecha, lleno) {
    p.rectRedondo(x, y, w, h, 1.3, lleno);
    var util = w - 3.2;
    var tam = ajustarTamano(p, etiqueta + '   ' + fecha, util, 7, 2.5, true);
    var base = y + h / 2 + tam * 0.36;
    p.texto(etiqueta, x + 1.6, base, tam, { negrita: true, blanco: lleno });
    p.texto(fecha, x + w - 1.6, base, tam, { negrita: true, alinear: 'right', blanco: lleno });
  }

  function dibujarPie(p, W, H) {
    p.linea(3.5, H - 8.5, W - 3.5, H - 8.5, 0.25);
    p.texto(PIE_TICKET, W / 2, H - 4, ajustarTamano(p, PIE_TICKET, W - 7, 2.5, 1.4, true), { negrita: true, alinear: 'center' });
  }

  function dibujarTicket(p, escala, W, H, nombre, fechaEnvasado, fechaVencimiento) {
    var pad = 3.5;
    var logoProporcion = LOGO_TICKET.naturalWidth ? LOGO_TICKET.naturalWidth / LOGO_TICKET.naturalHeight : 1.25;

    if (H > 70) {
      // Vertical (50×80): todo apilado y a lo ancho.
      dibujarNombreEnFranja(p, nombre, W, 20, 2, 7.5, 3.5);
      var logoAltoV = Math.min(38, (W - pad * 2) * 0.75 / logoProporcion);
      p.logo((W - logoAltoV * logoProporcion) / 2, 24, logoAltoV * logoProporcion, logoAltoV);
      var yCajas = 24 + logoAltoV + 5;
      var altoCaja = Math.min(14, (H - 11 - yCajas - 3) / 2);
      dibujarRecuadroFecha(p, pad, yCajas, W - pad * 2, altoCaja, 'ENVASADO', fechaEnvasado, false, 3, 6);
      dibujarRecuadroFecha(p, pad, yCajas + altoCaja + 3, W - pad * 2, altoCaja, 'CONSUMIR ANTES DE', fechaVencimiento, true, 3, 6);
      dibujarPie(p, W, H);
      return;
    }

    if (W > 95) {
      // Bajas y anchas (40×15, 30×15): sin pie, y cada fecha en un renglón.
      dibujarNombreEnFranja(p, nombre, W, 16, 2, 10, 4.5);
      var arriba = 19, cuerpo = H - 3 - arriba;
      var logoAltoA = Math.min(cuerpo, (W - pad * 2) * 0.3 / logoProporcion);
      var logoAnchoA = logoAltoA * logoProporcion;
      p.logo(pad, arriba + (cuerpo - logoAltoA) / 2, logoAnchoA, logoAltoA);
      var xA = pad + logoAnchoA + 3, anchoA = W - pad - xA, altoA = (cuerpo - 2) / 2;
      dibujarRecuadroFechaEnLinea(p, xA, arriba, anchoA, altoA, 'ENV.', fechaEnvasado, false);
      dibujarRecuadroFechaEnLinea(p, xA, arriba + altoA + 2, anchoA, altoA, 'VENCE', fechaVencimiento, true);
      return;
    }

    // Estándar (70×50, 50×30, 40×30). En las chicas (escala < 0.8) la
    // letra del pie y de los rótulos quedaría por debajo de 1mm real,
    // ilegible en la térmica: se saca el pie y se agrandan los recuadros.
    var chica = escala < 0.8;
    dibujarNombreEnFranja(p, nombre, W, 13.5, 2, 6.2, 3);
    var arribaE = 16, abajoE = chica ? H - 3 : H - 11.5, cuerpoE = abajoE - arribaE;
    var logoAlto = Math.min(cuerpoE, (W - pad * 2) * 0.38 / logoProporcion);
    var logoAncho = logoAlto * logoProporcion;
    p.logo(pad, arribaE + (cuerpoE - logoAlto) / 2, logoAncho, logoAlto);
    var x0 = pad + logoAncho + 2.5, ancho = W - pad - x0, altoCajaE = (cuerpoE - 2) / 2;
    var tamEtiqueta = chica ? 3.2 : 2.3, tamFecha = chica ? 6 : 4.2;
    dibujarRecuadroFecha(p, x0, arribaE, ancho, altoCajaE, 'ENVASADO', fechaEnvasado, false, tamEtiqueta, tamFecha);
    dibujarRecuadroFecha(p, x0, arribaE + altoCajaE + 2, ancho, altoCajaE, 'CONSUMIR ANTES DE', fechaVencimiento, true, tamEtiqueta, tamFecha);
    if (!chica) dibujarPie(p, W, H);
  }

  // Pintor para jsPDF: las unidades de diseño × k = milímetros.
  function pintorPdf(doc, k) {
    function fuente(tam, negrita) {
      doc.setFont('helvetica', negrita ? 'bold' : 'normal');
      doc.setFontSize(tam * k * MM_A_PT);
    }
    return {
      rect: function (x, y, w, h) {
        doc.setFillColor(0);
        doc.rect(x * k, y * k, w * k, h * k, 'F');
      },
      rectRedondo: function (x, y, w, h, r, lleno) {
        doc.setFillColor(0);
        doc.setDrawColor(0);
        doc.setLineWidth(0.4 * k);
        doc.roundedRect(x * k, y * k, w * k, h * k, r * k, r * k, lleno ? 'F' : 'S');
      },
      linea: function (x1, y1, x2, y2, grosor) {
        doc.setDrawColor(0);
        doc.setLineWidth(grosor * k);
        doc.line(x1 * k, y1 * k, x2 * k, y2 * k);
      },
      texto: function (str, x, y, tam, op) {
        fuente(tam, op.negrita);
        doc.setTextColor(op.blanco ? 255 : 0);
        doc.text(str, x * k, y * k, op.alinear ? { align: op.alinear } : undefined);
      },
      ancho: function (str, tam, negrita) {
        fuente(tam, negrita);
        return doc.getTextWidth(str) / k;
      },
      logo: function (x, y, w, h) {
        if (LOGO_TICKET.naturalWidth) doc.addImage(LOGO_TICKET, 'PNG', x * k, y * k, w * k, h * k);
      },
    };
  }

  // Pintor para canvas: el contexto ya viene escalado a unidades de diseño.
  function pintorCanvas(ctx) {
    function fuente(tam, negrita) {
      ctx.font = (negrita ? 'bold ' : '') + tam + 'px Arial';
    }
    return {
      rect: function (x, y, w, h) {
        ctx.fillStyle = '#000';
        ctx.fillRect(x, y, w, h);
      },
      rectRedondo: function (x, y, w, h, r, lleno) {
        ctx.beginPath();
        ctx.moveTo(x + r, y);
        ctx.arcTo(x + w, y, x + w, y + h, r);
        ctx.arcTo(x + w, y + h, x, y + h, r);
        ctx.arcTo(x, y + h, x, y, r);
        ctx.arcTo(x, y, x + w, y, r);
        ctx.closePath();
        if (lleno) {
          ctx.fillStyle = '#000';
          ctx.fill();
        } else {
          ctx.strokeStyle = '#000';
          ctx.lineWidth = 0.4;
          ctx.stroke();
        }
      },
      linea: function (x1, y1, x2, y2, grosor) {
        ctx.strokeStyle = '#000';
        ctx.lineWidth = grosor;
        ctx.beginPath();
        ctx.moveTo(x1, y1);
        ctx.lineTo(x2, y2);
        ctx.stroke();
      },
      texto: function (str, x, y, tam, op) {
        fuente(tam, op.negrita);
        ctx.fillStyle = op.blanco ? '#fff' : '#000';
        ctx.textAlign = op.alinear || 'left';
        ctx.fillText(str, x, y);
      },
      ancho: function (str, tam, negrita) {
        fuente(tam, negrita);
        return ctx.measureText(str).width;
      },
      logo: function (x, y, w, h) {
        if (LOGO_TICKET.naturalWidth) ctx.drawImage(LOGO_TICKET, x, y, w, h);
      },
    };
  }

  // ===== Descargar como PDF =====
  function descargarPdf(copias) {
    if (typeof window.jspdf === 'undefined') {
      alert('No se pudo cargar la librería para generar el PDF. Revisá la conexión a internet e intentá de nuevo.');
      return;
    }

    var formato = obtenerFormatoSeleccionado();
    var ANCHO_MM = formato.ancho;
    var ALTO_MM = formato.alto;
    var escala = calcularEscala(ANCHO_MM, ALTO_MM);

    // jsPDF fuerza el formato recibido a la orientación que le pasás
    // (por defecto "portrait"): si el array [ancho, alto] no entra en
    // esa orientación, lo DA VUELTA solo, sin avisar. Como la mayoría
    // de estos tamaños son más anchos que altos (70×50, 50×30, 40×15,
    // 40×30), sin esto la página real terminaba siendo, por ejemplo,
    // 50×70mm en vez de 70×50mm — por eso se veía "cortado" el
    // costado derecho (las fechas quedaban dibujadas fuera de la hoja
    // real). Pidiendo la orientación acorde al tamaño elegido, jsPDF
    // ya no necesita dar vuelta nada y la página sale del tamaño que
    // se eligió.
    var orientacion = ANCHO_MM >= ALTO_MM ? 'landscape' : 'portrait';
    var jsPDF = window.jspdf.jsPDF;
    var doc = new jsPDF({ unit: 'mm', format: [ANCHO_MM, ALTO_MM], orientation: orientacion });

    // La fecha de envasado es la fecha de HOY (el momento en que se
    // genera el ticket, no la fecha en que se cargó el artículo) — y
    // "consumir antes de" son 6 meses después.
    var hoy = new Date();
    var vencimiento = sumarMeses(hoy, 6);

    // Una página del PDF por copia.
    logoListo.then(function () {
      for (var i = 0; i < copias; i++) {
        if (i > 0) doc.addPage([ANCHO_MM, ALTO_MM], orientacion);
        dibujarTicket(pintorPdf(doc, escala), escala, ANCHO_MM / escala, ALTO_MM / escala,
          ARTICULO.nombre, formatearFechaCorta(hoy), formatearFechaCorta(vencimiento));
      }
      doc.save('ticket-' + ARTICULO.codigo + '-' + ANCHO_MM + 'x' + ALTO_MM + '.pdf');
    });
  }

  var botonPdf = document.getElementById('descargar-ticket');
  if (botonPdf) {
    botonPdf.addEventListener('click', function () {
      pedirCopias('Se descarga un PDF con una página por copia.', 'Descargar', descargarPdf);
    });
  }

  // ===== Impresión directa por Bluetooth (Niimbot B31) =====
  //
  // Niimbot no publica un driver que registre esta impresora como una
  // impresora común de Windows/Android, ni documentación oficial del
  // protocolo — así que esto habla directo con la impresora por
  // Bluetooth (Web Bluetooth, nativo del navegador) usando el protocolo
  // que el proyecto de código abierto MultiMote/niimbluelib reconstruyó
  // por ingeniería inversa (github.com/MultiMote/niimbluelib). Al ser no
  // oficial y no estar probado contra una B31 real desde acá, es
  // esperable que la primera vez necesite algún ajuste — si falla, el
  // registro que se muestra debajo de los botones tiene el detalle.
  var NIIMBOT_SERVICE_UUID = 'e7810a71-73ae-499d-8c15-faa9aef0c3f2';
  // Algunos modelos usan en cambio el canal serie genérico de su chip
  // Bluetooth (ISSC/Microchip "transparent UART").
  var NIIMBOT_SERVICE_UUID_ALT = '49535343-fe7d-4ae5-8fa9-9fafd205e455';
  var CMD = {
    CONNECT: 0xc1, IN_CONNECT: 0xc2,
    SET_DENSITY: 0x21, IN_SET_DENSITY: 0x31,
    SET_LABEL_TYPE: 0x23, IN_SET_LABEL_TYPE: 0x33,
    PRINT_START: 0x01, IN_PRINT_START: 0x02,
    PAGE_START: 0x03, IN_PAGE_START: 0x04,
    SET_PAGE_SIZE: 0x13, IN_SET_PAGE_SIZE: 0x14,
    PRINT_BITMAP_ROW: 0x85,
    PRINT_BITMAP_ROW_INDEXED: 0x83,
    PRINT_EMPTY_ROW: 0x84,
    PAGE_END: 0xe3, IN_PAGE_END: 0xe4,
    PRINT_STATUS: 0xa3, IN_PRINT_STATUS: 0xb3,
    PRINT_END: 0xf3, IN_PRINT_END: 0xf4,
  };
  // Ancho del cabezal de la B31 en puntos (600 puntos = 75mm a 203dpi) —
  // el protocolo lo usa como referencia fija para repartir cada renglón
  // en tercios, no como límite del ancho real de la etiqueta elegida.
  var B31_CABEZAL_PUNTOS = 600;
  var DPI = 203;
  var PUNTOS_POR_MM = DPI / 25.4;

  function u16be(n) { return [(n >> 8) & 0xff, n & 0xff]; }

  // ===== Registro =====
  // Cada paso de la impresión (y lo que contesta la impresora, en
  // hexadecimal) queda anotado en la consola del navegador (F12), para
  // diagnosticar si algún día deja de funcionar.
  var NOMBRES_CMD = {};
  Object.keys(CMD).forEach(function (k) { NOMBRES_CMD[CMD[k]] = k; });

  function aHex(bytes) {
    return Array.prototype.map.call(bytes, function (b) { return ('0' + b.toString(16)).slice(-2); }).join(' ');
  }

  var inicioRegistro = 0;
  function registrar(texto) {
    var segundos = ((Date.now() - inicioRegistro) / 1000).toFixed(2);
    console.log('[ruta-fria] [' + segundos + 's] ' + texto);
  }

  function empezarRegistro() {
    inicioRegistro = Date.now();
    registrar('Navegador: ' + navigator.userAgent);
  }

  // [0x55,0x55, CMD, LEN, DATOS…, CHECKSUM, 0xAA,0xAA] — el checksum es
  // un XOR encadenado del comando, el largo y cada byte de datos. El
  // comando "Connect" es el único que además lleva un 0x03 suelto antes
  // de todo el paquete (una rareza del protocolo, confirmada en la
  // librería de referencia).
  function armarPaquete(comando, datos) {
    datos = datos || new Uint8Array(0);
    var checksum = comando ^ datos.length;
    for (var i = 0; i < datos.length; i++) checksum ^= datos[i];
    var cuerpo = new Uint8Array(2 + 1 + 1 + datos.length + 1 + 2);
    var o = 0;
    cuerpo[o++] = 0x55; cuerpo[o++] = 0x55;
    cuerpo[o++] = comando;
    cuerpo[o++] = datos.length;
    cuerpo.set(datos, o); o += datos.length;
    cuerpo[o++] = checksum;
    cuerpo[o++] = 0xaa; cuerpo[o++] = 0xaa;
    if (comando === CMD.CONNECT) {
      var conPrefijo = new Uint8Array(cuerpo.length + 1);
      conPrefijo[0] = 0x03;
      conPrefijo.set(cuerpo, 1);
      return conPrefijo;
    }
    return cuerpo;
  }

  function ClienteNiimbot() {
    this.caracteristica = null;
    this.dispositivo = null;
    this._resolverEspera = null;
    this._comandoEsperado = null;
  }

  ClienteNiimbot.prototype.conectar = function (onEstado) {
    var self = this;
    onEstado('Elegí la impresora en el diálogo del navegador...');
    // Muchas Niimbot no anuncian su servicio hasta que uno se conecta, así
    // que filtrar solo por servicio dejaba la lista vacía: se busca también
    // por nombre (los filtros se suman: alcanza con que cumpla uno). Los
    // servicios van además en optionalServices porque, si el dispositivo
    // se eligió por nombre, el navegador solo deja usar los que estén ahí.
    return navigator.bluetooth.requestDevice({
      filters: [
        { services: [NIIMBOT_SERVICE_UUID] },
        { namePrefix: 'B31' },
        { namePrefix: 'B3' },
        { namePrefix: 'Niimbot' },
        { namePrefix: 'NIIMBOT' },
      ],
      optionalServices: [NIIMBOT_SERVICE_UUID, NIIMBOT_SERVICE_UUID_ALT],
    })
      .then(function (dispositivo) {
        self.dispositivo = dispositivo;
        registrar('Elegida: "' + dispositivo.name + '"');
        onEstado('Conectando...');
        return dispositivo.gatt.connect();
      })
      .then(function (servidor) { return servidor.getPrimaryServices(); })
      .then(function (servicios) {
        registrar('Servicios: ' + servicios.map(function (s) { return s.uuid; }).join(', '));
        var tareas = servicios.map(function (s) { return s.getCharacteristics(); });
        return Promise.all(tareas);
      })
      .then(function (listasDeCaracteristicas) {
        var encontrada = null;
        listasDeCaracteristicas.forEach(function (caracteristicas) {
          caracteristicas.forEach(function (c) {
            var p = c.properties;
            registrar('Característica ' + c.uuid + ' (' + ['read', 'write', 'writeWithoutResponse', 'notify', 'indicate'].filter(function (k) { return p[k]; }).join(', ') + ')');
            if (!encontrada && p.notify && p.writeWithoutResponse) encontrada = c;
          });
        });
        if (!encontrada) throw new Error('No encontré el canal de comunicación con la impresora (puede que no sea compatible con este protocolo).');
        registrar('Usando ' + encontrada.uuid);
        self.caracteristica = encontrada;
        return encontrada.startNotifications();
      })
      .then(function () {
        self.caracteristica.addEventListener('characteristicvaluechanged', function (ev) {
          self._alRecibir(new Uint8Array(ev.target.value.buffer));
        });
      });
  };

  ClienteNiimbot.prototype._alRecibir = function (bytes) {
    // Alcanza con mirar el byte de comando (posición 2) para saber qué
    // respuesta llegó — no hace falta decodificar el resto del
    // contenido para que la impresión funcione.
    if (bytes.length < 3) return;
    var comando = bytes[2];
    registrar('← ' + (NOMBRES_CMD[comando] || ('0x' + comando.toString(16))) + ': ' + aHex(bytes));
    if (this._comandoEsperado !== null && comando === this._comandoEsperado && this._resolverEspera) {
      var resolver = this._resolverEspera;
      this._resolverEspera = null;
      this._comandoEsperado = null;
      resolver(bytes);
    }
  };

  // silencioso: no anota el paquete (los renglones de la imagen son
  // cientos y taparían el resto del registro).
  ClienteNiimbot.prototype.enviar = function (comando, datos, silencioso) {
    var paquete = armarPaquete(comando, datos);
    if (!silencioso) registrar('→ ' + (NOMBRES_CMD[comando] || comando) + ': ' + aHex(paquete));
    return this.caracteristica.writeValueWithoutResponse(paquete.buffer);
  };

  // Manda un comando y espera su respuesta — con un tiempo límite, para
  // seguir igual si la impresora no contesta (no todos los firmwares
  // confirman todo), en vez de trabar la impresión para siempre.
  ClienteNiimbot.prototype.enviarYEsperar = function (comando, datos, comandoRespuesta, timeoutMs) {
    var self = this;
    var promesaRespuesta = new Promise(function (resolve) {
      self._comandoEsperado = comandoRespuesta;
      self._resolverEspera = resolve;
    });
    return this.enviar(comando, datos).then(function () {
      return Promise.race([
        promesaRespuesta,
        new Promise(function (resolve) { setTimeout(function () { resolve(null); }, timeoutMs || 1500); }),
      ]);
    }).then(function (resultado) {
      self._comandoEsperado = null;
      self._resolverEspera = null;
      if (!resultado) registrar('   (sin respuesta a ' + (NOMBRES_CMD[comando] || comando) + ')');
      return resultado;
    });
  };

  // Mismo diseño que el PDF, dibujado sobre un canvas del tamaño exacto
  // en puntos de la impresora (ancho/alto de la etiqueta × 203dpi).
  function dibujarTicketEnCanvas(anchoMm, altoMm, nombreArticulo, hoy, vencimiento) {
    // El ancho se redondea a múltiplo de 8: cada renglón viaja en bytes
    // enteros, y así el ancho anunciado coincide con lo que se manda.
    var cols = Math.round(anchoMm * PUNTOS_POR_MM / 8) * 8;
    var rows = Math.round(altoMm * PUNTOS_POR_MM);
    var canvas = document.createElement('canvas');
    canvas.width = cols;
    canvas.height = rows;
    var ctx = canvas.getContext('2d');
    ctx.fillStyle = '#fff';
    ctx.fillRect(0, 0, cols, rows);
    ctx.textBaseline = 'alphabetic';

    var escala = calcularEscala(anchoMm, altoMm);
    ctx.save();
    ctx.scale(escala * PUNTOS_POR_MM, escala * PUNTOS_POR_MM);
    dibujarTicket(pintorCanvas(ctx), escala, anchoMm / escala, altoMm / escala,
      nombreArticulo, formatearFechaCorta(hoy), formatearFechaCorta(vencimiento));
    ctx.restore();

    return { canvas: canvas, cols: cols, rows: rows };
  }

  function contarBitsEncendidos(byte) {
    var n = 0;
    while (byte) { n += byte & 1; byte >>= 1; }
    return n;
  }

  function bytesIguales(a, b) {
    if (a.length !== b.length) return false;
    for (var i = 0; i < a.length; i++) if (a[i] !== b[i]) return false;
    return true;
  }

  function contarPorTercios(filaBytes, bytesPorTercio) {
    var tercios = [0, 0, 0];
    for (var i = 0; i < filaBytes.length; i++) {
      var t = Math.min(2, Math.floor(i / bytesPorTercio));
      tercios[t] += contarBitsEncendidos(filaBytes[i]);
    }
    return tercios;
  }

  function paqueteAImagenBytes(p, bytesPorTercio) {
    var numeroFila = u16be(p.fila);
    var repeticiones = Math.min(255, p.repeticiones);
    if (p.tipo === 'vacia') {
      return { comando: CMD.PRINT_EMPTY_ROW, datos: new Uint8Array([numeroFila[0], numeroFila[1], repeticiones]) };
    }
    var tercios = contarPorTercios(p.bytes, bytesPorTercio);
    if (p.tipo === 'indexada') {
      var indices = [];
      for (var i = 0; i < p.bytes.length; i++) {
        for (var bit = 0; bit < 8; bit++) {
          if (p.bytes[i] & (0x80 >> bit)) {
            var col = i * 8 + bit;
            indices.push((col >> 8) & 0xff, col & 0xff);
          }
        }
      }
      var cabeza = [numeroFila[0], numeroFila[1], tercios[0], tercios[1], tercios[2], repeticiones];
      return { comando: CMD.PRINT_BITMAP_ROW_INDEXED, datos: new Uint8Array(cabeza.concat(indices)) };
    }
    var cabezaCompleta = [numeroFila[0], numeroFila[1], tercios[0], tercios[1], tercios[2], repeticiones];
    return { comando: CMD.PRINT_BITMAP_ROW, datos: new Uint8Array(cabezaCompleta.concat(Array.prototype.slice.call(p.bytes))) };
  }

  // Convierte el canvas en la lista de paquetes de imagen a mandar: cada
  // renglón se manda "vacío" (en blanco), "indexado" (hasta 6 puntos
  // negros, se mandan solo sus posiciones) o "completo" (el renglón
  // entero en bits) — y los renglones idénticos consecutivos no se
  // repiten, se le suma un contador al paquete anterior. Así arma los
  // renglones el protocolo real, según lo reconstruido en niimbluelib.
  function construirPaquetesImagen(dibujo) {
    var ctx = dibujo.canvas.getContext('2d');
    var cols = dibujo.cols;
    var rows = dibujo.rows;
    var colsBytes = Math.ceil(cols / 8);
    var imagenDatos = ctx.getImageData(0, 0, cols, rows).data;
    var bytesPorTercio = Math.floor(B31_CABEZAL_PUNTOS / 8 / 3);

    var paquetesCrudos = [];
    var filaAnteriorBytes = null;

    for (var fila = 0; fila < rows; fila++) {
      var filaBytes = new Uint8Array(colsBytes);
      var bitsEncendidos = 0;
      for (var col = 0; col < cols; col++) {
        var idx = (fila * cols + col) * 4;
        var luminosidad = (imagenDatos[idx] + imagenDatos[idx + 1] + imagenDatos[idx + 2]) / 3;
        if (luminosidad < 128) {
          filaBytes[col >> 3] |= 0x80 >> (col & 7);
          bitsEncendidos++;
        }
      }

      if (filaAnteriorBytes && bytesIguales(filaAnteriorBytes, filaBytes)) {
        paquetesCrudos[paquetesCrudos.length - 1].repeticiones++;
        continue;
      }
      filaAnteriorBytes = filaBytes;

      var tipo = bitsEncendidos === 0 ? 'vacia' : (bitsEncendidos <= 6 ? 'indexada' : 'completa');
      paquetesCrudos.push({ tipo: tipo, fila: fila, bytes: filaBytes, repeticiones: 1 });
    }

    return paquetesCrudos.map(function (p) { return paqueteAImagenBytes(p, bytesPorTercio); });
  }

  // copias: la impresora las repite sola (va en PRINT_START como total de
  // páginas y en SET_PAGE_SIZE como cantidad), así que la imagen se manda
  // una sola vez.
  function imprimirDirecto(anchoMm, altoMm, nombreArticulo, copias, actualizarEstado) {
    if (!navigator.bluetooth) {
      return Promise.reject(new Error('Este navegador no soporta impresión por Bluetooth — probá con Chrome o Edge en la computadora, o Chrome en Android.'));
    }

    var hoy = new Date();
    var vencimiento = sumarMeses(hoy, 6);
    var dibujo;
    var paquetesImagen;

    // Primero se conecta (el navegador solo deja abrir el selector de
    // Bluetooth justo después del clic) y recién después se espera el
    // logo y se arma la imagen.
    var cliente = new ClienteNiimbot();
    return cliente.conectar(actualizarEstado)
      .then(function () { return logoListo; })
      .then(function () {
        dibujo = dibujarTicketEnCanvas(anchoMm, altoMm, nombreArticulo, hoy, vencimiento);
        paquetesImagen = construirPaquetesImagen(dibujo);
        registrar('Imagen: ' + dibujo.cols + '×' + dibujo.rows + ' puntos, ' + paquetesImagen.length + ' paquetes');
        actualizarEstado('Preparando la impresora...');
        return cliente.enviarYEsperar(CMD.CONNECT, new Uint8Array([0x01]), CMD.IN_CONNECT, 2000);
      })
      .then(function () { return cliente.enviarYEsperar(CMD.SET_DENSITY, new Uint8Array([3]), CMD.IN_SET_DENSITY, 1500); })
      // Tipo de etiqueta "con separación" (gap) — el más común en rollos
      // de stickers precortados; si en algún momento usan un rollo
      // distinto (papel continuo, marca negra), este es el valor a
      // cambiar.
      .then(function () { return cliente.enviarYEsperar(CMD.SET_LABEL_TYPE, new Uint8Array([1]), CMD.IN_SET_LABEL_TYPE, 1500); })
      .then(function () {
        // 7 bytes: cantidad total de páginas (= copias) + 4 bytes en 0 + color de página (0 = un solo color).
        var total = u16be(copias);
        var datosInicio = new Uint8Array([total[0], total[1], 0, 0, 0, 0, 0]);
        return cliente.enviarYEsperar(CMD.PRINT_START, datosInicio, CMD.IN_PRINT_START, 1500);
      })
      .then(function () { return cliente.enviarYEsperar(CMD.PAGE_START, new Uint8Array(0), CMD.IN_PAGE_START, 1500); })
      .then(function () {
        // 6 bytes: alto en renglones + ancho en puntos + cantidad de copias.
        var cantidad = u16be(copias);
        var tamanioPagina = new Uint8Array([
          (dibujo.rows >> 8) & 0xff, dibujo.rows & 0xff,
          (dibujo.cols >> 8) & 0xff, dibujo.cols & 0xff,
          cantidad[0], cantidad[1],
        ]);
        return cliente.enviarYEsperar(CMD.SET_PAGE_SIZE, tamanioPagina, CMD.IN_SET_PAGE_SIZE, 1500);
      })
      .then(function () {
        actualizarEstado('Imprimiendo...');
        // Los renglones de imagen van uno detrás de otro, sin esperar
        // confirmación de cada uno (así lo hace el protocolo real).
        var cadena = Promise.resolve();
        paquetesImagen.forEach(function (paquete) {
          cadena = cadena.then(function () { return cliente.enviar(paquete.comando, paquete.datos, true); });
        });
        return cadena.then(function () { registrar('Imagen enviada'); });
      })
      .then(function () { return cliente.enviarYEsperar(CMD.PAGE_END, new Uint8Array(0), CMD.IN_PAGE_END, 1500); })
      .then(function () {
        // Hay que esperar a que la impresora termine ANTES de mandar
        // PRINT_END: si llega antes, la impresión se cancela y no sale
        // nada. La respuesta de estado trae [página (2 bytes), avance de
        // impresión %, avance de alimentación %, ...] — se da por
        // terminado cuando va por la última copia y los avances llegan a
        // 100. Tope de 20 segundos más 5 por copia, para no trabar el
        // botón para siempre.
        actualizarEstado(copias > 1 ? 'Imprimiendo ' + copias + ' copias...' : 'Esperando que termine de imprimir...');
        var limite = Date.now() + 20000 + copias * 5000;
        function unaVuelta() {
          return cliente.enviarYEsperar(CMD.PRINT_STATUS, new Uint8Array(0), CMD.IN_PRINT_STATUS, 800).then(function (respuesta) {
            if (respuesta && respuesta.length >= 8) {
              var d = respuesta.slice(4);
              var pagina = (d[0] << 8) | d[1];
              var avanceImpresion = d[2];
              var avanceAlimentacion = d[3];
              registrar('   estado: página ' + pagina + ', impresión ' + avanceImpresion + '%, alimentación ' + avanceAlimentacion + '%');
              if (copias > 1) actualizarEstado('Imprimiendo copia ' + Math.min(copias, pagina + 1) + ' de ' + copias + '...');
              if (pagina >= copias && avanceImpresion >= 100 && avanceAlimentacion >= 100) return true;
            }
            if (Date.now() > limite) {
              registrar('   se agotó la espera del estado');
              return false;
            }
            return new Promise(function (r) { setTimeout(r, 300); }).then(unaVuelta);
          });
        }
        return unaVuelta();
      })
      .then(function () { return cliente.enviarYEsperar(CMD.PRINT_END, new Uint8Array(0), CMD.IN_PRINT_END, 1500); })
      .then(function () {
        registrar('Fin');
        actualizarEstado(copias > 1 ? '¡Listo! Se imprimieron ' + copias + ' copias.' : '¡Listo!');
      });
  }

  var botonDirecto = document.getElementById('imprimir-ticket-directo');
  var estadoDirecto = document.getElementById('estado-impresion-directa');
  function imprimirPorBluetooth(copias) {
    var formato = obtenerFormatoSeleccionado();
    estadoDirecto.style.display = 'block';
    estadoDirecto.textContent = 'Iniciando...';
    botonDirecto.disabled = true;
    empezarRegistro();
    registrar('Etiqueta ' + formato.ancho + '×' + formato.alto + ' mm, ' + copias + (copias === 1 ? ' copia' : ' copias'));
    imprimirDirecto(formato.ancho, formato.alto, ARTICULO.nombre, copias, function (msg) {
      estadoDirecto.textContent = msg;
    }).then(function () {
      botonDirecto.disabled = false;
    }).catch(function (err) {
      console.error('[ruta-fria] error imprimiendo por Bluetooth:', err);
      estadoDirecto.textContent = 'No se pudo imprimir: ' + err.message;
      botonDirecto.disabled = false;
    });
  }

  if (botonDirecto) {
    botonDirecto.addEventListener('click', function () {
      pedirCopias('Se imprimen por Bluetooth en la Niimbot, una detrás de otra.', 'Imprimir', imprimirPorBluetooth);
    });
  }
})();
</script>
<% } %>

