<%- include('../partials/head') %>

<div class="toolbar">
  <h1>Horario de seguimiento</h1>
  <a class="btn secondary" href="/vendedores/ubicacion">&larr; Volver a Ubicación</a>
</div>

<p style="color:var(--ink-soft); font-size:.9rem; margin-top:-10px; max-width:640px;">
  Durante las franjas horarias cargadas acá, la app de cada vendedor manda
  su posición sola, con la frecuencia que definas más abajo (así se arma
  el historial de recorrido). Cada día de la semana es independiente: se
  puede cargar más de una franja por día (por ejemplo 9 a 13 y 17 a 22), o
  desmarcar un día entero para que ese día no haga seguimiento. Fuera de
  las franjas cargadas la app no manda nada por su cuenta — "Localizar
  ahora" sigue funcionando a cualquier hora, eso es aparte.
</p>

<% if (guardado) { %>
  <div class="pendiente" style="border-color:#bfe3c6; color:#1e7a34; margin-bottom:16px; padding:12px 20px; max-width:640px;">
    <p style="margin:0;">Horario guardado.</p>
  </div>
<% } %>
<% if (error) { %>
  <div class="pendiente" style="border-color:#e3b8b8; color:#7a2b2b; margin-bottom:16px; padding:12px 20px; max-width:640px;">
    <p style="margin:0;"><%= error %></p>
  </div>
<% } %>

<form method="post" action="/vendedores/ubicacion/horario" style="max-width:640px;">
  <div class="dia-horario" style="margin-bottom:16px;">
    <label for="intervalo_min" style="font-weight:600; font-size:.98rem; color:var(--ink); margin-bottom:8px;">Frecuencia de lectura</label>
    <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
      <span>Cada</span>
      <input type="number" id="intervalo_min" name="intervalo_min" min="<%= intervaloMinMin %>" max="<%= intervaloMinMax %>" step="1" value="<%= intervaloMin %>" style="width:80px;" required>
      <span>minutos, mientras esté dentro de una franja activa.</span>
    </div>
    <p style="color:var(--ink-soft); font-size:.82rem; margin:8px 0 0;">
      Bajar este número muestra el recorrido con más detalle, pero consume
      más batería del celular (cada lectura prende el GPS de nuevo). Entre
      2 y 5 minutos suele ser un buen equilibrio; 1 minuto da el recorrido
      más preciso a costa de la batería.
    </p>
  </div>

  <% dias.forEach((d) => { %>
  <div class="dia-horario" data-dia="<%= d.diaSemana %>" style="margin-bottom:12px;">
    <label class="check-row" style="font-weight:600; font-size:.98rem;">
      <input type="checkbox" class="dia-activo" name="dias[<%= d.diaSemana %>][activo]" <%= d.activo ? 'checked' : '' %>>
      <span><%= d.etiqueta %></span>
    </label>

    <div class="franjas-dia" style="<%= d.activo ? '' : 'display:none;' %> margin-top:10px;">
      <div style="overflow-x:auto;">
      <table>
        <thead>
          <tr><th style="width:35%;">Desde</th><th style="width:35%;">Hasta</th><th></th></tr>
        </thead>
        <tbody class="filas-franjas">
          <% d.franjas.forEach((f, i) => { %>
          <tr>
            <td data-label="Desde"><input type="time" data-campo="inicio" name="dias[<%= d.diaSemana %>][franjas][<%= i %>][inicio]" value="<%= f.inicio %>"></td>
            <td data-label="Hasta"><input type="time" data-campo="fin" name="dias[<%= d.diaSemana %>][franjas][<%= i %>][fin]" value="<%= f.fin %>"></td>
            <td><button type="button" class="btn secondary quitar-franja">Quitar</button></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
      <button type="button" class="btn secondary agregar-franja" style="margin-top:8px;">+ Agregar franja</button>
    </div>
  </div>
  <% }) %>

  <div style="margin-top:6px;">
    <button class="btn" type="submit">Guardar</button>
  </div>
</form>

<script>
(function () {
  // Cada día se maneja por separado (buscando adentro de su propia
  // tarjeta .dia-horario), así agregar/quitar una franja en un día no
  // toca los índices de los demás.
  document.querySelectorAll('.dia-horario').forEach(function (tarjeta) {
    var franjasDiv = tarjeta.querySelector('.franjas-dia');
    var tbody = tarjeta.querySelector('.filas-franjas');
    var checkbox = tarjeta.querySelector('.dia-activo');
    var dia = tarjeta.dataset.dia;

    function reindexar() {
      tbody.querySelectorAll('tr').forEach(function (tr, i) {
        tr.querySelectorAll('[data-campo]').forEach(function (el) {
          el.name = 'dias[' + dia + '][franjas][' + i + '][' + el.dataset.campo + ']';
        });
      });
    }

    function crearFila() {
      var tr = document.createElement('tr');
      tr.innerHTML =
        '<td data-label="Desde"><input type="time" data-campo="inicio"></td>' +
        '<td data-label="Hasta"><input type="time" data-campo="fin"></td>' +
        '<td><button type="button" class="btn secondary quitar-franja">Quitar</button></td>';
      return tr;
    }

    checkbox.addEventListener('change', function () {
      franjasDiv.style.display = checkbox.checked ? '' : 'none';
      // Al activar un día que quedó sin ninguna franja cargada (por
      // ejemplo, se habían quitado todas antes de destildarlo), se le
      // pone una en blanco para que haya algo para completar.
      if (checkbox.checked && tbody.querySelectorAll('tr').length === 0) {
        tbody.appendChild(crearFila());
        reindexar();
      }
    });

    tarjeta.querySelector('.agregar-franja').addEventListener('click', function () {
      tbody.appendChild(crearFila());
      reindexar();
    });

    tbody.addEventListener('click', function (e) {
      if (e.target.classList.contains('quitar-franja')) {
        e.target.closest('tr').remove();
        reindexar();
      }
    });
  });
})();
</script>

<%- include('../partials/foot') %>
