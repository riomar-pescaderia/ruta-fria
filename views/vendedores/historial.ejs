<%- include('../partials/head') %>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">

<div class="toolbar">
  <h1>Recorrido de <%= vendedor.nombre || vendedor.username %></h1>
  <a class="btn secondary" href="/vendedores/ubicacion">&larr; Volver a Ubicación</a>
</div>

<div class="card" style="display:flex; align-items:flex-end; gap:16px; flex-wrap:wrap; margin-bottom:16px;">
  <div style="margin:0;">
    <label for="fecha">Día</label>
    <input type="date" id="fecha" value="<%= fechaInicial %>">
  </div>
  <div style="color:var(--ink-soft); font-size:.9rem; padding-bottom:8px;">
    <span id="resumen">Cargando...</span>
  </div>
</div>

<div id="mapa" style="height:480px; border:1px solid var(--line); border-radius:10px;"></div>

<div class="informe-seccion" style="margin-top:28px;">
  <h2>Histórico</h2>
  <p class="informe-nota">Recorrido día por día del período elegido. Hacé click en una fila para verla en el mapa de arriba.</p>

  <div class="rangos-rapidos" id="rangos-rapidos-historico">
    <% rangosRapidosHistorico.forEach(r => {
         const activo = filtroHistoricoInicial.desde === r.desde && filtroHistoricoInicial.hasta === r.hasta; %>
      <a href="#" class="<%= activo ? 'activo' : '' %>" data-desde="<%= r.desde %>" data-hasta="<%= r.hasta %>"><%= r.etiqueta %></a>
    <% }) %>
  </div>

  <form class="filtros-informe" id="form-historico" style="margin-bottom:16px;">
    <div>
      <label for="historico-desde">Desde</label>
      <input type="date" id="historico-desde" value="<%= filtroHistoricoInicial.desde %>">
    </div>
    <div>
      <label for="historico-hasta">Hasta</label>
      <input type="date" id="historico-hasta" value="<%= filtroHistoricoInicial.hasta %>">
    </div>
    <div>
      <button class="btn" type="submit">Filtrar</button>
    </div>
  </form>

  <div class="kpis">
    <div class="kpi">
      <div class="kpi-etiqueta">Días con recorrido</div>
      <div class="kpi-valor" id="historico-total-dias">—</div>
    </div>
    <div class="kpi">
      <div class="kpi-etiqueta">Distancia total del período</div>
      <div class="kpi-valor" id="historico-total-km">—</div>
    </div>
  </div>

  <div style="overflow-x:auto;">
  <table class="tabla-informe">
    <thead>
      <tr><th>Fecha</th><th>Desde</th><th>Hasta</th><th class="num">Distancia</th></tr>
    </thead>
    <tbody id="historico-tbody">
      <tr><td colspan="4" class="empty">Cargando...</td></tr>
    </tbody>
  </table>
  </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
(function () {
  var USUARIO_ID = <%= vendedor.id %>;
  var CENTRO_DEFECTO = [-27.4512, -58.9867]; // Resistencia, Chaco

  var map = L.map('mapa').setView(CENTRO_DEFECTO, 12);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    maxZoom: 19,
  }).addTo(map);

  var ruta = null;
  var marcadorInicio = null;
  var marcadorFin = null;

  function limpiarMapa() {
    if (ruta) { map.removeLayer(ruta); ruta = null; }
    if (marcadorInicio) { map.removeLayer(marcadorInicio); marcadorInicio = null; }
    if (marcadorFin) { map.removeLayer(marcadorFin); marcadorFin = null; }
  }

  function horaDe(iso) {
    var d = new Date(iso);
    return d.toLocaleTimeString('es-AR', { timeZone: 'America/Argentina/Buenos_Aires', hour: '2-digit', minute: '2-digit' });
  }

  function cargar(fecha) {
    document.getElementById('resumen').textContent = 'Cargando...';
    fetch('/vendedores/ubicacion/' + USUARIO_ID + '/historial/datos?fecha=' + fecha)
      .then(function (r) { return r.json(); })
      .then(function (datos) {
        limpiarMapa();
        var puntos = datos.puntos;
        if (puntos.length === 0) {
          document.getElementById('resumen').textContent = 'No hay recorrido guardado para este día.';
          map.setView(CENTRO_DEFECTO, 12);
          return;
        }
        var latlngs = puntos.map(function (p) { return [p.lat, p.lng]; });
        ruta = L.polyline(latlngs, { color: '#1b5e8a', weight: 4, opacity: 0.85 }).addTo(map);
        marcadorInicio = L.circleMarker(latlngs[0], { radius: 7, color: '#1e7a34', fillColor: '#2ea84a', fillOpacity: 1, weight: 2 })
          .addTo(map).bindPopup('Inicio — ' + horaDe(puntos[0].capturado_en));
        marcadorFin = L.circleMarker(latlngs[latlngs.length - 1], { radius: 7, color: '#b3261e', fillColor: '#e5473b', fillOpacity: 1, weight: 2 })
          .addTo(map).bindPopup('Última posición — ' + horaDe(puntos[puntos.length - 1].capturado_en));
        map.fitBounds(ruta.getBounds(), { padding: [30, 30] });

        var resumen = puntos.length + (puntos.length === 1 ? ' punto' : ' puntos') +
          ' · ' + datos.km.toFixed(1).replace('.', ',') + ' km aprox. (línea recta entre capturas)' +
          ' · de ' + horaDe(puntos[0].capturado_en) + ' a ' + horaDe(puntos[puntos.length - 1].capturado_en);
        document.getElementById('resumen').textContent = resumen;
      })
      .catch(function () {
        document.getElementById('resumen').textContent = 'No se pudo cargar el recorrido.';
      });
  }

  document.getElementById('fecha').addEventListener('change', function () {
    cargar(this.value);
  });

  cargar('<%= fechaInicial %>');

  // --- Histórico: tabla día por día debajo del mapa, con sus propios
  // filtros de rango (independientes del selector de "Día" de arriba,
  // que solo maneja qué se ve en el mapa) ---
  var campoDesde = document.getElementById('historico-desde');
  var campoHasta = document.getElementById('historico-hasta');
  var tbody = document.getElementById('historico-tbody');
  var totalDiasEl = document.getElementById('historico-total-dias');
  var totalKmEl = document.getElementById('historico-total-km');

  function fechaDDMMYYYY(iso) {
    var partes = iso.split('-');
    return partes[2] + '/' + partes[1] + '/' + partes[0];
  }

  function cargarHistorico(desde, hasta) {
    tbody.innerHTML = '<tr><td colspan="4" class="empty">Cargando...</td></tr>';
    totalDiasEl.textContent = '—';
    totalKmEl.textContent = '—';
    fetch('/vendedores/ubicacion/' + USUARIO_ID + '/historial/resumen?desde=' + desde + '&hasta=' + hasta)
      .then(function (r) { return r.json(); })
      .then(function (datos) {
        totalDiasEl.textContent = datos.totalDias;
        totalKmEl.textContent = datos.totalKm.toFixed(1).replace('.', ',') + ' km';
        if (datos.dias.length === 0) {
          tbody.innerHTML = '<tr><td colspan="4" class="empty">No hay recorrido guardado en este período.</td></tr>';
          return;
        }
        tbody.innerHTML = '';
        datos.dias.forEach(function (d) {
          var fila = document.createElement('tr');
          fila.style.cursor = 'pointer';
          fila.title = 'Ver este día en el mapa de arriba';
          fila.innerHTML =
            '<td>' + fechaDDMMYYYY(d.fecha) + '</td>' +
            '<td>' + d.horaInicio + '</td>' +
            '<td>' + d.horaFin + '</td>' +
            '<td class="num mono">' + d.km.toFixed(1).replace('.', ',') + ' km</td>';
          fila.addEventListener('click', function () {
            document.getElementById('fecha').value = d.fecha;
            cargar(d.fecha);
            document.getElementById('mapa').scrollIntoView({ behavior: 'smooth', block: 'center' });
          });
          tbody.appendChild(fila);
        });
      })
      .catch(function () {
        tbody.innerHTML = '<tr><td colspan="4" class="empty">No se pudo cargar el histórico.</td></tr>';
      });
  }

  document.querySelectorAll('#rangos-rapidos-historico a').forEach(function (a) {
    a.addEventListener('click', function (e) {
      e.preventDefault();
      document.querySelectorAll('#rangos-rapidos-historico a').forEach(function (x) { x.classList.remove('activo'); });
      a.classList.add('activo');
      campoDesde.value = a.dataset.desde;
      campoHasta.value = a.dataset.hasta;
      cargarHistorico(a.dataset.desde, a.dataset.hasta);
    });
  });

  document.getElementById('form-historico').addEventListener('submit', function (e) {
    e.preventDefault();
    document.querySelectorAll('#rangos-rapidos-historico a').forEach(function (x) { x.classList.remove('activo'); });
    cargarHistorico(campoDesde.value, campoHasta.value);
  });

  cargarHistorico(campoDesde.value, campoHasta.value);
})();
</script>

<%- include('../partials/foot') %>
