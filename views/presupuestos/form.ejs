<%- include('../partials/head') %>

<h1><%= presupuesto.id ? 'Editar presupuesto' : 'Nuevo presupuesto' %></h1>

<% if (error) { %>
  <div class="pendiente" style="border-color:#e3b8b8; color:#7a2b2b; margin-bottom:16px; padding:14px 20px;">
    <p style="margin:0;"><%= error %></p>
  </div>
<% } %>

<form class="card" method="post" action="<%= accion %>" style="max-width:900px;">
  <% const clienteSel = presupuesto.cliente_id ? clientes.find(c => String(c.id) === String(presupuesto.cliente_id)) : null; %>
  <div style="display:flex; gap:12px; flex-wrap:wrap;">
    <div style="flex:2; min-width:240px;">
      <label for="cliente_buscar">Cliente</label>
      <input type="text" id="cliente_buscar" name="cliente_texto" placeholder="Buscar por razón social, CUIT/DNI... o escribir uno nuevo" autocomplete="off" value="<%= clienteSel ? clienteSel.razon_social : (presupuesto.cliente_texto || '') %>" required>
      <input type="hidden" id="cliente_id" name="cliente_id" value="<%= presupuesto.cliente_id || '' %>">
      <p style="color:var(--ink-soft); font-size:.8rem; margin:6px 0 0;">Si el cliente todavía no está agendado, escribí el nombre igual y guardá el presupuesto — se crea solo con ese nombre.</p>
    </div>
    <div style="flex:1; min-width:150px;">
      <label for="fecha">Fecha y hora</label>
      <input type="datetime-local" id="fecha" name="fecha" value="<%= presupuesto.fecha || '' %>">
    </div>
  </div>

  <div style="display:flex; gap:12px; flex-wrap:wrap;">
    <div style="flex:1; min-width:220px;">
      <label for="forma_pago">Forma de pago</label>
      <select id="forma_pago" name="forma_pago" required>
        <option value="">— elegir —</option>
        <option value="efectivo" <%= presupuesto.forma_pago === 'efectivo' ? 'selected' : '' %>>Efectivo</option>
        <option value="transferencia" <%= presupuesto.forma_pago === 'transferencia' ? 'selected' : '' %>>Transferencia</option>
        <option value="cuenta_corriente" <%= presupuesto.forma_pago === 'cuenta_corriente' ? 'selected' : '' %>>Cuenta corriente</option>
      </select>
      <p style="color:var(--ink-soft); font-size:.8rem; margin:6px 0 0;">Define qué precio se sugiere al elegir cada artículo: efectivo sugiere el precio en efectivo, transferencia y cuenta corriente sugieren el precio de lista.</p>
    </div>
  </div>

  <% const mapaArticulos = {}; articulos.forEach(a => { mapaArticulos[a.id] = a; }); %>
  <div style="overflow-x:auto;">
  <table id="tabla-items">
    <thead>
      <tr>
        <th style="width:90px;">Código</th>
        <th style="min-width:220px;">Artículo</th>
        <th style="width:100px;">Cantidad</th>
        <th style="width:130px;">Precio unit.</th>
        <th style="width:110px;">Subtotal</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="filas-items">
      <% items.forEach((it, i) => {
           const artSel = it.articulo_id ? mapaArticulos[it.articulo_id] : null;
           const articuloValor = artSel ? (artSel.codigo + ' — ' + artSel.nombre) : ''; %>
      <tr>
        <td data-label="Código">
          <input class="f-codigo" type="text" placeholder="Código" autocomplete="off" value="<%= artSel ? artSel.codigo : '' %>">
        </td>
        <td data-label="Artículo">
          <input class="f-articulo-buscar" type="text" placeholder="Buscar por nombre o código" autocomplete="off" value="<%= articuloValor %>">
          <input type="hidden" class="f-articulo-id" data-campo="articulo_id" name="items[<%= i %>][articulo_id]" value="<%= it.articulo_id || '' %>">
        </td>
        <td data-label="Cantidad">
          <input class="f-cantidad" data-campo="cantidad" type="number" step="0.01" min="0" name="items[<%= i %>][cantidad]" value="<%= it.cantidad || '' %>" required>
          <small class="f-aviso-stock" style="display:none; color:#a33; font-weight:600;"></small>
        </td>
        <td data-label="Precio unit.">
          <input class="f-precio" data-campo="precio_unitario" type="number" step="0.01" min="0" name="items[<%= i %>][precio_unitario]" value="<%= it.precio_unitario || '' %>" required>
        </td>
        <td data-label="Subtotal" class="mono">$<span class="f-subtotal"><%= it.subtotal ? Number(it.subtotal).toFixed(2) : '0.00' %></span></td>
        <td><button type="button" class="btn secondary quitar-fila">Quitar</button></td>
      </tr>
      <% }) %>
    </tbody>
    <tfoot>
      <tr>
        <td colspan="4" style="text-align:right; font-weight:600; border-bottom:none;">Total</td>
        <td class="mono" id="total-presupuesto" style="border-bottom:none; font-weight:600;">$0.00</td>
        <td style="border-bottom:none;"></td>
      </tr>
    </tfoot>
  </table>
  </div>
  <p style="color:var(--ink-soft); font-size:.85rem; margin-top:-8px;">
    Al elegir un artículo (o cambiarlo por otro) se completa su precio según la forma de pago elegida arriba, y cambiar la forma de pago actualiza el precio de todos los renglones ya cargados. Se puede pisar el precio a mano en cualquier renglón después de elegir el artículo.
  </p>

  <div>
    <button type="button" id="agregar-fila" class="btn secondary">+ Agregar artículo</button>
  </div>

  <div>
    <label for="notas">Notas</label>
    <textarea id="notas" name="notas" rows="2"><%= presupuesto.notas || '' %></textarea>
  </div>

  <div>
    <button class="btn" type="submit">Guardar presupuesto</button>
    <a class="btn secondary" href="/ventas/presupuestos">Cancelar</a>
  </div>
</form>

<script>
(function () {
  var tbody = document.getElementById('filas-items');
  var formaPagoSelect = document.getElementById('forma_pago');

  // Datos de artículos para el buscador de la columna "Artículo" y para
  // sugerir el precio según la forma de pago vigente en el momento en que
  // se elige cada uno — mismo patrón que en Ventas.
  var ARTICULOS = <%- JSON.stringify(articulos.map(a => ({ id: String(a.id), codigo: a.codigo, nombre: a.nombre, precioEfectivo: a.precioEfectivo, precioLista: a.precioLista, stock: (a.stock === null || a.stock === undefined) ? null : Number(a.stock) }))) %>;
  var articulosPorId = {};
  ARTICULOS.forEach(function (a) { articulosPorId[a.id] = a; });

  function etiquetaArticulo(a) { return a.codigo + ' — ' + a.nombre; }

  function buscarArticulos(texto) {
    var t = texto.trim().toLowerCase();
    if (!t) return ARTICULOS;
    return ARTICULOS.filter(function (a) {
      return a.codigo.toLowerCase().indexOf(t) !== -1 || a.nombre.toLowerCase().indexOf(t) !== -1;
    });
  }

  var buscador = document.createElement('div');
  buscador.className = 'buscador-flotante';
  buscador.style.display = 'none';
  document.body.appendChild(buscador);
  var filaActiva = null;

  function ocultarBuscador() {
    buscador.style.display = 'none';
    buscador.innerHTML = '';
    filaActiva = null;
  }

  function precioSugerido(articulo) {
    return formaPagoSelect.value === 'efectivo' ? articulo.precioEfectivo : articulo.precioLista;
  }

  function fijarArticuloEnFila(tr, articulo) {
    tr.querySelector('.f-articulo-id').value = articulo ? articulo.id : '';
    tr.querySelector('.f-articulo-buscar').value = articulo ? etiquetaArticulo(articulo) : '';
    if (articulo) tr.querySelector('.f-codigo').value = articulo.codigo;
    var precioInput = tr.querySelector('.f-precio');
    if (articulo) {
      precioInput.value = precioSugerido(articulo);
    }
    actualizarTotales();
  }

  function mostrarBuscador(tr, coincidencias) {
    filaActiva = tr;
    buscador.innerHTML = '';
    if (coincidencias.length === 0) {
      var vacio = document.createElement('div');
      vacio.style.cssText = 'padding:8px 12px; font-size:.85rem; color:var(--ink-soft);';
      vacio.textContent = 'Sin resultados.';
      buscador.appendChild(vacio);
    } else {
      coincidencias.slice(0, 30).forEach(function (a) {
        var boton = document.createElement('button');
        boton.type = 'button';
        boton.textContent = etiquetaArticulo(a);
        boton.addEventListener('mousedown', function (e) {
          e.preventDefault();
          fijarArticuloEnFila(tr, a);
          ocultarBuscador();
        });
        buscador.appendChild(boton);
      });
    }
    var input = tr.querySelector('.f-articulo-buscar');
    var rect = input.getBoundingClientRect();
    buscador.style.left = rect.left + 'px';
    buscador.style.top = rect.bottom + 'px';
    buscador.style.width = Math.max(rect.width, 240) + 'px';
    buscador.style.display = 'block';
  }

  // Igual que en Ventas: si hay stock cargado para el artículo y la
  // cantidad tipeada lo supera, se avisa cuánto queda — pero acá NO se
  // bloquea guardar ni generar el presupuesto, es solo informativo.
  function actualizarAvisoStock(tr) {
    var aviso = tr.querySelector('.f-aviso-stock');
    var articulo = articulosPorId[tr.querySelector('.f-articulo-id').value];
    var cantidad = parseFloat(tr.querySelector('.f-cantidad').value) || 0;
    var excede = !!(articulo && articulo.stock !== null && cantidad > articulo.stock);
    if (excede) {
      aviso.textContent = 'Quedan ' + articulo.stock + ' en stock.';
      aviso.style.display = 'block';
    } else {
      aviso.textContent = '';
      aviso.style.display = 'none';
    }
  }

  function actualizarTotales() {
    var total = 0;
    tbody.querySelectorAll('tr').forEach(function (tr) {
      var cantidad = parseFloat(tr.querySelector('.f-cantidad').value) || 0;
      var precio = parseFloat(tr.querySelector('.f-precio').value) || 0;
      var subtotal = cantidad * precio;
      tr.querySelector('.f-subtotal').textContent = subtotal.toFixed(2);
      total += subtotal;
      actualizarAvisoStock(tr);
    });
    document.getElementById('total-presupuesto').textContent = '$' + total.toFixed(2);
  }

  function reindexar() {
    tbody.querySelectorAll('tr').forEach(function (tr, i) {
      tr.querySelectorAll('[data-campo]').forEach(function (el) {
        el.name = 'items[' + i + '][' + el.dataset.campo + ']';
      });
    });
  }

  document.getElementById('agregar-fila').addEventListener('click', function () {
    var filas = tbody.querySelectorAll('tr');
    var nueva = filas[filas.length - 1].cloneNode(true);
    nueva.querySelectorAll('input[type=number]').forEach(function (el) { el.value = ''; });
    nueva.querySelector('.f-codigo').value = '';
    nueva.querySelector('.f-articulo-buscar').value = '';
    nueva.querySelector('.f-articulo-id').value = '';
    nueva.querySelector('.f-subtotal').textContent = '0.00';
    var avisoNueva = nueva.querySelector('.f-aviso-stock');
    avisoNueva.textContent = '';
    avisoNueva.style.display = 'none';
    tbody.appendChild(nueva);
    reindexar();
  });

  tbody.addEventListener('click', function (e) {
    if (e.target.classList.contains('quitar-fila')) {
      if (tbody.querySelectorAll('tr').length > 1) {
        e.target.closest('tr').remove();
        reindexar();
        actualizarTotales();
      }
    }
  });

  tbody.addEventListener('input', function (e) {
    actualizarTotales();
    if (e.target.classList.contains('f-articulo-buscar')) {
      var tr = e.target.closest('tr');
      var actual = articulosPorId[tr.querySelector('.f-articulo-id').value];
      if (!actual || etiquetaArticulo(actual) !== e.target.value) {
        tr.querySelector('.f-articulo-id').value = '';
      }
      mostrarBuscador(tr, buscarArticulos(e.target.value));
    } else if (e.target.classList.contains('f-codigo')) {
      var tr2 = e.target.closest('tr');
      var codigoTexto = e.target.value.trim().toLowerCase();
      var encontrado = codigoTexto && ARTICULOS.find(function (a) { return a.codigo.toLowerCase() === codigoTexto; });
      if (encontrado) {
        fijarArticuloEnFila(tr2, encontrado);
      } else if (tr2.querySelector('.f-articulo-id').value) {
        tr2.querySelector('.f-articulo-id').value = '';
        tr2.querySelector('.f-articulo-buscar').value = '';
      }
    }
  });

  tbody.addEventListener('focus', function (e) {
    if (e.target.classList.contains('f-articulo-buscar')) {
      mostrarBuscador(e.target.closest('tr'), buscarArticulos(e.target.value));
    }
  }, true);
  tbody.addEventListener('blur', function (e) {
    if (e.target.classList.contains('f-articulo-buscar')) {
      var trBlur = e.target.closest('tr');
      setTimeout(function () {
        if (filaActiva === trBlur) ocultarBuscador();
      }, 150);
    }
  }, true);
  window.addEventListener('scroll', function () { if (filaActiva) ocultarBuscador(); }, true);
  window.addEventListener('resize', ocultarBuscador);

  formaPagoSelect.addEventListener('change', function () {
    tbody.querySelectorAll('tr').forEach(function (tr) {
      var articulo = articulosPorId[tr.querySelector('.f-articulo-id').value];
      if (articulo) tr.querySelector('.f-precio').value = precioSugerido(articulo);
    });
    actualizarTotales();
  });

  // Buscador del cliente — mismo patrón que el de artículo.
  var CLIENTES = <%- JSON.stringify(clientes.map(c => ({ id: String(c.id), razon_social: c.razon_social, cuit_dni: c.cuit_dni || '' }))) %>;
  var clienteBuscarInput = document.getElementById('cliente_buscar');
  var clienteIdInput = document.getElementById('cliente_id');
  var clienteBuscador = document.createElement('div');
  clienteBuscador.className = 'buscador-flotante';
  clienteBuscador.style.display = 'none';
  document.body.appendChild(clienteBuscador);
  var clienteBuscadorActivo = false;

  function etiquetaCliente(c) {
    return c.razon_social + (c.cuit_dni ? ' (' + c.cuit_dni + ')' : '');
  }

  function buscarClientes(texto) {
    var t = texto.trim().toLowerCase();
    if (!t) return CLIENTES;
    return CLIENTES.filter(function (c) {
      return c.razon_social.toLowerCase().indexOf(t) !== -1 || c.cuit_dni.toLowerCase().indexOf(t) !== -1;
    });
  }

  function ocultarClienteBuscador() {
    clienteBuscador.style.display = 'none';
    clienteBuscador.innerHTML = '';
    clienteBuscadorActivo = false;
  }

  function fijarCliente(c) {
    clienteIdInput.value = c ? c.id : '';
    clienteBuscarInput.value = c ? etiquetaCliente(c) : '';
  }

  function mostrarClienteBuscador(coincidencias) {
    clienteBuscadorActivo = true;
    clienteBuscador.innerHTML = '';
    if (coincidencias.length === 0) {
      var vacio = document.createElement('div');
      vacio.style.cssText = 'padding:8px 12px; font-size:.85rem; color:var(--ink-soft);';
      vacio.textContent = 'Sin resultados.';
      clienteBuscador.appendChild(vacio);
    } else {
      coincidencias.slice(0, 30).forEach(function (c) {
        var boton = document.createElement('button');
        boton.type = 'button';
        boton.textContent = etiquetaCliente(c);
        boton.addEventListener('mousedown', function (e) {
          e.preventDefault();
          fijarCliente(c);
          ocultarClienteBuscador();
        });
        clienteBuscador.appendChild(boton);
      });
    }
    var rect = clienteBuscarInput.getBoundingClientRect();
    clienteBuscador.style.left = rect.left + 'px';
    clienteBuscador.style.top = rect.bottom + 'px';
    clienteBuscador.style.width = Math.max(rect.width, 240) + 'px';
    clienteBuscador.style.display = 'block';
  }

  clienteBuscarInput.addEventListener('focus', function () {
    mostrarClienteBuscador(buscarClientes(clienteBuscarInput.value));
  });
  clienteBuscarInput.addEventListener('input', function () {
    var actual = CLIENTES.find(function (c) { return c.id === clienteIdInput.value; });
    if (!actual || etiquetaCliente(actual) !== clienteBuscarInput.value) {
      clienteIdInput.value = '';
    }
    mostrarClienteBuscador(buscarClientes(clienteBuscarInput.value));
  });
  clienteBuscarInput.addEventListener('blur', function () {
    setTimeout(function () { if (clienteBuscadorActivo) ocultarClienteBuscador(); }, 150);
  });
  window.addEventListener('scroll', function () { if (clienteBuscadorActivo) ocultarClienteBuscador(); }, true);
  window.addEventListener('resize', ocultarClienteBuscador);

  actualizarTotales();
})();
</script>

<%- include('../partials/foot') %>
