<%- include('../partials/head') %>

<div class="toolbar">
  <h1>Clientes</h1>
  <a class="btn" href="/clientes/nuevo">+ Nuevo cliente</a>
</div>

<% if (clientes.length === 0) { %>
  <p class="empty">Todavía no cargaste ningún cliente.</p>
<% } else { %>
<table>
  <thead>
    <tr>
      <th>Razón social</th>
      <th>Contacto</th>
      <th>Teléfono</th>
      <th>Condición IVA</th>
      <th>Condición de pago</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% clientes.forEach(c => { %>
    <tr>
      <td data-label="Razón social"><%= c.razon_social %></td>
      <td data-label="Contacto"><%= c.nombre_contacto || '—' %></td>
      <td data-label="Teléfono" class="mono"><%= c.telefono || '—' %></td>
      <td data-label="Condición IVA"><%= c.condicion_iva || '—' %></td>
      <td data-label="Condición de pago"><%= c.condicion_pago || '—' %></td>
      <td data-label=""><a class="btn secondary" href="/clientes/<%= c.id %>/editar">Editar</a></td>
    </tr>
    <% }) %>
  </tbody>
</table>
<% } %>

<%- include('../partials/foot') %>
