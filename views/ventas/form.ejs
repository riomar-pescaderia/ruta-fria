<%- include('../partials/head') %>

<h1><%= venta.id ? 'Editar venta' : 'Nueva venta' %></h1>

<% if (error) { %>
  <div class="pendiente" style="border-color:#e3b8b8; color:#7a2b2b; margin-bottom:16px; padding:14px 20px;">
    <p style="margin:0;"><%= error %></p>
  </div>
<% } %>

<form id="form-venta" class="card" method="post" action="<%= accion %>" style="max-width:900px;">
  <% const clienteSel = venta.cliente_id ? clientes.find(c => String(c.id) === String(venta.cliente_id)) : null; %>
  <div style="display:flex; gap:12px; flex-wrap:wrap;">
    <div style="flex:2; min-width:240px;">
      <label for="cliente_buscar">Cliente</label>
      <input type="text" id="cliente_buscar" name="cliente_texto" placeholder="Buscar por razón social, CUIT/DNI... o escribir uno nuevo" autocomplete="off" value="<%= clienteSel ? clienteSel.razon_social : (venta.cliente_texto || '') %>" required>
      <input type="hidden" id="cliente_id" name="cliente_id" value="<%= venta.cliente_id || '' %>">
      <p style="color:var(--ink-soft); font-size:.8rem; margin:6px 0 0;">Si el cliente todavía no está agendado, escribí el nombre igual y guardá la venta — se crea solo con ese nombre, y después podés completar el resto de sus datos desde el detalle de la venta.</p>
    </div>
    <div style="flex:1; min-width:150px;">
      <label for="fecha">Fecha y hora</label>
      <input type="datetime-local" id="fecha" name="fecha" value="<%= venta.fecha || '' %>">
    </div>
  </div>

  <div style="display:flex; gap:12px; flex-wrap:wrap;">
    <div style="flex:1; min-width:260px;">
      <label for="forma_pago">Forma de pago</label>
      <select id="forma_pago" name="forma_pago" required>
        <option value="">— elegir —</option>
        <option value="efectivo" <%= venta.forma_pago === 'efectivo' ? 'selected' : '' %>>Efectivo</option>
        <option value="transferencia" <%= venta.forma_pago === 'transferencia' ? 'selected' : '' %>>Transferencia</option>
        <option value="cuenta_corriente" <%= venta.forma_pago === 'cuenta_corriente' ? 'selected' : '' %>>Cuenta corriente</option>
      </select>
      <p style="color:var(--ink-soft); font-size:.8rem; margin:6px 0 0;">Define qué precio se sugiere al elegir cada artículo: efectivo sugiere el precio en efectivo, transferencia y cuenta corriente sugieren el precio de lista.</p>

      <% /* Por defecto la venta se cobra con un solo medio — el elegido
            arriba, por el total — y esta parte queda escondida (ver el JS
            más abajo): no hace falta tocar nada. Recién al tocar "+
            Agregar medio de pago" aparecen las filas con su casilla de
            monto, para repartir el cobro entre dos o más medios (por
            ejemplo, una parte en efectivo y el resto por transferencia, o
            el resto a cuenta corriente) — la suma tiene que coincidir con
            el total para poder guardar. */ %>
      <div id="filas-medios" style="margin-top:10px;">
        <% medios.forEach((m, i) => { %>
        <div class="fila-medio-pago" style="display:<%= medios.length <= 1 ? 'none' : 'flex' %>; gap:8px; align-items:center; margin-bottom:8px; flex-wrap:wrap;">
          <select class="f-medio" data-campo="medio_pago" name="medios[<%= i %>][medio_pago]" style="flex:1; min-width:140px;">
            <option value="efectivo" <%= m.medio_pago === 'efectivo' ? 'selected' : '' %>>Efectivo</option>
            <option value="transferencia" <%= m.medio_pago === 'transferencia' ? 'selected' : '' %>>Transferencia</option>
            <option value="cuenta_corriente" <%= m.medio_pago === 'cuenta_corriente' ? 'selected' : '' %>>Cuenta corriente</option>
          </select>
          <input class="f-monto-medio" data-campo="monto" type="number" step="0.01" min="0" name="medios[<%= i %>][monto]" value="<%= m.monto || '' %>" placeholder="Monto" style="flex:1; min-width:110px;">
          <button type="button" class="btn secondary quitar-medio">Quitar</button>
        </div>
        <% }) %>
      </div>
      <button type="button" id="agregar-medio" class="btn secondary">+ Agregar medio de pago</button>
      <p id="medios-estado" style="margin:8px 0 0; font-size:.85rem; font-weight:600;"></p>
    </div>
    <div style="flex:1; min-width:200px;">
      <label for="vendedor_id">Vendedor</label>
      <select id="vendedor_id" name="vendedor_id">
        <option value="">— sin especificar —</option>
        <% usuarios.forEach(u => { %>
        <option value="<%= u.id %>" <%= String(venta.vendedor_id || '') === String(u.id) ? 'selected' : '' %>><%= u.nombre || u.username %></option>
        <% }) %>
      </select>
      <p style="color:var(--ink-soft); font-size:.8rem; margin:6px 0 0;">Quién cargó o realizó la venta.</p>
    </div>
  </div>

  <% const mapaArticulos = {}; articulos.forEach(a => { mapaArticulos[a.id] = a; }); %>
  <div style="overflow-x:auto;">
  <table id="tabla-items">
    <thead>
      <tr>
        <th style="width:90px;">Código</th>
        <th style="min-width:220px;">Artículo</th>
        <th style="width:100px;">Cantidad</th>
        <th style="width:130px;">Precio unit.</th>
        <th style="width:110px;">Subtotal</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="filas-items">
      <% items.forEach((it, i) => {
           const artSel = it.articulo_id ? mapaArticulos[it.articulo_id] : null;
           const articuloValor = artSel ? (artSel.codigo + ' — ' + artSel.nombre) : ''; %>
      <tr>
        <td data-label="Código">
          <input class="f-codigo" type="text" placeholder="Código" autocomplete="off" value="<%= artSel ? artSel.codigo : '' %>">
        </td>
        <td data-label="Artículo">
          <input class="f-articulo-buscar" type="text" placeholder="Buscar por nombre o código" autocomplete="off" value="<%= articuloValor %>">
          <input type="hidden" class="f-articulo-id" data-campo="articulo_id" name="items[<%= i %>][articulo_id]" value="<%= it.articulo_id || '' %>">
        </td>
        <td data-label="Cantidad">
          <input class="f-cantidad" data-campo="cantidad" type="number" step="0.01" min="0" name="items[<%= i %>][cantidad]" value="<%= it.cantidad || '' %>" required>
          <small class="f-aviso-stock" style="display:none; color:#a33; font-weight:600;"></small>
        </td>
        <td data-label="Precio unit.">
          <input class="f-precio" data-campo="precio_unitario" type="number" step="0.01" min="0" name="items[<%= i %>][precio_unitario]" value="<%= it.precio_unitario || '' %>" required>
        </td>
        <td data-label="Subtotal" class="mono">$<span class="f-subtotal"><%= it.subtotal ? Number(it.subtotal).toFixed(2) : '0.00' %></span></td>
        <td><button type="button" class="btn secondary quitar-fila">Quitar</button></td>
      </tr>
      <% }) %>
    </tbody>
    <tfoot>
      <tr>
        <td colspan="4" style="text-align:right; font-weight:600; border-bottom:none;">Total</td>
        <td class="mono" id="total-venta" style="border-bottom:none; font-weight:600;">$0.00</td>
        <td style="border-bottom:none;"></td>
      </tr>
    </tfoot>
  </table>
  </div>
  <p style="color:var(--ink-soft); font-size:.85rem; margin-top:-8px;">
    Al elegir un artículo (o cambiarlo por otro) se completa su precio según la forma de pago elegida arriba, y cambiar la forma de pago actualiza el precio de todos los renglones ya cargados. Se puede pisar el precio a mano en cualquier renglón después de elegir el artículo — ese cambio se mantiene hasta que se vuelva a elegir un artículo en esa fila o se cambie la forma de pago.
  </p>

  <div>
    <button type="button" id="agregar-fila" class="btn secondary">+ Agregar artículo</button>
  </div>

  <div>
    <label for="notas">Notas</label>
    <textarea id="notas" name="notas" rows="2"><%= venta.notas || '' %></textarea>
  </div>

  <div>
    <button class="btn" type="submit">Guardar venta</button>
    <a class="btn secondary" href="/ventas">Cancelar</a>
  </div>
</form>

<script>
(function () {
  var tbody = document.getElementById('filas-items');
  var formaPagoSelect = document.getElementById('forma_pago');

  // --- Medios de pago: uno o más, con su monto, que tienen que sumar el
  // total de la venta (ver más abajo, junto a actualizarTotales) ---
  var filasMedios = document.getElementById('filas-medios');
  var btnAgregarMedio = document.getElementById('agregar-medio');
  var mediosEstado = document.getElementById('medios-estado');

  function totalVentaNumero() {
    var texto = document.getElementById('total-venta').textContent.replace('$', '');
    return parseFloat(texto) || 0;
  }

  function reindexarMedios() {
    filasMedios.querySelectorAll('.fila-medio-pago').forEach(function (fila, i) {
      fila.querySelectorAll('[data-campo]').forEach(function (el) {
        el.name = 'medios[' + i + '][' + el.dataset.campo + ']';
      });
    });
  }

  // Mientras haya un solo medio de pago, la fila queda escondida y se
  // mantiene sincronizada sola con la forma de pago y el total de
  // arriba — no hace falta ni elegirlo ni escribir el monto a mano, ya
  // que los dos tienen que ser necesariamente los mismos. Recién al
  // agregar un segundo medio para repartir el cobro se muestran todas
  // las filas con sus casillas, y ahí sí hay que completar cada monto a
  // mano (acá deja de tocarlos).
  function actualizarEstadoMedios() {
    var filas = filasMedios.querySelectorAll('.fila-medio-pago');
    var total = totalVentaNumero();
    var soloUnMedio = filas.length <= 1;

    filas.forEach(function (fila) { fila.style.display = soloUnMedio ? 'none' : 'flex'; });

    if (soloUnMedio) {
      if (filas.length === 1) {
        filas[0].querySelector('.f-medio').value = formaPagoSelect.value;
        filas[0].querySelector('.f-monto-medio').value = total ? total.toFixed(2) : '';
      }
      mediosEstado.style.display = 'none';
      return;
    }

    mediosEstado.style.display = 'block';
    var suma = 0;
    filas.forEach(function (fila) {
      suma += parseFloat(fila.querySelector('.f-monto-medio').value) || 0;
    });
    var diferencia = Math.round((total - suma) * 100) / 100;
    if (Math.abs(diferencia) < 0.005) {
      mediosEstado.textContent = 'Los medios de pago cubren el total. ✓';
      mediosEstado.style.color = '#1e7a34';
    } else if (diferencia > 0) {
      mediosEstado.textContent = 'Falta cubrir $' + diferencia.toFixed(2) + ' del total.';
      mediosEstado.style.color = '#a33';
    } else {
      mediosEstado.textContent = 'Te pasaste por $' + Math.abs(diferencia).toFixed(2) + ' del total.';
      mediosEstado.style.color = '#a33';
    }
  }

  btnAgregarMedio.addEventListener('click', function () {
    var filas = filasMedios.querySelectorAll('.fila-medio-pago');
    if (filas.length === 1) {
      // Al pasar de uno a dos medios, el primero arranca con el total
      // entero cargado (así la suma ya da bien apenas se agrega el
      // segundo) — de ahí en más se reparte a mano entre los dos.
      filas[0].querySelector('.f-monto-medio').value = totalVentaNumero().toFixed(2);
    }
    var nueva = filas[filas.length - 1].cloneNode(true);
    nueva.querySelector('.f-monto-medio').value = '';
    filasMedios.appendChild(nueva);
    reindexarMedios();
    actualizarEstadoMedios();
  });

  filasMedios.addEventListener('click', function (e) {
    if (e.target.classList.contains('quitar-medio')) {
      if (filasMedios.querySelectorAll('.fila-medio-pago').length > 1) {
        e.target.closest('.fila-medio-pago').remove();
        reindexarMedios();
        actualizarEstadoMedios();
      }
    }
  });

  filasMedios.addEventListener('input', actualizarEstadoMedios);
  filasMedios.addEventListener('change', actualizarEstadoMedios);

  // Datos de artículos para el buscador de la columna "Artículo" y para
  // sugerir el precio según la forma de pago vigente en el momento en que
  // se elige cada uno.
  var ARTICULOS = <%- JSON.stringify(articulos.map(a => ({ id: String(a.id), codigo: a.codigo, nombre: a.nombre, precioEfectivo: a.precioEfectivo, precioLista: a.precioLista, stock: (a.stock === null || a.stock === undefined) ? null : Number(a.stock) }))) %>;
  var articulosPorId = {};
  ARTICULOS.forEach(function (a) { articulosPorId[a.id] = a; });

  function etiquetaArticulo(a) { return a.codigo + ' — ' + a.nombre; }

  function buscarArticulos(texto) {
    var t = texto.trim().toLowerCase();
    if (!t) return ARTICULOS;
    return ARTICULOS.filter(function (a) {
      return a.codigo.toLowerCase().indexOf(t) !== -1 || a.nombre.toLowerCase().indexOf(t) !== -1;
    });
  }

  // Un único panel flotante, reutilizado para la fila que esté activa en
  // cada momento — mismo patrón que en Compras.
  var buscador = document.createElement('div');
  buscador.className = 'buscador-flotante';
  buscador.style.display = 'none';
  document.body.appendChild(buscador);
  var filaActiva = null;

  function ocultarBuscador() {
    buscador.style.display = 'none';
    buscador.innerHTML = '';
    filaActiva = null;
  }

  function precioSugerido(articulo) {
    return formaPagoSelect.value === 'efectivo' ? articulo.precioEfectivo : articulo.precioLista;
  }

  function fijarArticuloEnFila(tr, articulo) {
    tr.querySelector('.f-articulo-id').value = articulo ? articulo.id : '';
    tr.querySelector('.f-articulo-buscar').value = articulo ? etiquetaArticulo(articulo) : '';
    if (articulo) tr.querySelector('.f-codigo').value = articulo.codigo;
    var precioInput = tr.querySelector('.f-precio');
    // Siempre se completa con el precio sugerido del artículo actual y la
    // forma de pago vigente — tanto la primera vez que se elige un
    // artículo en la fila como cuando se lo cambia por otro (antes, si la
    // fila ya tenía un precio cargado, se dejaba el precio del artículo
    // viejo sin actualizar). Si se quiere un precio distinto, se pisa a
    // mano DESPUÉS de elegir el artículo — ese cambio se mantiene hasta
    // que se vuelva a elegir un artículo en esa fila o cambie la forma de
    // pago (ver el listener de "forma_pago" más abajo).
    if (articulo) {
      precioInput.value = precioSugerido(articulo);
    }
    actualizarTotales();
  }

  function mostrarBuscador(tr, coincidencias) {
    filaActiva = tr;
    buscador.innerHTML = '';
    if (coincidencias.length === 0) {
      var vacio = document.createElement('div');
      vacio.style.cssText = 'padding:8px 12px; font-size:.85rem; color:var(--ink-soft);';
      vacio.textContent = 'Sin resultados.';
      buscador.appendChild(vacio);
    } else {
      coincidencias.slice(0, 30).forEach(function (a) {
        var boton = document.createElement('button');
        boton.type = 'button';
        boton.textContent = etiquetaArticulo(a);
        // "mousedown" (no "click") para que se ejecute antes de que el
        // input pierda el foco y el buscador se cierre solo.
        boton.addEventListener('mousedown', function (e) {
          e.preventDefault();
          fijarArticuloEnFila(tr, a);
          ocultarBuscador();
        });
        buscador.appendChild(boton);
      });
    }
    var input = tr.querySelector('.f-articulo-buscar');
    var rect = input.getBoundingClientRect();
    buscador.style.left = rect.left + 'px';
    buscador.style.top = rect.bottom + 'px';
    buscador.style.width = Math.max(rect.width, 240) + 'px';
    buscador.style.display = 'block';
  }

  // Si el artículo elegido en la fila tiene stock cargado (no null, o
  // sea que ya se sincronizó/tocó en el apartado Stock) y la cantidad
  // tipeada lo supera, se avisa cuánto queda — en Ventas esto además
  // bloquea guardar (ver el listener de "submit" más abajo); en
  // Presupuestos (mismo patrón, en su form.ejs) solo avisa.
  function actualizarAvisoStock(tr) {
    var aviso = tr.querySelector('.f-aviso-stock');
    var articulo = articulosPorId[tr.querySelector('.f-articulo-id').value];
    var cantidad = parseFloat(tr.querySelector('.f-cantidad').value) || 0;
    var excede = !!(articulo && articulo.stock !== null && cantidad > articulo.stock);
    if (excede) {
      aviso.textContent = 'Quedan ' + articulo.stock + ' en stock.';
      aviso.style.display = 'block';
    } else {
      aviso.textContent = '';
      aviso.style.display = 'none';
    }
    tr.dataset.excedeStock = excede ? '1' : '';
  }

  function actualizarTotales() {
    var total = 0;
    tbody.querySelectorAll('tr').forEach(function (tr) {
      var cantidad = parseFloat(tr.querySelector('.f-cantidad').value) || 0;
      var precio = parseFloat(tr.querySelector('.f-precio').value) || 0;
      var subtotal = cantidad * precio;
      tr.querySelector('.f-subtotal').textContent = subtotal.toFixed(2);
      total += subtotal;
      actualizarAvisoStock(tr);
    });
    document.getElementById('total-venta').textContent = '$' + total.toFixed(2);
    actualizarEstadoMedios();
  }

  function reindexar() {
    tbody.querySelectorAll('tr').forEach(function (tr, i) {
      tr.querySelectorAll('[data-campo]').forEach(function (el) {
        el.name = 'items[' + i + '][' + el.dataset.campo + ']';
      });
    });
  }

  document.getElementById('agregar-fila').addEventListener('click', function () {
    var filas = tbody.querySelectorAll('tr');
    var nueva = filas[filas.length - 1].cloneNode(true);
    nueva.querySelectorAll('input[type=number]').forEach(function (el) { el.value = ''; });
    nueva.querySelector('.f-codigo').value = '';
    nueva.querySelector('.f-articulo-buscar').value = '';
    nueva.querySelector('.f-articulo-id').value = '';
    nueva.querySelector('.f-subtotal').textContent = '0.00';
    var avisoNueva = nueva.querySelector('.f-aviso-stock');
    avisoNueva.textContent = '';
    avisoNueva.style.display = 'none';
    delete nueva.dataset.excedeStock;
    tbody.appendChild(nueva);
    reindexar();
  });

  tbody.addEventListener('click', function (e) {
    if (e.target.classList.contains('quitar-fila')) {
      if (tbody.querySelectorAll('tr').length > 1) {
        e.target.closest('tr').remove();
        reindexar();
        actualizarTotales();
      }
    }
  });

  tbody.addEventListener('input', function (e) {
    actualizarTotales();
    if (e.target.classList.contains('f-articulo-buscar')) {
      var tr = e.target.closest('tr');
      // si lo que quedó tipeado ya no coincide con el artículo elegido, se
      // desvincula hasta que se elija uno de la lista de nuevo
      var actual = articulosPorId[tr.querySelector('.f-articulo-id').value];
      if (!actual || etiquetaArticulo(actual) !== e.target.value) {
        tr.querySelector('.f-articulo-id').value = '';
      }
      mostrarBuscador(tr, buscarArticulos(e.target.value));
    } else if (e.target.classList.contains('f-codigo')) {
      // igual que en Compras: tipear un código que coincide con un
      // artículo lo completa solo (y sugiere su precio, más abajo).
      var tr2 = e.target.closest('tr');
      var codigoTexto = e.target.value.trim().toLowerCase();
      var encontrado = codigoTexto && ARTICULOS.find(function (a) { return a.codigo.toLowerCase() === codigoTexto; });
      if (encontrado) {
        fijarArticuloEnFila(tr2, encontrado);
      } else if (tr2.querySelector('.f-articulo-id').value) {
        // el código se borró o ya no coincide con ningún artículo: se
        // desvincula el artículo que estaba elegido, en vez de dejarlo
        // pegado a un código que ya no está
        tr2.querySelector('.f-articulo-id').value = '';
        tr2.querySelector('.f-articulo-buscar').value = '';
      }
    }
  });

  // "focus" y "blur" no burbujean — hay que escucharlos en fase de
  // "capture" para poder delegarlos igual que los demás eventos de fila.
  tbody.addEventListener('focus', function (e) {
    if (e.target.classList.contains('f-articulo-buscar')) {
      mostrarBuscador(e.target.closest('tr'), buscarArticulos(e.target.value));
    }
  }, true);
  tbody.addEventListener('blur', function (e) {
    if (e.target.classList.contains('f-articulo-buscar')) {
      var trBlur = e.target.closest('tr');
      setTimeout(function () {
        if (filaActiva === trBlur) ocultarBuscador();
      }, 150);
    }
  }, true);
  window.addEventListener('scroll', function () { if (filaActiva) ocultarBuscador(); }, true);
  window.addEventListener('resize', ocultarBuscador);

  // Al cambiar la forma de pago, se recalcula el precio de todos los
  // renglones que ya tienen un artículo elegido — antes este cambio no
  // tocaba los renglones ya cargados y quedaban con el precio de la forma
  // de pago anterior.
  formaPagoSelect.addEventListener('change', function () {
    tbody.querySelectorAll('tr').forEach(function (tr) {
      var articulo = articulosPorId[tr.querySelector('.f-articulo-id').value];
      if (articulo) tr.querySelector('.f-precio').value = precioSugerido(articulo);
    });
    actualizarTotales();
  });

  // Buscador del cliente — mismo patrón que el de artículo, pero para un
  // único campo obligatorio en vez de una tabla de renglones.
  var CLIENTES = <%- JSON.stringify(clientes.map(c => ({ id: String(c.id), razon_social: c.razon_social, cuit_dni: c.cuit_dni || '' }))) %>;
  var clienteBuscarInput = document.getElementById('cliente_buscar');
  var clienteIdInput = document.getElementById('cliente_id');
  var clienteBuscador = document.createElement('div');
  clienteBuscador.className = 'buscador-flotante';
  clienteBuscador.style.display = 'none';
  document.body.appendChild(clienteBuscador);
  var clienteBuscadorActivo = false;

  function etiquetaCliente(c) {
    return c.razon_social + (c.cuit_dni ? ' (' + c.cuit_dni + ')' : '');
  }

  function buscarClientes(texto) {
    var t = texto.trim().toLowerCase();
    if (!t) return CLIENTES;
    return CLIENTES.filter(function (c) {
      return c.razon_social.toLowerCase().indexOf(t) !== -1 || c.cuit_dni.toLowerCase().indexOf(t) !== -1;
    });
  }

  function ocultarClienteBuscador() {
    clienteBuscador.style.display = 'none';
    clienteBuscador.innerHTML = '';
    clienteBuscadorActivo = false;
  }

  function fijarCliente(c) {
    clienteIdInput.value = c ? c.id : '';
    clienteBuscarInput.value = c ? etiquetaCliente(c) : '';
  }

  function mostrarClienteBuscador(coincidencias) {
    clienteBuscadorActivo = true;
    clienteBuscador.innerHTML = '';
    if (coincidencias.length === 0) {
      var vacio = document.createElement('div');
      vacio.style.cssText = 'padding:8px 12px; font-size:.85rem; color:var(--ink-soft);';
      vacio.textContent = 'Sin resultados.';
      clienteBuscador.appendChild(vacio);
    } else {
      coincidencias.slice(0, 30).forEach(function (c) {
        var boton = document.createElement('button');
        boton.type = 'button';
        boton.textContent = etiquetaCliente(c);
        boton.addEventListener('mousedown', function (e) {
          e.preventDefault();
          fijarCliente(c);
          ocultarClienteBuscador();
        });
        clienteBuscador.appendChild(boton);
      });
    }
    var rect = clienteBuscarInput.getBoundingClientRect();
    clienteBuscador.style.left = rect.left + 'px';
    clienteBuscador.style.top = rect.bottom + 'px';
    clienteBuscador.style.width = Math.max(rect.width, 240) + 'px';
    clienteBuscador.style.display = 'block';
  }

  clienteBuscarInput.addEventListener('focus', function () {
    mostrarClienteBuscador(buscarClientes(clienteBuscarInput.value));
  });
  clienteBuscarInput.addEventListener('input', function () {
    var actual = CLIENTES.find(function (c) { return c.id === clienteIdInput.value; });
    if (!actual || etiquetaCliente(actual) !== clienteBuscarInput.value) {
      clienteIdInput.value = '';
    }
    mostrarClienteBuscador(buscarClientes(clienteBuscarInput.value));
  });
  clienteBuscarInput.addEventListener('blur', function () {
    setTimeout(function () { if (clienteBuscadorActivo) ocultarClienteBuscador(); }, 150);
  });
  window.addEventListener('scroll', function () { if (clienteBuscadorActivo) ocultarClienteBuscador(); }, true);
  window.addEventListener('resize', ocultarClienteBuscador);

  // A diferencia de Presupuestos, en Ventas superar el stock disponible
  // no deja guardar — se corta el envío y se lleva el foco al primer
  // renglón con problema, junto con el aviso que ya está mostrando cuánto
  // queda.
  document.getElementById('form-venta').addEventListener('submit', function (e) {
    var primeraFilaConProblema = null;
    tbody.querySelectorAll('tr').forEach(function (tr) {
      if (!primeraFilaConProblema && tr.dataset.excedeStock === '1') primeraFilaConProblema = tr;
    });
    if (primeraFilaConProblema) {
      e.preventDefault();
      alert('No se puede guardar la venta: alguna cantidad supera el stock disponible. Revisá el renglón marcado en rojo.');
      primeraFilaConProblema.querySelector('.f-cantidad').focus();
      return;
    }

    // Mismo chequeo que hace el servidor al guardar (ver errorMedios en
    // routes/ventas.js) — se repite acá para avisar antes de mandar el
    // formulario, sin esperar la vuelta del servidor.
    var sumaMedios = 0;
    filasMedios.querySelectorAll('.f-monto-medio').forEach(function (input) {
      sumaMedios += parseFloat(input.value) || 0;
    });
    var totalActual = totalVentaNumero();
    if (Math.abs(Math.round((totalActual - sumaMedios) * 100) / 100) > 0.005) {
      e.preventDefault();
      alert('No se puede guardar: los medios de pago suman $' + sumaMedios.toFixed(2) + ', pero el total de la venta es $' + totalActual.toFixed(2) + '. Ajustá los montos para que coincidan.');
    }
  });

  actualizarTotales();
})();
</script>

