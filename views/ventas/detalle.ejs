<%- include('../partials/head') %>

<div class="toolbar">
  <h1>Remito Nº <%= venta.numero_remito %></h1>
  <div style="display:flex; gap:8px; flex-wrap:wrap;">
    <button type="button" id="generar-remito" class="btn secondary">Generar remito (PDF)</button>
    <a class="btn secondary" href="/ventas/<%= venta.id %>/editar">Editar</a>
    <form method="post" action="/ventas/<%= venta.id %>/eliminar" style="display:inline;" onsubmit="return confirm('¿Eliminar esta venta? No se puede deshacer.');">
      <button type="submit" class="btn secondary" style="color:#a33;">Eliminar</button>
    </form>
    <a class="btn secondary" href="/ventas">← Volver</a>
  </div>
</div>

<% const ETIQUETAS_FORMA_PAGO = { efectivo: 'Efectivo', transferencia: 'Transferencia', cuenta_corriente: 'Cuenta corriente' };
   const ETIQUETAS_ORIGEN = { deposito: 'Depósito', calle: 'Calle (preventista)' };
   const ETIQUETAS_ESTADO = { emitido: 'Emitido', entregado: 'Entregado', cobrado: 'Cobrado' }; %>
<p style="color:var(--ink-soft);">
  <span class="badge <%= venta.estado %>"><%= ETIQUETAS_ESTADO[venta.estado] || venta.estado %></span>
  · Cliente: <strong style="color:var(--ink);"><%= venta.cliente_nombre %></strong>
  (<a href="/clientes/<%= venta.cliente_id %>/editar">completar datos del cliente</a>)
  · Fecha: <%= new Date(venta.fecha).toLocaleDateString('es-AR') %>
  · <%= ETIQUETAS_FORMA_PAGO[venta.forma_pago] || venta.forma_pago %>
  · <%= ETIQUETAS_ORIGEN[venta.origen] || venta.origen %>
</p>

<form method="post" action="/ventas/<%= venta.id %>/estado" style="max-width:260px; margin-bottom:18px;">
  <label for="estado">Estado</label>
  <select id="estado" name="estado" onchange="this.form.submit()">
    <option value="emitido" <%= venta.estado === 'emitido' ? 'selected' : '' %>>Emitido</option>
    <option value="entregado" <%= venta.estado === 'entregado' ? 'selected' : '' %>>Entregado</option>
    <option value="cobrado" <%= venta.estado === 'cobrado' ? 'selected' : '' %>>Cobrado</option>
  </select>
</form>

<table>
  <thead>
    <tr>
      <th>Código</th>
      <th>Artículo</th>
      <th>Cantidad</th>
      <th>Precio unit.</th>
      <th>Subtotal</th>
    </tr>
  </thead>
  <tbody>
    <% items.forEach(it => { %>
    <tr>
      <td data-label="Código" class="mono"><%= it.codigo %></td>
      <td data-label="Artículo"><%= it.nombre %></td>
      <td data-label="Cantidad" class="mono"><%= Number(it.cantidad) %></td>
      <td data-label="Precio unit." class="mono">$<%= Number(it.precio_unitario).toFixed(2) %></td>
      <td data-label="Subtotal" class="mono">$<%= Number(it.subtotal).toFixed(2) %></td>
    </tr>
    <% }) %>
  </tbody>
  <tfoot>
    <tr>
      <td colspan="4" style="text-align:right; font-weight:600;">Total</td>
      <td class="mono" style="font-weight:600;">$<%= Number(venta.total).toFixed(2) %></td>
    </tr>
  </tfoot>
</table>

<% if (venta.notas) { %>
  <p style="color:var(--ink-soft); font-size:.9rem; margin-top:16px;"><strong>Notas:</strong> <%= venta.notas %></p>
<% } %>

<script src="https://unpkg.com/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
<script>
(function () {
  var VENTA = <%- JSON.stringify({
    numeroRemito: venta.numero_remito,
    fecha: venta.fecha,
    formaPago: ETIQUETAS_FORMA_PAGO[venta.forma_pago] || venta.forma_pago,
    cliente: {
      nombre: venta.cliente_nombre,
      direccion: venta.cliente_direccion || '',
      telefono: venta.cliente_telefono || '',
      cuitDni: venta.cliente_cuit_dni || '',
      condicionIva: venta.cliente_condicion_iva || '',
    },
    items: items.map(function (it) {
      return {
        codigo: it.codigo,
        nombre: it.nombre,
        cantidad: Number(it.cantidad),
        precioUnitario: Number(it.precio_unitario),
        subtotal: Number(it.subtotal),
      };
    }),
    total: Number(venta.total),
  }) %>;

  var boton = document.getElementById('generar-remito');
  if (!boton) return;

  boton.addEventListener('click', function () {
    if (typeof window.jspdf === 'undefined') {
      alert('No se pudo cargar la librería para generar el PDF. Revisá la conexión a internet e intentá de nuevo.');
      return;
    }

    var jsPDF = window.jspdf.jsPDF;
    var doc = new jsPDF({ unit: 'mm', format: 'a4' });
    var margenIzq = 14;
    var margenDer = 14;
    var anchoPagina = doc.internal.pageSize.getWidth();
    var altoPagina = doc.internal.pageSize.getHeight();
    var xCodigo = margenIzq;
    var xProducto = margenIzq + 22;
    var xCantidad = anchoPagina - margenDer - 62;
    var xPrecio = anchoPagina - margenDer - 34;
    var xSubtotal = anchoPagina - margenDer;
    var y = 20;

    doc.setFont('helvetica', 'bold');
    doc.setFontSize(15);
    doc.text('Riomar Pescadería', margenIzq, y);
    doc.setFontSize(13);
    doc.text('Remito Nº ' + VENTA.numeroRemito, anchoPagina - margenDer, y, { align: 'right' });
    y += 7;
    doc.setFont('helvetica', 'normal');
    doc.setFontSize(9);
    doc.setTextColor(110);
    doc.text('Fecha: ' + new Date(VENTA.fecha).toLocaleDateString('es-AR'), margenIzq, y);
    doc.text('Forma de pago: ' + VENTA.formaPago, anchoPagina - margenDer, y, { align: 'right' });
    doc.setTextColor(0);
    y += 9;

    doc.setDrawColor(180);
    doc.setLineWidth(0.2);
    doc.line(margenIzq, y, anchoPagina - margenDer, y);
    y += 6;

    doc.setFont('helvetica', 'bold');
    doc.setFontSize(10);
    doc.text('Cliente', margenIzq, y);
    y += 5;
    doc.setFont('helvetica', 'normal');
    doc.setFontSize(9.5);
    doc.text(VENTA.cliente.nombre, margenIzq, y);
    y += 5;
    if (VENTA.cliente.direccion) { doc.text(VENTA.cliente.direccion, margenIzq, y); y += 5; }
    var lineaContacto = [];
    if (VENTA.cliente.telefono) lineaContacto.push('Tel: ' + VENTA.cliente.telefono);
    if (VENTA.cliente.cuitDni) lineaContacto.push('CUIT/DNI: ' + VENTA.cliente.cuitDni);
    if (VENTA.cliente.condicionIva) lineaContacto.push(VENTA.cliente.condicionIva);
    if (lineaContacto.length) { doc.text(lineaContacto.join(' · '), margenIzq, y); y += 5; }
    y += 4;

    function dibujarEncabezadoTabla() {
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(9.5);
      doc.text('Código', xCodigo, y);
      doc.text('Producto', xProducto, y);
      doc.text('Cant.', xCantidad, y, { align: 'right' });
      doc.text('Precio', xPrecio, y, { align: 'right' });
      doc.text('Subtotal', xSubtotal, y, { align: 'right' });
      y += 2;
      doc.setDrawColor(180);
      doc.setLineWidth(0.2);
      doc.line(margenIzq, y, anchoPagina - margenDer, y);
      y += 5;
      doc.setFont('helvetica', 'normal');
      doc.setTextColor(0);
    }

    dibujarEncabezadoTabla();

    VENTA.items.forEach(function (it) {
      if (y > altoPagina - 30) {
        doc.addPage();
        y = 20;
        dibujarEncabezadoTabla();
      }
      doc.setFontSize(9.5);
      doc.text(String(it.codigo), xCodigo, y);
      var nombreTexto = it.nombre.length > 34 ? it.nombre.slice(0, 33) + '…' : it.nombre;
      doc.text(nombreTexto, xProducto, y);
      doc.text(String(it.cantidad), xCantidad, y, { align: 'right' });
      doc.text('$' + it.precioUnitario.toFixed(2), xPrecio, y, { align: 'right' });
      doc.text('$' + it.subtotal.toFixed(2), xSubtotal, y, { align: 'right' });
      y += 6;
    });

    y += 2;
    doc.setDrawColor(180);
    doc.line(margenIzq, y, anchoPagina - margenDer, y);
    y += 7;
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(11);
    doc.text('Total: $' + VENTA.total.toFixed(2), xSubtotal, y, { align: 'right' });

    y += 12;
    if (y > altoPagina - 15) { doc.addPage(); y = 20; }
    doc.setFont('helvetica', 'normal');
    doc.setFontSize(8);
    doc.setTextColor(120);
    doc.text('Documento no válido como factura.', margenIzq, y);

    doc.save('remito-' + VENTA.numeroRemito + '.pdf');
  });
})();
</script>

<%- include('../partials/foot') %>
