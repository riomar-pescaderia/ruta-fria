<%- include('../partials/head') %>

<div class="toolbar">
  <h1>Compras</h1>
  <a class="btn" href="/compras/nueva">+ Nueva factura</a>
</div>

<% if (facturas.length === 0) { %>
  <p class="empty">Todavía no cargaste ninguna factura de compra.</p>
<% } else { %>
<table>
  <thead>
    <tr>
      <th>Fecha</th>
      <th>Proveedor</th>
      <th>Número</th>
      <th>Categoría</th>
      <th>Total</th>
      <th>Estado</th>
    </tr>
  </thead>
  <tbody>
    <% facturas.forEach(f => {
         const catF = categorias.find(c => c.clave === f.categoria);
         const precioPendiente = f.categoria === 'mercaderia' && !f.actualizo_costos; %>
    <tr data-href="/compras/<%= f.id %>">
      <td data-label="Fecha"><%= formatearFechaHora(f.fecha) %></td>
      <td data-label="Proveedor"><%= f.proveedor_nombre %></td>
      <td data-label="Número" class="mono"><%= f.numero || '—' %></td>
      <td data-label="Categoría"><%= catF ? catF.etiqueta : f.categoria %></td>
      <td data-label="Total" class="mono">$<%= Number(f.total).toFixed(2) %></td>
      <td data-label="Estado">
        <span class="badge confirmada">Confirmada</span>
        <% if (precioPendiente) { %><span class="badge borrador" style="margin-left:4px;">Precios pendientes</span><% } %>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
<% } %>

<%- include('../partials/foot') %>
