<%- include('../partials/head') %>

<h1><%= factura.id ? 'Editar factura de compra' : 'Nueva factura de compra' %></h1>

<% if (error) { %>
  <div class="pendiente" style="border-color:#e3b8b8; color:#7a2b2b; margin-bottom:16px; padding:14px 20px;">
    <p style="margin:0;"><%= error %></p>
  </div>
<% } %>

<% if (factura.actualizo_costos) { %>
  <div class="pendiente" style="border-color:#f0d9a8; color:#8a5a12; margin-bottom:16px; padding:14px 20px;">
    <p style="margin:0;">Esta factura ya está confirmada. Estás por corregirla con un permiso especial: al guardar se corrige el registro de la factura y sus renglones, pero <strong>no</strong> se vuelve a tocar el costo de los artículos ni se repite la revisión de precios — si el costo actual de algún artículo quedó mal, corregilo desde Artículos.</p>
  </div>
<% } %>

<form class="card" method="post" action="<%= accion %>" style="max-width:900px;">
  <div style="display:flex; gap:12px; flex-wrap:wrap;">
    <div style="flex:1; min-width:220px;">
      <label for="categoria">Tipo de comprobante</label>
      <select id="categoria" name="categoria" required <%= factura.actualizo_costos ? 'disabled' : '' %>>
        <% categorias.forEach(c => { %>
          <option value="<%= c.clave %>" <%= (factura.categoria || 'mercaderia') === c.clave ? 'selected' : '' %>><%= c.etiqueta %></option>
        <% }) %>
      </select>
      <% if (factura.actualizo_costos) { %>
        <input type="hidden" name="categoria" value="mercaderia">
        <p style="color:var(--ink-soft); font-size:.8rem; margin:6px 0 0;">Una factura ya confirmada no puede cambiar de categoría.</p>
      <% } else { %>
        <p style="color:var(--ink-soft); font-size:.8rem; margin:6px 0 0;">Si es "Mercadería" se cargan artículos del catálogo y se pueden actualizar sus costos. Cualquier otra categoría (servicios, insumos, etc.) se carga a mano, sin vincularse a ningún artículo de stock.</p>
      <% } %>
    </div>
    <div style="flex:1; min-width:220px;" id="grupo-subtipo">
      <label for="subtipo">Subtipo</label>
      <select id="subtipo" name="subtipo">
        <option value="">— sin subtipo —</option>
      </select>
    </div>
  </div>

  <div style="display:flex; gap:12px; flex-wrap:wrap;">
    <div style="flex:2; min-width:220px;">
      <label for="proveedor_id">Proveedor</label>
      <select id="proveedor_id" name="proveedor_id" required>
        <option value="">— elegir —</option>
        <% proveedores.forEach(p => { %>
          <option value="<%= p.id %>" <%= String(factura.proveedor_id) === String(p.id) ? 'selected' : '' %>><%= p.nombre %></option>
        <% }) %>
      </select>
      <% if (proveedores.length === 0) { %>
        <p style="color:var(--ink-soft); font-size:.85rem; margin:6px 0 0;">Todavía no cargaste ningún proveedor — <a href="/compras/proveedores/nuevo">creá uno primero</a>.</p>
      <% } %>
    </div>
    <div style="flex:1; min-width:140px;">
      <label for="numero">Número de factura</label>
      <input type="text" id="numero" name="numero" value="<%= factura.numero || '' %>" placeholder="opcional">
    </div>
    <div style="flex:1; min-width:150px;">
      <label for="fecha">Fecha y hora</label>
      <input type="datetime-local" id="fecha" name="fecha" value="<%= factura.fecha || '' %>">
    </div>
  </div>

  <% const mapaArticulos = {}; articulos.forEach(a => { mapaArticulos[a.id] = a; }); %>
  <div style="overflow-x:auto;">
  <table id="tabla-items">
    <thead>
      <tr>
        <th style="width:110px;">Código</th>
        <th style="min-width:220px;">Artículo</th>
        <th style="width:110px;">Cantidad</th>
        <th style="width:130px;">Precio unit.</th>
        <th style="width:70px;">
          IVA<br>
          <label style="font-weight:400; text-transform:none; font-size:.7rem; display:flex; align-items:center; gap:3px; letter-spacing:0;">
            <input type="checkbox" id="iva-todos" checked style="width:auto;"> todos
          </label>
        </th>
        <th style="width:110px;">Subtotal</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="filas-items">
      <% items.forEach((it, i) => {
           const artSel = it.articulo_id ? mapaArticulos[it.articulo_id] : null;
           const codigoValor = artSel ? artSel.codigo : (it.codigo_manual || '');
           const articuloValor = artSel ? (artSel.codigo + ' — ' + artSel.nombre) : (it.descripcion || ''); %>
      <tr>
        <td data-label="Código">
          <input class="f-codigo" data-campo="codigo_manual" type="text" name="items[<%= i %>][codigo_manual]" placeholder="Código" autocomplete="off" value="<%= codigoValor %>">
        </td>
        <td data-label="Artículo">
          <input class="f-articulo-buscar" data-campo="descripcion" type="text" name="items[<%= i %>][descripcion]" placeholder="Buscar por nombre o código" autocomplete="off" value="<%= articuloValor %>">
          <input type="hidden" class="f-articulo-id" data-campo="articulo_id" name="items[<%= i %>][articulo_id]" value="<%= it.articulo_id || '' %>">
        </td>
        <td data-label="Cantidad">
          <input class="f-cantidad" data-campo="cantidad" type="number" step="0.01" min="0" name="items[<%= i %>][cantidad]" value="<%= it.cantidad || '' %>" required>
        </td>
        <td data-label="Precio unit.">
          <input class="f-precio" data-campo="precio_unitario" type="number" step="0.01" min="0" name="items[<%= i %>][precio_unitario]" value="<%= it.precio_unitario || '' %>" required>
        </td>
        <td data-label="IVA" style="text-align:center;">
          <input class="f-iva" data-campo="aplica_iva" type="checkbox" name="items[<%= i %>][aplica_iva]" <%= it.aplica_iva !== false ? 'checked' : '' %>>
        </td>
        <td data-label="Subtotal" class="mono">
          $<span class="f-subtotal"><%= it.total ? Number(it.total).toFixed(2) : '0.00' %></span>
          <div class="f-desglose" style="font-size:.75rem; font-weight:400; color:var(--ink-soft);"></div>
        </td>
        <td><button type="button" class="btn secondary quitar-fila">Quitar</button></td>
      </tr>
      <% }) %>
    </tbody>
    <tfoot>
      <tr>
        <td colspan="5" style="text-align:right; border-bottom:none;">Neto</td>
        <td class="mono" id="total-neto" style="border-bottom:none;">$0.00</td>
        <td style="border-bottom:none;"></td>
      </tr>
      <tr>
        <td colspan="5" style="text-align:right; border-bottom:none;">IVA</td>
        <td class="mono" id="total-iva" style="border-bottom:none;">$0.00</td>
        <td style="border-bottom:none;"></td>
      </tr>
      <tr>
        <td colspan="5" style="text-align:right; font-weight:600; border-bottom:none;">Total</td>
        <td class="mono" id="total-factura" style="border-bottom:none; font-weight:600;">$0.00</td>
        <td style="border-bottom:none;"></td>
      </tr>
    </tfoot>
  </table>
  </div>
  <p style="color:var(--ink-soft); font-size:.85rem; margin-top:-8px;">
    Podés cargar cada renglón escribiendo el código directamente, o buscando por nombre o código en la columna "Artículo" — se completan uno al otro solos. Casilla "IVA" tildada: el precio unitario cargado es <strong>sin IVA</strong> y el sistema le suma el <%= ivaPct %>% automáticamente (el caso más común). Destildada: el precio unitario cargado <strong>ya incluye el IVA</strong> integrado, tal cual viene en la factura. Usá "todos" para tildar o destildar la columna completa de una vez.
  </p>

  <div>
    <button type="button" id="agregar-fila" class="btn secondary">+ Agregar artículo</button>
  </div>

  <div>
    <button class="btn" type="submit">Guardar factura</button>
    <a class="btn secondary" href="/compras">Cancelar</a>
  </div>
</form>

<script>
(function () {
  var tbody = document.getElementById('filas-items');
  var checkTodos = document.getElementById('iva-todos');
  var IVA_PCT = <%- JSON.stringify(Number(ivaPct)) %>;

  // Con categoría "mercadería" el código/artículo se vinculan al catálogo
  // (buscador, autocompletado). Con cualquier otra categoría son texto
  // libre: no hay stock ni costo que actualizar, así que no tiene sentido
  // ofrecer el buscador ni auto-completar nada.
  var categoriaSelect = document.getElementById('categoria');
  var categoriaAnterior = categoriaSelect.value;
  function esMercaderia() { return categoriaSelect.value === 'mercaderia'; }

  // Subtipo dentro de la categoría (por ejemplo "Electricidad" dentro de
  // "Servicios") — el listado de opciones depende de qué categoría esté
  // elegida, así que se arma de nuevo cada vez que cambia.
  var SUBTIPOS_POR_CATEGORIA = <%- JSON.stringify(Object.fromEntries(categorias.map(c => [c.clave, c.subtipos]))) %>;
  var SUBTIPO_INICIAL = <%- JSON.stringify(factura.subtipo || '') %>;
  var subtipoSelect = document.getElementById('subtipo');
  var grupoSubtipo = document.getElementById('grupo-subtipo');

  function actualizarSubtipos(preservar) {
    var lista = SUBTIPOS_POR_CATEGORIA[categoriaSelect.value] || [];
    var valorPrevio = preservar ? subtipoSelect.value : '';
    subtipoSelect.innerHTML = '';
    var opcionVacia = document.createElement('option');
    opcionVacia.value = '';
    opcionVacia.textContent = '— sin subtipo —';
    subtipoSelect.appendChild(opcionVacia);
    lista.forEach(function (s) {
      var opt = document.createElement('option');
      opt.value = s;
      opt.textContent = s;
      subtipoSelect.appendChild(opt);
    });
    if (lista.length === 0) {
      grupoSubtipo.style.display = 'none';
      subtipoSelect.value = '';
    } else {
      grupoSubtipo.style.display = '';
      if (valorPrevio && lista.indexOf(valorPrevio) !== -1) subtipoSelect.value = valorPrevio;
    }
  }

  function actualizarPlaceholders() {
    var esM = esMercaderia();
    tbody.querySelectorAll('.f-codigo').forEach(function (el) {
      el.placeholder = esM ? 'Código' : 'Código (opcional)';
    });
    tbody.querySelectorAll('.f-articulo-buscar').forEach(function (el) {
      el.placeholder = esM ? 'Buscar por nombre o código' : 'Descripción';
    });
  }

  // Datos de artículos para el buscador de la columna "Artículo" y para
  // completar el código automáticamente cuando se elige uno.
  var ARTICULOS = <%- JSON.stringify(articulos.map(a => ({ id: String(a.id), codigo: a.codigo, nombre: a.nombre }))) %>;
  var articulosPorId = {};
  ARTICULOS.forEach(function (a) { articulosPorId[a.id] = a; });

  function etiquetaArticulo(a) {
    return a.codigo + ' — ' + a.nombre;
  }

  function buscarArticulos(texto) {
    var t = texto.trim().toLowerCase();
    if (!t) return ARTICULOS;
    return ARTICULOS.filter(function (a) {
      return a.codigo.toLowerCase().indexOf(t) !== -1 || a.nombre.toLowerCase().indexOf(t) !== -1;
    });
  }

  // Un único panel flotante, reutilizado para la fila que esté activa en
  // cada momento — más simple y liviano que uno por renglón, y evita que
  // el "overflow-x:auto" de la tabla lo recorte (se posiciona con
  // "position:fixed", relativo a la pantalla, no a la tabla).
  var buscador = document.createElement('div');
  buscador.className = 'buscador-flotante';
  buscador.style.display = 'none';
  document.body.appendChild(buscador);
  var filaActiva = null;

  function ocultarBuscador() {
    buscador.style.display = 'none';
    buscador.innerHTML = '';
    filaActiva = null;
  }

  function fijarArticuloEnFila(tr, articulo) {
    tr.querySelector('.f-articulo-id').value = articulo ? articulo.id : '';
    tr.querySelector('.f-articulo-buscar').value = articulo ? etiquetaArticulo(articulo) : '';
    if (articulo) tr.querySelector('.f-codigo').value = articulo.codigo;
    actualizarTotales();
  }

  function mostrarBuscador(tr, coincidencias) {
    filaActiva = tr;
    buscador.innerHTML = '';
    if (coincidencias.length === 0) {
      var vacio = document.createElement('div');
      vacio.style.cssText = 'padding:8px 12px; font-size:.85rem; color:var(--ink-soft);';
      vacio.textContent = 'Sin resultados.';
      buscador.appendChild(vacio);
    } else {
      coincidencias.slice(0, 30).forEach(function (a) {
        var boton = document.createElement('button');
        boton.type = 'button';
        boton.textContent = etiquetaArticulo(a);
        // "mousedown" (no "click") para que se ejecute antes de que el
        // input pierda el foco y el buscador se cierre solo.
        boton.addEventListener('mousedown', function (e) {
          e.preventDefault();
          fijarArticuloEnFila(tr, a);
          ocultarBuscador();
        });
        buscador.appendChild(boton);
      });
    }
    var input = tr.querySelector('.f-articulo-buscar');
    var rect = input.getBoundingClientRect();
    buscador.style.left = rect.left + 'px';
    buscador.style.top = rect.bottom + 'px';
    buscador.style.width = Math.max(rect.width, 240) + 'px';
    buscador.style.display = 'block';
  }

  // Misma lógica que calcularItem() en routes/compras.js:
  // sumarIva=true  → el precio cargado es neto (sin IVA), se le suma el IVA.
  // sumarIva=false → el precio cargado ya incluye el IVA, se usa tal cual.
  function calcularItem(cantidad, precioIngresado, sumarIva) {
    var precioFinal, total, neto, iva;
    if (sumarIva) {
      precioFinal = precioIngresado * (1 + IVA_PCT / 100);
      total = cantidad * precioFinal;
      neto = cantidad * precioIngresado;
      iva = total - neto;
    } else {
      precioFinal = precioIngresado;
      total = cantidad * precioFinal;
      neto = total / (1 + IVA_PCT / 100);
      iva = total - neto;
    }
    return { precioFinal: precioFinal, total: total, neto: neto, iva: iva };
  }

  function actualizarTotales() {
    var total = 0, totalNeto = 0, totalIva = 0;
    tbody.querySelectorAll('tr').forEach(function (tr) {
      var cantidad = parseFloat(tr.querySelector('.f-cantidad').value) || 0;
      var precio = parseFloat(tr.querySelector('.f-precio').value) || 0;
      var sumarIva = tr.querySelector('.f-iva').checked;
      var r = calcularItem(cantidad, precio, sumarIva);
      tr.querySelector('.f-subtotal').textContent = r.total.toFixed(2);
      tr.querySelector('.f-desglose').textContent = sumarIva
        ? '+ IVA $' + r.iva.toFixed(2) + ' (precio final $' + r.precioFinal.toFixed(2) + ')'
        : 'IVA incluido: neto $' + r.neto.toFixed(2) + ' + IVA $' + r.iva.toFixed(2);
      total += r.total;
      totalNeto += r.neto;
      totalIva += r.iva;
    });
    document.getElementById('total-factura').textContent = '$' + total.toFixed(2);
    document.getElementById('total-neto').textContent = '$' + totalNeto.toFixed(2);
    document.getElementById('total-iva').textContent = '$' + totalIva.toFixed(2);
  }

  function actualizarCheckTodos() {
    var casillas = tbody.querySelectorAll('.f-iva');
    var todasTildadas = true;
    casillas.forEach(function (c) { if (!c.checked) todasTildadas = false; });
    checkTodos.checked = todasTildadas;
  }

  function reindexar() {
    tbody.querySelectorAll('tr').forEach(function (tr, i) {
      tr.querySelectorAll('[data-campo]').forEach(function (el) {
        el.name = 'items[' + i + '][' + el.dataset.campo + ']';
      });
    });
  }

  document.getElementById('agregar-fila').addEventListener('click', function () {
    var filas = tbody.querySelectorAll('tr');
    var nueva = filas[filas.length - 1].cloneNode(true);
    nueva.querySelectorAll('input[type=number]').forEach(function (el) { el.value = ''; });
    nueva.querySelectorAll('input[type=checkbox]').forEach(function (el) { el.checked = checkTodos.checked; });
    nueva.querySelector('.f-codigo').value = '';
    nueva.querySelector('.f-articulo-buscar').value = '';
    nueva.querySelector('.f-articulo-id').value = '';
    nueva.querySelector('.f-subtotal').textContent = '0.00';
    nueva.querySelector('.f-desglose').textContent = '';
    tbody.appendChild(nueva);
    reindexar();
  });

  tbody.addEventListener('click', function (e) {
    if (e.target.classList.contains('quitar-fila')) {
      if (tbody.querySelectorAll('tr').length > 1) {
        e.target.closest('tr').remove();
        reindexar();
        actualizarTotales();
        actualizarCheckTodos();
      }
    }
  });

  checkTodos.addEventListener('change', function () {
    tbody.querySelectorAll('.f-iva').forEach(function (c) { c.checked = checkTodos.checked; });
    actualizarTotales();
  });

  tbody.addEventListener('input', function (e) {
    actualizarTotales();
    if (e.target.classList.contains('f-articulo-buscar')) {
      if (!esMercaderia()) return;
      var tr = e.target.closest('tr');
      // si lo que quedó tipeado ya no coincide con el artículo elegido,
      // se desvincula hasta que se elija uno de la lista de nuevo
      var actual = articulosPorId[tr.querySelector('.f-articulo-id').value];
      if (!actual || etiquetaArticulo(actual) !== e.target.value) {
        tr.querySelector('.f-articulo-id').value = '';
      }
      mostrarBuscador(tr, buscarArticulos(e.target.value));
    } else if (e.target.classList.contains('f-codigo')) {
      if (!esMercaderia()) return;
      var tr2 = e.target.closest('tr');
      var codigoTexto = e.target.value.trim().toLowerCase();
      var encontrado = codigoTexto && ARTICULOS.find(function (a) { return a.codigo.toLowerCase() === codigoTexto; });
      if (encontrado) {
        fijarArticuloEnFila(tr2, encontrado);
      } else if (tr2.querySelector('.f-articulo-id').value) {
        // el código se borró o ya no coincide con ningún artículo: se
        // desvincula el artículo que estaba elegido, en vez de dejarlo
        // pegado a un código que ya no está
        fijarArticuloEnFila(tr2, null);
      }
    }
  });
  tbody.addEventListener('change', function (e) {
    actualizarTotales();
    if (e.target.classList.contains('f-iva')) actualizarCheckTodos();
  });

  // "focus" y "blur" no burbujean — hay que escucharlos en fase de
  // "capture" para poder delegarlos igual que los demás eventos de fila.
  tbody.addEventListener('focus', function (e) {
    if (e.target.classList.contains('f-articulo-buscar') && esMercaderia()) {
      mostrarBuscador(e.target.closest('tr'), buscarArticulos(e.target.value));
    }
  }, true);
  tbody.addEventListener('blur', function (e) {
    if (e.target.classList.contains('f-articulo-buscar')) {
      // pequeño margen para que un click en una opción (mousedown) llegue
      // a procesarse antes de que el buscador se cierre por el blur
      var trBlur = e.target.closest('tr');
      setTimeout(function () {
        if (filaActiva === trBlur) ocultarBuscador();
      }, 150);
    }
  }, true);
  window.addEventListener('scroll', function () { if (filaActiva) ocultarBuscador(); }, true);
  window.addEventListener('resize', ocultarBuscador);

  // Cambiar entre "mercadería" y cualquier otra categoría cambia por
  // completo qué significan los renglones (artículo del catálogo vs.
  // texto libre), así que si ya hay algo cargado se avisa antes de
  // limpiar código/artículo de todos los renglones.
  categoriaSelect.addEventListener('change', function () {
    var eraMercaderia = categoriaAnterior === 'mercaderia';
    var esAhoraMercaderia = categoriaSelect.value === 'mercaderia';
    if (eraMercaderia !== esAhoraMercaderia) {
      var hayDatos = false;
      tbody.querySelectorAll('tr').forEach(function (tr) {
        if (tr.querySelector('.f-codigo').value.trim() || tr.querySelector('.f-articulo-buscar').value.trim()) hayDatos = true;
      });
      if (hayDatos && !confirm('Cambiar el tipo de comprobante borra el código y el artículo cargados en cada renglón. ¿Querés continuar?')) {
        categoriaSelect.value = categoriaAnterior;
        return;
      }
      tbody.querySelectorAll('tr').forEach(function (tr) {
        tr.querySelector('.f-codigo').value = '';
        tr.querySelector('.f-articulo-buscar').value = '';
        tr.querySelector('.f-articulo-id').value = '';
      });
    }
    categoriaAnterior = categoriaSelect.value;
    actualizarPlaceholders();
    actualizarSubtipos(false);
    actualizarTotales();
  });

  actualizarCheckTodos();
  actualizarPlaceholders();
  actualizarSubtipos(false);
  if (SUBTIPO_INICIAL && (SUBTIPOS_POR_CATEGORIA[categoriaSelect.value] || []).indexOf(SUBTIPO_INICIAL) !== -1) {
    subtipoSelect.value = SUBTIPO_INICIAL;
  }
  actualizarTotales();
})();
</script>

<%- include('../partials/foot') %>
