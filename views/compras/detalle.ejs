<%- include('../partials/head') %>

<div class="toolbar">
  <h1>Factura de compra<% if (factura.numero) { %> #<%= factura.numero %><% } %></h1>
  <div style="display:flex; gap:8px; flex-wrap:wrap;">
    <% var puedeCorregir = usuario && (usuario.esAdmin || (usuario.permisos && usuario.permisos.editarConfirmadas)); %>
    <% if (!factura.actualizo_costos) { %>
      <a class="btn secondary" href="/compras/<%= factura.id %>/editar">Editar</a>
      <form method="post" action="/compras/<%= factura.id %>/eliminar" style="display:inline;" onsubmit="return confirm('¿Eliminar esta factura? No se puede deshacer.');">
        <button type="submit" class="btn secondary" style="color:#a33;">Eliminar</button>
      </form>
      <% if (factura.categoria === 'mercaderia') { %>
        <a class="btn" href="/compras/<%= factura.id %>/confirmar">Revisar precios y confirmar</a>
      <% } %>
    <% } else if (puedeCorregir) { %>
      <a class="btn secondary" href="/compras/<%= factura.id %>/editar">Editar</a>
      <form method="post" action="/compras/<%= factura.id %>/eliminar" style="display:inline;" onsubmit="return confirm('Esta factura ya está confirmada. Eliminarla no revierte el costo que ya se aplicó a los artículos, y se pierde el historial. ¿Eliminar igual?');">
        <button type="submit" class="btn secondary" style="color:#a33;">Eliminar</button>
      </form>
    <% } %>
    <a class="btn secondary" href="/compras">← Volver</a>
  </div>
</div>

<% const catFactura = categorias.find(c => c.clave === factura.categoria); %>
<p style="color:var(--ink-soft);">
  <span class="badge <%= factura.actualizo_costos ? 'confirmada' : 'borrador' %>"><%= factura.actualizo_costos ? 'Confirmada' : 'Borrador' %></span>
  · <%= catFactura ? catFactura.etiqueta : factura.categoria %><%= factura.subtipo ? ' (' + factura.subtipo + ')' : '' %>
  · Proveedor: <strong style="color:var(--ink);"><%= factura.proveedor_nombre %></strong>
  · Fecha: <%= formatearFechaHora(factura.fecha) %>
</p>

<table>
  <thead>
    <tr>
      <th>Código</th>
      <th>Artículo</th>
      <th>Cantidad</th>
      <th>Precio unit.</th>
      <th>IVA</th>
      <th>Subtotal</th>
      <% if (factura.actualizo_costos) { %><th>Costo del artículo</th><% } %>
    </tr>
  </thead>
  <tbody>
    <% items.forEach(it => { %>
    <tr>
      <td data-label="Código" class="mono"><%= it.codigo %></td>
      <td data-label="Artículo"><%= it.nombre %></td>
      <td data-label="Cantidad" class="mono"><%= Number(it.cantidad) %></td>
      <td data-label="Precio unit." class="mono">$<%= Number(it.precio_unitario).toFixed(2) %></td>
      <td data-label="IVA"><%= it.aplica_iva ? 'Sí' : 'No' %></td>
      <td data-label="Subtotal" class="mono">
        $<%= Number(it.total).toFixed(2) %>
        <div style="font-size:.75rem; font-weight:400; color:var(--ink-soft);">
          <% if (it.aplica_iva) { %>neto $<%= Number(it.neto).toFixed(2) %> + IVA $<%= Number(it.iva).toFixed(2) %><% } else { %>sin IVA discriminado<% } %>
        </div>
      </td>
      <% if (factura.actualizo_costos) { %>
        <td data-label="Costo del artículo">
          <% if (it.estado_costo === 'aplicado') { %>
            <span class="badge aplicado">Actualizado</span>
          <% } else if (it.estado_costo === 'no_aplicado') { %>
            <span class="badge no-aplicado">No aplicado</span>
          <% } else { %>
            <span style="color:var(--ink-soft); font-size:.85rem;">Sin cambios</span>
          <% } %>
        </td>
      <% } %>
    </tr>
    <% }) %>
  </tbody>
  <% const totalNeto = items.reduce((acc, it) => acc + Number(it.neto), 0);
     const totalIva = items.reduce((acc, it) => acc + Number(it.iva), 0); %>
  <tfoot>
    <tr>
      <td colspan="5" style="text-align:right; border-bottom:none;">Neto</td>
      <td class="mono" style="border-bottom:none;">$<%= totalNeto.toFixed(2) %></td>
      <% if (factura.actualizo_costos) { %><td style="border-bottom:none;"></td><% } %>
    </tr>
    <tr>
      <td colspan="5" style="text-align:right; border-bottom:none;">IVA</td>
      <td class="mono" style="border-bottom:none;">$<%= totalIva.toFixed(2) %></td>
      <% if (factura.actualizo_costos) { %><td style="border-bottom:none;"></td><% } %>
    </tr>
    <tr>
      <td colspan="5" style="text-align:right; font-weight:600;">Total</td>
      <td class="mono">$<%= Number(factura.total).toFixed(2) %></td>
      <% if (factura.actualizo_costos) { %><td></td><% } %>
    </tr>
  </tfoot>
</table>

<% if (factura.actualizo_costos) { %>
  <p style="color:var(--ink-soft); font-size:.85rem; margin-top:16px;">
    Esta factura ya actualizó el costo de sus artículos, así que queda de solo lectura para no perder el historial de qué costo regía en cada momento.
    <% if (puedeCorregir) { %>Tenés permiso para corregirla igual — al guardar cambios se corrige el registro de la factura, pero no se vuelve a tocar el costo de los artículos ni se repite la revisión de precios.<% } %>
  </p>
<% } %>

<%- include('../partials/foot') %>
