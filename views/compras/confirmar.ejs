<%- include('../partials/head') %>

<h1>Revisar precios antes de confirmar</h1>

<p style="color:var(--ink-soft);">
  Proveedor: <strong style="color:var(--ink);"><%= factura.proveedor_nombre %></strong>
  · Fecha: <%= formatearFechaHora(factura.fecha) %>
  <% if (factura.numero) { %>· Factura #<%= factura.numero %><% } %>
</p>

<p style="color:var(--ink-soft); font-size:.9rem;">
  Los artículos resaltados cambian de precio respecto al costo que tienen cargado hoy. Elegí, uno por uno, si querés que este costo nuevo quede guardado en el artículo. Los dos precios están <strong>sin IVA</strong> (el mismo criterio que usa el costo del artículo), más allá de si la fila llevaba la casilla "IVA" tildada o no en la factura.
</p>

<% if (fletesImputados.length > 0) { %>
  <p style="color:var(--ink-soft); font-size:.9rem;">
    Esta factura tiene imputado<%= fletesImputados.length > 1 ? 's' : '' %> el<%= fletesImputados.length > 1 ? ' total de los fletes de' : ' flete de' %>
    <% fletesImputados.forEach((f, i) => { %><% if (i > 0) { %>, <% } %><a href="/compras/<%= f.id %>"><%= f.numero ? 'Nº ' + f.numero : 'Factura #' + f.id %></a><% }) %>
    (<%= fletesImputados.length > 1 ? 'suman $' + fletesTotal.toFixed(2) : '$' + fletesTotal.toFixed(2) %>).
    <% if (fletePct !== null) { %>% de flete calculado (flete ÷ total de esta factura): <strong style="color:var(--ink);"><%= fletePct.toFixed(2) %>%</strong> — se aplica automáticamente a todos los artículos de la factura al confirmar, sin tener que elegirlos uno por uno.<% } %>
  </p>
<% } %>

<form method="post" action="/compras/<%= factura.id %>/confirmar">
<div style="overflow-x:auto;">
<table>
  <thead>
    <tr>
      <th>Código</th>
      <th>Artículo</th>
      <th>Precio anterior</th>
      <th>Precio nuevo</th>
      <th>
        <label style="font-weight:400; text-transform:none; font-size:.7rem; display:flex; align-items:center; gap:3px; letter-spacing:0; white-space:nowrap;">
          <input type="checkbox" id="check-todos-precio" checked style="width:auto;"> todos
        </label>
      </th>
      <% if (fletesImputados.length > 0) { %>
        <th>Flete % anterior</th>
        <th>Flete % nuevo</th>
        <th></th>
      <% } %>
    </tr>
  </thead>
  <tbody>
    <% items.forEach(it => { %>
      <tr class="<%= it.cambia ? 'fila-cambio' : '' %>">
        <td data-label="Código" class="mono"><%= it.codigo %></td>
        <td data-label="Artículo"><%= it.nombre %></td>
        <td data-label="Precio anterior" class="mono">$<%= Number(it.costo_actual).toFixed(2) %></td>
        <td data-label="Precio nuevo" class="mono"><strong>$<%= Number(it.costoNuevo).toFixed(2) %></strong></td>
        <td data-label="">
          <% if (it.cambia) { %>
            <label class="check-row" style="white-space:nowrap;">
              <input type="checkbox" class="check-precio" name="aplicar[<%= it.id %>]" checked>
              <span>Cambiar precio</span>
            </label>
          <% } else { %>
            <span style="color:var(--ink-soft); font-size:.85rem;">Sin cambios</span>
          <% } %>
        </td>
        <% if (fletesImputados.length > 0) { %>
          <td data-label="Flete % anterior" class="mono"><%= Number(it.flete_actual).toFixed(2) %>%</td>
          <td data-label="Flete % nuevo" class="mono"><strong><%= it.fletePctNuevo !== null ? Number(it.fletePctNuevo).toFixed(2) + '%' : '—' %></strong></td>
          <td data-label="">
            <% if (it.cambiaFlete) { %>
              <span style="color:var(--ink-soft); font-size:.85rem;">Se va a actualizar</span>
            <% } else { %>
              <span style="color:var(--ink-soft); font-size:.85rem;">Sin cambios</span>
            <% } %>
          </td>
        <% } %>
      </tr>
    <% }) %>
  </tbody>
</table>
</div>

<div style="margin-top:20px;">
  <button class="btn" type="submit">Confirmar factura</button>
  <a class="btn secondary" href="/compras/<%= factura.id %>">Cancelar, decidir más tarde</a>
</div>
</form>

<script>
(function () {
  var checkTodos = document.getElementById('check-todos-precio');
  if (!checkTodos) return;
  var casillas = document.querySelectorAll('.check-precio');

  function actualizarCheckTodos() {
    var todasTildadas = true;
    casillas.forEach(function (c) { if (!c.checked) todasTildadas = false; });
    checkTodos.checked = todasTildadas;
  }

  checkTodos.addEventListener('change', function () {
    casillas.forEach(function (c) { c.checked = checkTodos.checked; });
  });
  casillas.forEach(function (c) { c.addEventListener('change', actualizarCheckTodos); });
  actualizarCheckTodos();
})();
</script>

<%- include('../partials/foot') %>
