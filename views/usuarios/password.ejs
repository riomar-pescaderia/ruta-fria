<%- include('../partials/head') %>

<h1>Cambiar contraseña — <%= usuario.username %></h1>

<form class="card" method="post" action="/usuarios/<%= usuario.id %>/password">
  <% if (error) { %>
    <p style="color:#b3261e; margin-top:0;"><%= error %></p>
  <% } %>
  <div>
    <label for="password">Contraseña nueva</label>
    <input type="password" id="password" name="password" required minlength="6" autofocus>
  </div>
  <div>
    <label for="password2">Repetir contraseña</label>
    <input type="password" id="password2" name="password2" required minlength="6">
  </div>
  <div>
    <button class="btn" type="submit">Guardar</button>
    <a class="btn secondary" href="/usuarios">Cancelar</a>
  </div>
</form>

<%- include('../partials/foot') %>
