<%- include('../partials/head') %>

<div class="toolbar">
  <h1>Usuarios</h1>
  <a class="btn" href="/usuarios/nuevo">+ Nuevo usuario</a>
</div>

<% if (error) { %>
  <p style="color:#b3261e;"><%= error %></p>
<% } %>

<% if (usuarios.length === 0) { %>
  <p class="empty">Todavía no hay usuarios cargados.</p>
<% } else { %>
<table>
  <thead>
    <tr>
      <th>Usuario</th>
      <th>Nombre</th>
      <th>Contraseña</th>
      <th>Rol</th>
      <th>Accesos</th>
      <th>Estado</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% usuarios.forEach(u => { %>
    <tr>
      <td data-label="Usuario" class="mono"><%= u.username %><%= u.id === sesionId ? ' (vos)' : '' %></td>
      <td data-label="Nombre"><%= u.nombre || '—' %></td>
      <td data-label="Contraseña">
        <% if (u.password_plano) { %>
          <input type="password" class="mono campo-password-visible" value="<%= u.password_plano %>" readonly onclick="this.select()">
        <% } else { %>
          <span style="font-size:.8rem; color:var(--ink-soft);">No disponible</span>
        <% } %>
      </td>
      <td data-label="Rol"><%= u.es_admin ? 'Administrador' : 'Empleado' %></td>
      <td data-label="Accesos" style="font-size:.85rem; color:var(--ink-soft);">
        <% if (u.es_admin) { %>Todos<% } else { %>
          <% const ETIQUETAS_MODULO = { prospectos: 'Historial visitas', ventas: 'Venta / remito', cuenta_corriente: 'Cuenta corriente', mapa: 'Mapa de visitas' }; %>
          <%= ['clientes','articulos','prospectos','mapa','ventas','cuenta_corriente','compras','gastos','stock']
                .filter(m => u['acceso_' + m])
                .map(m => ETIQUETAS_MODULO[m] || (m[0].toUpperCase() + m.slice(1)))
                .join(', ') || 'Ninguno' %>
          <% if (u.permiso_editar_confirmadas) { %>
            <br><span style="font-size:.78rem;">+ Editar confirmadas</span>
          <% } %>
        <% } %>
      </td>
      <td data-label="Estado"><%= u.activo ? 'Activo' : 'Desactivado' %></td>
      <td data-label="" style="display:flex; gap:8px; flex-wrap:wrap;">
        <a class="btn secondary" href="/usuarios/<%= u.id %>/permisos">Permisos</a>
        <a class="btn secondary" href="/usuarios/<%= u.id %>/password">Cambiar contraseña</a>
        <form method="post" action="/usuarios/<%= u.id %>/estado" style="margin:0;">
          <button class="btn secondary" type="submit"><%= u.activo ? 'Desactivar' : 'Activar' %></button>
        </form>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
<% } %>

<script src="/js/password-toggle.js"></script>
<%- include('../partials/foot') %>
