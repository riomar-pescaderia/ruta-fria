<%- include('../partials/head') %>

<div class="toolbar">
  <h1>Stock</h1>
</div>

<% if (config && config.modo === 'planilla') { %>
  <% if (sync && sync.error) { %>
  <p style="color:#a33; font-size:.9rem;">
    No se pudo sincronizar con "<%= config.planilla_nombre || 'la planilla' %>": <%= sync.error %>
    <% if (config.ultima_sincronizacion) { %>Mostrando los últimos valores conocidos, del <%= new Date(config.ultima_sincronizacion).toLocaleString('es-AR') %>.<% } %>
  </p>
  <% } else { %>
  <p style="color:var(--ink-soft); font-size:.9rem;">
    Stock sincronizado con "<%= config.planilla_nombre || 'la planilla' %>"<% if (config.ultima_sincronizacion) { %> — última actualización: <%= new Date(config.ultima_sincronizacion).toLocaleString('es-AR') %><% } %>.
  </p>
  <% } %>
  <form method="post" action="/stock/sincronizar" style="margin-bottom:10px;">
    <button type="submit" class="btn secondary" style="padding:4px 12px; font-size:.82rem;">Sincronizar ahora</button>
  </form>
  <% if (usuario && usuario.esAdmin && sync && ((sync.noEncontrados && sync.noEncontrados.length) || (sync.sinDatoEnHoja && sync.sinDatoEnHoja.length))) { %>
  <details style="margin-bottom:14px; font-size:.85rem; color:var(--ink-soft);">
    <summary style="cursor:pointer;">Revisar diferencias entre la planilla y el catálogo</summary>
    <% if (sync.noEncontrados.length) { %><p>Códigos de la planilla que no existen como artículo: <%= sync.noEncontrados.join(', ') %></p><% } %>
    <% if (sync.sinDatoEnHoja.length) { %><p>Artículos que no aparecen en la planilla (no se les tocó el stock): <%= sync.sinDatoEnHoja.join(', ') %></p><% } %>
  </details>
  <% } %>
<% } %>

<% if (usuario && usuario.esAdmin) { %>
<details style="margin-bottom:18px;">
  <summary style="cursor:pointer; font-weight:600;">Configurar origen del stock</summary>
  <form class="card" method="post" action="/stock/configuracion" style="margin-top:10px; max-width:420px;">
    <div>
      <label for="modo">Modo</label>
      <select id="modo" name="modo">
        <option value="automatico" <%= (!config || config.modo === 'automatico') ? 'selected' : '' %>>Automático (con ventas y compras)</option>
        <option value="planilla" <%= (config && config.modo === 'planilla') ? 'selected' : '' %>>Planilla externa</option>
      </select>
    </div>
    <div>
      <label for="planilla_url">Link de la hoja de Google Sheets</label>
      <input type="text" id="planilla_url" name="planilla_url" value="<%= (config && config.planilla_url) || '' %>" placeholder="https://docs.google.com/spreadsheets/d/...">
    </div>
    <div>
      <label for="planilla_nombre">Nombre para mostrar</label>
      <input type="text" id="planilla_nombre" name="planilla_nombre" value="<%= (config && config.planilla_nombre) || '' %>" placeholder="Ej: Stock La Rioja 35">
    </div>
    <p style="color:var(--ink-soft); font-size:.85rem; margin:0;">Tiene que estar compartida como "Cualquier persona con el enlace puede ver". La hoja necesita una columna de código y una de cantidad (por ejemplo "Cod" y "Stock"). En modo planilla, ventas y compras dejan de mover el stock — siempre manda lo que diga la hoja.</p>
    <div>
      <button class="btn" type="submit">Guardar</button>
    </div>
  </form>
</details>
<% } %>

<% if (articulos.length === 0) { %>
  <p class="empty">Todavía no hay artículos cargados.</p>
<% } else { %>
<div style="max-width:340px; margin-bottom:14px;">
  <input type="text" id="buscar-stock" placeholder="Buscar por nombre o código...">
</div>
<p id="sin-resultados-stock" class="empty" style="display:none;">No encontré ningún artículo con ese nombre o código.</p>
<table id="tabla-stock">
  <thead>
    <tr>
      <th>Código</th>
      <th>Nombre</th>
      <th>Stock</th>
      <th>Estado</th>
    </tr>
  </thead>
  <tbody>
    <% articulos.forEach(a => {
      const stock = a.stock === null || a.stock === undefined ? null : Number(a.stock);
      const stockMinimo = a.stock_minimo === null || a.stock_minimo === undefined ? null : Number(a.stock_minimo);
      const sinStock = stock !== null && stock <= 0;
      const stockBajo = !sinStock && stock !== null && stockMinimo !== null && stock <= stockMinimo;
    %>
    <tr data-buscar="<%= (a.codigo + ' ' + a.nombre).toLowerCase() %>" data-href="/stock/<%= a.id %>">
      <td data-label="Código" class="mono"><%= a.codigo %></td>
      <td data-label="Nombre"><%= a.nombre %></td>
      <td data-label="Stock" data-corto="Stock" class="mono"><%= stock === null ? '—' : stock %></td>
      <td data-label="Estado">
        <% if (sinStock) { %><span class="badge sin-stock">Sin stock</span>
        <% } else if (stockBajo) { %><span class="badge stock-bajo">Stock bajo</span>
        <% } else { %><span class="badge stock-ok">OK</span>
        <% } %>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
<% } %>

<script>
(function () {
  var input = document.getElementById('buscar-stock');
  if (!input) return;
  var filas = document.querySelectorAll('#tabla-stock tbody tr');
  var sinResultados = document.getElementById('sin-resultados-stock');
  input.addEventListener('input', function () {
    var texto = input.value.trim().toLowerCase();
    var visibles = 0;
    filas.forEach(function (tr) {
      var coincide = !texto || tr.dataset.buscar.indexOf(texto) !== -1;
      tr.hidden = !coincide;
      if (coincide) visibles++;
    });
    sinResultados.style.display = visibles === 0 ? 'block' : 'none';
  });
})();
</script>

<%- include('../partials/foot') %>
