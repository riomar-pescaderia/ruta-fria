<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Configuración inicial — Ruta Fría</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="app">
    <span class="brand">🐟 Ruta Fría</span>
  </header>
  <main style="max-width:420px;">
    <h1>Configuración inicial</h1>
    <p class="empty" style="padding:0 0 16px; text-align:left;">Todavía no hay ningún usuario creado. Creá la primera cuenta para poder entrar al sistema.</p>
    <form class="card" method="post" action="/setup">
      <% if (error) { %>
        <p style="color:#b3261e; margin-top:0;"><%= error %></p>
      <% } %>
      <div>
        <label for="username">Usuario</label>
        <input type="text" id="username" name="username" required autofocus>
      </div>
      <div>
        <label for="nombre">Nombre (opcional)</label>
        <input type="text" id="nombre" name="nombre">
      </div>
      <div>
        <label for="password">Contraseña</label>
        <input type="password" id="password" name="password" required minlength="6">
      </div>
      <div>
        <label for="password2">Repetir contraseña</label>
        <input type="password" id="password2" name="password2" required minlength="6">
      </div>
      <div>
        <button class="btn" type="submit">Crear cuenta y entrar</button>
      </div>
    </form>
  </main>
</body>
</html>
