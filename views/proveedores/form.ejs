<%- include('../partials/head') %>

<h1><%= proveedor.id ? 'Editar proveedor' : 'Nuevo proveedor' %></h1>

<% if (error) { %>
  <div class="pendiente" style="border-color:#e3b8b8; color:#7a2b2b; margin-bottom:16px; padding:14px 20px;">
    <p style="margin:0;"><%= error %></p>
  </div>
<% } %>

<form class="card" method="post" action="<%= accion %>">
  <div>
    <label for="nombre">Nombre</label>
    <input type="text" id="nombre" name="nombre" value="<%= proveedor.nombre || '' %>" required>
  </div>
  <div>
    <label for="contacto">Contacto</label>
    <input type="text" id="contacto" name="contacto" value="<%= proveedor.contacto || '' %>">
  </div>
  <div>
    <label for="telefono">Teléfono</label>
    <input type="text" id="telefono" name="telefono" value="<%= proveedor.telefono || '' %>">
  </div>
  <div>
    <button class="btn" type="submit">Guardar</button>
    <a class="btn secondary" href="/compras/proveedores">Cancelar</a>
  </div>
</form>

<%- include('../partials/foot') %>
