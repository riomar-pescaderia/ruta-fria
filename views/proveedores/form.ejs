<%- include('../partials/head') %>

<h1><%= proveedor.id ? 'Editar proveedor' : 'Nuevo proveedor' %></h1>

<% if (error) { %>
  <div class="pendiente" style="border-color:#e3b8b8; color:#7a2b2b; margin-bottom:16px; padding:14px 20px;">
    <p style="margin:0;"><%= error %></p>
  </div>
<% } %>

<form class="card" method="post" action="<%= accion %>">
  <div>
    <label for="nombre">Nombre</label>
    <input type="text" id="nombre" name="nombre" value="<%= proveedor.nombre || '' %>" required>
  </div>
  <div>
    <label for="razon_social">Razón social</label>
    <input type="text" id="razon_social" name="razon_social" value="<%= proveedor.razon_social || '' %>">
  </div>
  <div>
    <label for="cuit">CUIT</label>
    <input type="text" id="cuit" name="cuit" value="<%= proveedor.cuit || '' %>">
  </div>
  <div>
    <label for="contacto">Contacto</label>
    <input type="text" id="contacto" name="contacto" value="<%= proveedor.contacto || '' %>">
  </div>
  <div>
    <label for="telefono">Teléfono</label>
    <input type="text" id="telefono" name="telefono" value="<%= proveedor.telefono || '' %>">
  </div>
  <div>
    <label for="categoria">Categoría</label>
    <select id="categoria" name="categoria">
      <option value="">— sin categoría asignada —</option>
      <% categorias.forEach(c => { %>
        <option value="<%= c.clave %>" <%= proveedor.categoria === c.clave ? 'selected' : '' %>><%= c.etiqueta %></option>
      <% }) %>
    </select>
    <p style="color:var(--ink-soft); font-size:.8rem; margin:6px 0 0;">Al cargar una factura de compra con esta categoría, el desplegable de proveedor va a mostrar solo los que la tengan asignada (más los que todavía no tienen categoría).</p>
  </div>
  <div style="display:flex; gap:8px; flex-wrap:wrap;">
    <button class="btn" type="submit">Guardar</button>
    <a class="btn secondary" href="/compras/proveedores">Cancelar</a>
  </div>
</form>

<% if (proveedor.id) { %>
<div style="max-width:520px; margin-top:16px;">
  <form method="post" action="/compras/proveedores/<%= proveedor.id %>/eliminar" style="margin:0;" onsubmit="return confirm('¿Eliminar este proveedor? No se puede deshacer.');">
    <button type="submit" class="btn secondary" style="color:#a33;">Eliminar proveedor</button>
  </form>
</div>
<% } %>

<%- include('../partials/foot') %>
