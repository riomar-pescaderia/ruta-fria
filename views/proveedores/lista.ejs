<%- include('../partials/head') %>

<div class="toolbar">
  <h1>Proveedores</h1>
  <a class="btn" href="/proveedores/nuevo">+ Nuevo proveedor</a>
</div>

<% if (error) { %>
  <p style="color:#b3261e;"><%= error %></p>
<% } %>

<% if (proveedores.length === 0) { %>
  <p class="empty">Todavía no cargaste ningún proveedor.</p>
<% } else { %>
<table>
  <thead>
    <tr>
      <th>Nombre</th>
      <th>Razón social</th>
      <th>CUIT</th>
      <th>Contacto</th>
      <th>Teléfono</th>
      <th>Categoría</th>
    </tr>
  </thead>
  <tbody>
    <% const catPorClave = {}; categorias.forEach(c => { catPorClave[c.clave] = c.etiqueta; }); %>
    <% proveedores.forEach(p => { %>
    <tr data-href="/proveedores/<%= p.id %>/editar">
      <td data-label="Nombre"><%= p.nombre %></td>
      <td data-label="Razón social" class="col-mobile-oculta"><%= p.razon_social || '—' %></td>
      <td data-label="CUIT" class="mono col-mobile-oculta"><%= p.cuit || '—' %></td>
      <td data-label="Contacto" class="col-mobile-oculta"><%= p.contacto || '—' %></td>
      <td data-label="Teléfono" class="mono col-mobile-oculta"><%= p.telefono || '—' %></td>
      <td data-label="Categoría"><%= p.categoria ? (catPorClave[p.categoria] || p.categoria) : '—' %></td>
    </tr>
    <% }) %>
  </tbody>
</table>
<% } %>

<%- include('../partials/foot') %>
