<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Ruta Fría</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <% const acc = (typeof usuario !== 'undefined' && usuario) ? (usuario.esAdmin ? { clientes:true, articulos:true, prospectos:true, ventas:true, cuenta_corriente:true, compras:true, informes:true, stock:true } : (usuario.accesos || {})) : {}; %>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="brand">
        <img src="/img/logo-riomar.png" alt="Riomar Pescadería" class="brand-logo">
        <span class="brand-text">Ruta Fría</span>
      </div>
      <nav class="app">
        <% if (acc.clientes) { %><a href="/clientes" class="<%= path && path.startsWith('/clientes') ? 'active' : '' %>"><span class="nav-icon"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="6" r="2.6"/><path d="M3.5 15c0-3 2.5-5.5 5.5-5.5s5.5 2.5 5.5 5.5"/></svg></span><span class="nav-label">Clientes</span></a><% } %>
        <% if (acc.articulos) { %><a href="/articulos" class="<%= path && path.startsWith('/articulos') ? 'active' : '' %>"><span class="nav-icon"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 6 9 2.7 15.5 6 9 9.3 2.5 6Z"/><path d="M2.5 6v6.5L9 16v-6.5"/><path d="M15.5 6v6.5L9 16"/></svg></span><span class="nav-label">Artículos</span></a><% } %>
        <% if (acc.prospectos) { %><a href="/prospectos" class="<%= path && path.startsWith('/prospectos') ? 'active' : '' %>"><span class="nav-icon"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 16s5.2-5 5.2-8.8A5.2 5.2 0 0 0 3.8 7.2C3.8 11 9 16 9 16Z"/><circle cx="9" cy="7" r="1.9"/></svg></span><span class="nav-label">Historial visitas</span></a><% } %>
        <% if (acc.ventas) { %><a href="/ventas" class="<%= path && path.startsWith('/ventas') ? 'active' : '' %>"><span class="nav-icon"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="10" height="14" rx="1.2"/><line x1="6.5" y1="6" x2="12" y2="6"/><line x1="6.5" y1="9" x2="12" y2="9"/><line x1="6.5" y1="12" x2="10" y2="12"/></svg></span><span class="nav-label">Venta / remito</span></a><% } %>
        <% if (acc.cuenta_corriente) { %><a href="/cuenta-corriente" class="<%= path && path.startsWith('/cuenta-corriente') ? 'active' : '' %>"><span class="nav-icon"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="14" height="9" rx="2"/><path d="M2 7.5h14"/><circle cx="12.5" cy="10.5" r="1.1" fill="currentColor" stroke="none"/></svg></span><span class="nav-label">Cuenta corriente</span></a><% } %>
        <% if (acc.compras) { %><a href="/compras" class="<%= path && path.startsWith('/compras') ? 'active' : '' %>"><span class="nav-icon"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 3h1.6l1.6 9a1.7 1.7 0 0 0 1.7 1.4h6a1.7 1.7 0 0 0 1.7-1.4l1.1-6.2H5"/><circle cx="7.3" cy="16" r="1.1" fill="currentColor" stroke="none"/><circle cx="13" cy="16" r="1.1" fill="currentColor" stroke="none"/></svg></span><span class="nav-label">Compras</span></a><% } %>
        <% if (acc.compras) { %><a href="/proveedores" class="<%= path && path.startsWith('/proveedores') ? 'active' : '' %>"><span class="nav-icon"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4" width="6" height="11"/><rect x="9.5" y="7.5" width="6" height="7.5"/><circle cx="5" cy="7" r=".6" fill="currentColor" stroke="none"/><circle cx="5" cy="10.5" r=".6" fill="currentColor" stroke="none"/><circle cx="12.5" cy="10.5" r=".6" fill="currentColor" stroke="none"/></svg></span><span class="nav-label">Proveedores</span></a><% } %>
        <% if (acc.informes) { %><a href="/informes" class="<%= path && path.startsWith('/informes') ? 'active' : '' %>"><span class="nav-icon"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 15V9"/><path d="M9 15V4"/><path d="M15 15V8"/><path d="M2 15h14"/></svg></span><span class="nav-label">Informes</span></a><% } %>
        <% if (acc.stock) { %><a href="/stock" class="<%= path && path.startsWith('/stock') ? 'active' : '' %>"><span class="nav-icon"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2.3 15.5 6 9 9.7 2.5 6 9 2.3Z"/><path d="M2.5 9l6.5 3.4L15.5 9"/><path d="M2.5 12.2l6.5 3.4 6.5-3.4"/></svg></span><span class="nav-label">Stock</span></a><% } %>
        <% if (typeof usuario !== 'undefined' && usuario && usuario.esAdmin) { %><a href="/usuarios" class="<%= path && path.startsWith('/usuarios') ? 'active' : '' %>"><span class="nav-icon"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2.5 14.5 4.5v4c0 4-2.5 6.5-5.5 8-3-1.5-5.5-4-5.5-8v-4L9 2.5Z"/><path d="M6.5 9.3 8.2 11 11.5 7.3"/></svg></span><span class="nav-label">Usuarios</span></a><% } %>
        <% if (typeof usuario !== 'undefined' && usuario && usuario.esAdmin) { %><a href="/vendedores/ubicacion" class="<%= path && path.startsWith('/vendedores') ? 'active' : '' %>"><span class="nav-icon"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 16s5.2-5.6 5.2-9.4A5.2 5.2 0 0 0 3.8 6.6C3.8 10.4 9 16 9 16Z"/><circle cx="9" cy="6.8" r="1.9"/></svg></span><span class="nav-label">Ubicación</span></a><% } %>
      </nav>
      <% if (typeof usuario !== 'undefined' && usuario) { %>
        <div class="sidebar-user">
          <span class="user-avatar"><%= (usuario.nombre || usuario.username || '?').charAt(0).toUpperCase() %></span>
          <span class="user-name"><%= usuario.nombre || usuario.username %></span>
          <a href="/logout" class="btn secondary logout-btn">Salir</a>
        </div>
      <% } %>
    </aside>
    <div class="content-area">
      <main>
