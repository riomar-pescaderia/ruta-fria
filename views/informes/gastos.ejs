<%- include('../partials/head') %>

<div class="migas-informes"><a href="/informes">Panel de Informes</a> / Gastos</div>

<div class="toolbar">
  <h1>Gastos</h1>
</div>

<p style="color:var(--ink-soft); font-size:.9rem; margin-top:-10px;">
  Informe de solo lectura sobre lo cargado en Compras con una categoría distinta de "Mercadería" — pensado para ver en qué se va la plata, comparar entre meses y encontrar dónde se podría ahorrar. Para registrar un gasto nuevo, entrá a
  <a href="/compras/nueva">+ Nueva factura</a> desde Compras y elegí la categoría que corresponda.
</p>

<div class="rangos-rapidos">
  <% rangosRapidos.forEach(r => {
       const activo = filtros.desde === r.desde && filtros.hasta === r.hasta; %>
  <a class="<%= activo ? 'activo' : '' %>" href="?desde=<%= r.desde %>&hasta=<%= r.hasta %><%= filtros.categoria ? '&categoria=' + filtros.categoria : '' %><%= filtros.subtipo ? '&subtipo=' + encodeURIComponent(filtros.subtipo) : '' %>"><%= r.etiqueta %></a>
  <% }) %>
</div>

<form class="filtros-informe" method="get" action="/informes/gastos">
  <div>
    <label for="desde">Desde</label>
    <input type="date" id="desde" name="desde" value="<%= filtros.desde %>">
  </div>
  <div>
    <label for="hasta">Hasta</label>
    <input type="date" id="hasta" name="hasta" value="<%= filtros.hasta %>">
  </div>
  <div>
    <label for="categoria">Categoría</label>
    <select id="categoria" name="categoria">
      <option value="">— todas —</option>
      <% categorias.filter(c => c.clave !== 'mercaderia' && c.clave !== 'flete_mercaderia').forEach(c => { %>
        <option value="<%= c.clave %>" <%= filtros.categoria === c.clave ? 'selected' : '' %>><%= c.etiqueta %></option>
      <% }) %>
    </select>
  </div>
  <div id="grupo-subtipo">
    <label for="subtipo">Subtipo</label>
    <select id="subtipo" name="subtipo">
      <option value="">— todos —</option>
    </select>
  </div>
  <div>
    <button class="btn" type="submit">Filtrar</button>
  </div>
  <% if (filtros.categoria || filtros.subtipo) { %>
  <div>
    <a class="btn secondary" href="?desde=<%= filtros.desde %>&hasta=<%= filtros.hasta %>">Quitar categoría</a>
  </div>
  <% } %>
</form>

<div class="kpis">
  <div class="kpi">
    <div class="kpi-etiqueta">Gastos del período <%= filtros.categoria ? '(' + (categorias.find(c => c.clave === filtros.categoria) || {}).etiqueta + (filtros.subtipo ? ' · ' + filtros.subtipo : '') + ')' : '' %></div>
    <div class="kpi-valor">$<%= resumen.gasto.total.toFixed(2) %></div>
    <div class="kpi-sub">
      <%= resumen.gasto.cantidad %> factura<%= resumen.gasto.cantidad === 1 ? '' : 's' %>
      <% if (resumen.gasto.variacion !== null) { %>
        · <span class="kpi-variacion <%= resumen.gasto.variacion <= 0 ? 'positiva' : 'negativa' %>"><%= resumen.gasto.variacion > 0 ? '+' : '' %><%= resumen.gasto.variacion.toFixed(1) %>%</span> vs. período anterior
      <% } %>
    </div>
  </div>
  <div class="kpi">
    <div class="kpi-etiqueta">Promedio por factura</div>
    <div class="kpi-valor">$<%= resumen.promedioPorFactura.toFixed(2) %></div>
    <div class="kpi-sub">Sobre <%= resumen.gasto.cantidad %> factura<%= resumen.gasto.cantidad === 1 ? '' : 's' %> cargada<%= resumen.gasto.cantidad === 1 ? '' : 's' %> en el período</div>
  </div>
  <div class="kpi">
    <div class="kpi-etiqueta">Categoría con más gasto</div>
    <% if (categoriaTop) { %>
      <div class="kpi-valor" style="font-size:1.25rem;"><%= categoriaTop.etiqueta %></div>
      <div class="kpi-sub">$<%= categoriaTop.total.toFixed(2) %> · <%= categoriaTop.pct.toFixed(0) %>% del total del período</div>
    <% } else { %>
      <div class="kpi-valor" style="font-size:1.25rem; color:var(--ink-soft);">—</div>
      <div class="kpi-sub">Sin gastos cargados en el período</div>
    <% } %>
  </div>
</div>

<div class="informe-seccion">
  <h2>Gastos por categoría</h2>
  <p class="informe-nota">Hacé click en una categoría para ver el detalle por subtipo. Ordenado de mayor a menor gasto.</p>
  <% if (porCategoria.length === 0) { %>
    <p class="empty">No hay gastos cargados en este período con estos filtros.</p>
  <% } else { %>
  <div>
    <% porCategoria.forEach((c, i) => { %>
    <div class="fila-ranking fila-categoria" data-toggle="subtipos-<%= i %>" style="cursor:pointer;">
      <div class="fila-ranking-encabezado">
        <span class="fila-ranking-nombre"><%= c.etiqueta %></span>
        <span class="fila-ranking-valor mono">$<%= c.total.toFixed(2) %> · <%= c.pct.toFixed(0) %>% · <%= c.cantidad %> fact.</span>
      </div>
      <div class="fila-ranking-barra-fondo"><div class="fila-ranking-barra" style="width: <%= maxCategoria > 0 ? Math.round(c.total / maxCategoria * 100) : 0 %>%; background: var(--orange);"></div></div>
    </div>
    <% if (c.subtipos.length) { %>
    <div id="subtipos-<%= i %>" hidden style="padding: 4px 0 12px 16px;">
      <% c.subtipos.forEach(s => { %>
        <div style="display:flex; justify-content:space-between; max-width:460px; font-size:.85rem; color:var(--ink-soft); padding:3px 0;">
          <span><%= s.nombre %></span>
          <span class="mono">$<%= s.total.toFixed(2) %> (<%= s.cantidad %>)</span>
        </div>
      <% }) %>
    </div>
    <% } %>
    <% }) %>
  </div>
  <% } %>
</div>

<div class="informe-seccion">
  <h2>Evolución mensual (últimos 12 meses)</h2>
  <p class="informe-nota">Para comparar entre meses — incluye el mes en curso. Respeta el filtro de categoría/subtipo de arriba.</p>
  <div class="grafico-caja"><canvas id="grafico-evolucion-gastos" height="90"></canvas></div>
  <div style="overflow-x:auto;">
  <table class="tabla-informe">
    <thead>
      <tr><th>Mes</th><th class="num">Gastos</th><th class="num">Facturas</th><th class="num">Vs. mes anterior</th></tr>
    </thead>
    <tbody>
      <% evolucionMensual.forEach(m => { %>
      <tr>
        <td><%= m.mes %></td>
        <td class="num mono">$<%= m.gasto.toFixed(2) %></td>
        <td class="num mono"><%= m.cantidad %></td>
        <td class="num mono">
          <% if (m.variacionMensual === null) { %>
            —
          <% } else { %>
            <span style="color: <%= m.variacionMensual > 0 ? '#a33' : (m.variacionMensual < 0 ? '#1e6b34' : 'inherit') %>;"><%= m.variacionMensual > 0 ? '+' : '' %><%= m.variacionMensual.toFixed(1) %>%</span>
          <% } %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
</div>

<div class="informe-seccion">
  <h2>Comparativa por categoría: este período vs. el anterior</h2>
  <p class="informe-nota">Mismo período elegido arriba, contra el tramo inmediatamente anterior de igual duración — para ver rápido dónde se gastó más o menos que la vez pasada. Ordenado por la mayor diferencia en pesos.</p>
  <% if (comparativaCategorias.length === 0) { %>
    <p class="empty">No hay gastos para comparar en estos dos períodos.</p>
  <% } else { %>
  <div style="overflow-x:auto;">
  <table class="tabla-informe">
    <thead>
      <tr><th>Categoría</th><th class="num">Este período</th><th class="num">Período anterior</th><th class="num">Diferencia</th><th class="num">Variación</th></tr>
    </thead>
    <tbody>
      <% comparativaCategorias.forEach(c => { %>
      <tr>
        <td><%= c.etiqueta %></td>
        <td class="num mono">$<%= c.actual.toFixed(2) %></td>
        <td class="num mono">$<%= c.anterior.toFixed(2) %></td>
        <td class="num mono" style="color: <%= c.diferencia > 0 ? '#a33' : (c.diferencia < 0 ? '#1e6b34' : 'inherit') %>;"><%= c.diferencia > 0 ? '+' : '' %>$<%= c.diferencia.toFixed(2) %></td>
        <td class="num mono">
          <% if (c.variacion === null) { %>
            —
          <% } else { %>
            <span style="color: <%= c.variacion > 0 ? '#a33' : (c.variacion < 0 ? '#1e6b34' : 'inherit') %>;"><%= c.variacion > 0 ? '+' : '' %><%= c.variacion.toFixed(1) %>%</span>
          <% } %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
  <% } %>
</div>

<div class="informe-seccion">
  <h2>Oportunidades de ahorro</h2>
  <p class="informe-nota">Reglas simples sobre lo cargado en Compras — no reemplazan tu criterio, son una ayuda para saber dónde mirar primero. Comparan renglones de factura con la misma descripción cargada (por eso conviene escribir siempre igual el mismo concepto cuando se repite mes a mes).</p>
  <div class="tarjetas-recomendacion">
    <div class="tarjeta-recomendacion">
      <h3><span class="badge ahorro">Ahorro potencial</span></h3>
      <p class="explicacion">El mismo concepto, pagado a distinto precio según el proveedor — 5% de diferencia o más, en el período elegido arriba.</p>
      <% if (comparativaProveedores.length === 0) { %>
        <p class="empty" style="padding:10px 0;">No se encontraron conceptos cargados a 2 o más proveedores distintos en este período.</p>
      <% } else { %>
        <% comparativaProveedores.forEach(c => { %>
        <div class="item-recomendacion">
          <span>
            <%= c.categoriaEtiqueta %><%= c.subtipo ? ' · ' + c.subtipo : '' %> — "<%= c.concepto %>"<br>
            <span style="color:var(--ink-soft); font-size:.82rem;">Más barato con <%= c.masBarato.nombre %> ($<%= c.masBarato.precioPromedio.toFixed(2) %>) que con <%= c.masCaro.nombre %> ($<%= c.masCaro.precioPromedio.toFixed(2) %>)</span>
          </span>
          <span class="mono" style="color:#1e6b34; white-space:nowrap;">-<%= c.ahorroPct.toFixed(0) %>%</span>
        </div>
        <% }) %>
      <% } %>
    </div>
    <div class="tarjeta-recomendacion">
      <h3><span class="badge alerta">Subió más</span></h3>
      <p class="explicacion">Conceptos que más aumentaron de precio unitario entre su primera y su última carga, mirando los últimos 12 meses (no depende del filtro de fecha de arriba).</p>
      <% if (evolucionPrecioConcepto.length === 0) { %>
        <p class="empty" style="padding:10px 0;">Todavía no hay un mismo concepto cargado en 2 o más meses distintos para comparar.</p>
      <% } else { %>
        <% evolucionPrecioConcepto.forEach(c => { %>
        <div class="item-recomendacion">
          <span>
            <%= c.categoriaEtiqueta %><%= c.subtipo ? ' · ' + c.subtipo : '' %> — "<%= c.concepto %>" (<%= c.proveedorNombre %>)<br>
            <span style="color:var(--ink-soft); font-size:.82rem;"><%= c.primero.mes %>: $<%= c.primero.precio.toFixed(2) %> → <%= c.ultimo.mes %>: $<%= c.ultimo.precio.toFixed(2) %></span>
          </span>
          <span class="mono" style="color:#a33; white-space:nowrap;">+<%= c.variacion.toFixed(0) %>%</span>
        </div>
        <% }) %>
      <% } %>
    </div>
  </div>
</div>

<div class="informe-seccion">
  <h2>Por día de la semana</h2>
  <p class="informe-nota">Suma de todo el período elegido arriba, agrupado por día de la semana en el que cae cada fecha.</p>
  <div style="overflow-x:auto;">
  <table class="tabla-informe">
    <thead>
      <tr><th>Día</th><th class="num">Gastos</th><th class="num">Facturas</th></tr>
    </thead>
    <tbody>
      <% porDiaSemana.forEach(d => { %>
      <tr>
        <td><%= d.nombre %></td>
        <td class="num mono">$<%= d.gasto.toFixed(2) %></td>
        <td class="num mono"><%= d.cantidad %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
</div>

<div class="informe-seccion">
  <h2>Por semana del mes</h2>
  <p class="informe-nota">Semana 1 = días 1 al 7 del mes, semana 2 = 8 al 14, y así — suma de todo el período elegido arriba.</p>
  <div style="overflow-x:auto;">
  <table class="tabla-informe">
    <thead>
      <tr><th>Semana</th><th class="num">Gastos</th><th class="num">Facturas</th></tr>
    </thead>
    <tbody>
      <% porSemanaMes.forEach(s => { %>
      <tr>
        <td>Semana <%= s.semana %></td>
        <td class="num mono">$<%= s.gasto.toFixed(2) %></td>
        <td class="num mono"><%= s.cantidad %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>
(function () {
  // Color validado para uso en gráficos (ver skill de dataviz) — una
  // sola serie (Gastos), así que alcanza con un solo tono; no hace falta
  // la paleta categórica de varios colores.
  var COLOR_GASTOS = '#eb6834';

  var evolucion = <%- JSON.stringify(evolucionMensual) %>;
  var canvas = document.getElementById('grafico-evolucion-gastos');
  if (canvas && window.Chart) {
    new Chart(canvas, {
      type: 'bar',
      data: {
        labels: evolucion.map(function (m) { return m.mes; }),
        datasets: [
          { label: 'Gastos', data: evolucion.map(function (m) { return m.gasto; }), backgroundColor: COLOR_GASTOS, borderRadius: 4 },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: { y: { beginAtZero: true, ticks: { callback: function (v) { return '$' + v; } } } },
        plugins: {
          legend: { display: false },
          tooltip: { callbacks: { label: function (ctx) { return ctx.dataset.label + ': $' + Number(ctx.raw).toFixed(2); } } },
        },
      },
    });
  }

  var SUBTIPOS_POR_CATEGORIA = <%- JSON.stringify(Object.fromEntries(categorias.map(c => [c.clave, c.subtipos]))) %>;
  var SUBTIPO_INICIAL = <%- JSON.stringify(filtros.subtipo || '') %>;
  var categoriaSelect = document.getElementById('categoria');
  var subtipoSelect = document.getElementById('subtipo');

  function reconstruirSubtipos(preservar) {
    var lista = SUBTIPOS_POR_CATEGORIA[categoriaSelect.value] || [];
    var valorPrevio = preservar ? subtipoSelect.value : '';
    subtipoSelect.innerHTML = '';
    var opcionVacia = document.createElement('option');
    opcionVacia.value = '';
    opcionVacia.textContent = '— todos —';
    subtipoSelect.appendChild(opcionVacia);
    lista.forEach(function (s) {
      var opt = document.createElement('option');
      opt.value = s;
      opt.textContent = s;
      subtipoSelect.appendChild(opt);
    });
    subtipoSelect.disabled = lista.length === 0;
    if (valorPrevio && lista.indexOf(valorPrevio) !== -1) subtipoSelect.value = valorPrevio;
  }

  categoriaSelect.addEventListener('change', function () { reconstruirSubtipos(false); });
  reconstruirSubtipos(true);
  if (SUBTIPO_INICIAL && (SUBTIPOS_POR_CATEGORIA[categoriaSelect.value] || []).indexOf(SUBTIPO_INICIAL) !== -1) {
    subtipoSelect.value = SUBTIPO_INICIAL;
  }

  // Click en una fila de categoría abre/cierra su detalle de subtipos.
  document.querySelectorAll('.fila-categoria').forEach(function (fila) {
    fila.addEventListener('click', function () {
      var id = fila.getAttribute('data-toggle');
      var detalle = document.getElementById(id);
      if (detalle) detalle.hidden = !detalle.hidden;
    });
  });
})();
</script>

<%- include('../partials/foot') %>
